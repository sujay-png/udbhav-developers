---
import { pageSeoData } from "@/lib/site-data";
import Hero from "@/components/Testimonials/hero.astro";
import TestimonialsGrid from "@/components/Testimonials/TestimonialsGrid.astro";
import CallToAction from "@/components/Testimonials/CallToAction.astro";

import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout seoTitle={pageSeoData.testimonials.seoTitle} seoDescription={pageSeoData.testimonials.seoDescription}>
  
  <!-- 
    Removed the loud pink wrapper section.
    The page now flows beautifully from the clean white Hero, 
    through the crisp white/off-white Grid, 
    and drops into the striking Dark CTA footer. 
  -->
  <main class="w-full">
    <Hero />
    <TestimonialsGrid />
    <CallToAction />
  </main>

</BaseLayout>

<style is:global>
  @keyframes fadeInUp {
    from { 
      opacity: 0; 
      transform: translateY(30px); 
    }
    to { 
      opacity: 1; 
      transform: translateY(0); 
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
    opacity: 0;
  }
</style>