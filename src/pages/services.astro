---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import ArtPanel from "@/components/ArtPanel.astro";
import CtaBanner from "@/components/sections/CtaBanner.astro";
import { Icon } from "@/components/Icon";
import { Badge } from "@/components/ui/badge";
import { services, pillars } from "@/lib/site-data";
---

<BaseLayout title="Services" description="Building construction, interior design, and building maintenance — Udbhav Developers' full-service construction ecosystem in Mangalore.">
  <section class="mx-auto max-w-[1400px] px-5 pb-16 pt-16 md:px-10 md:pt-24">
    <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
      <div>
        <Eyebrow>Excellence in Execution</Eyebrow>
        <h1 class="mt-4 max-w-xl text-balance font-display text-5xl leading-[1.05] md:text-6xl">
          Our Varied Construction <em class="italic text-clay">Services.</em>
        </h1>
      </div>
      <p class="max-w-sm text-[15px] leading-relaxed text-muted-foreground">
        We specialise in a wide range of services, including building construction and interior design, providing comprehensive solutions from foundation to final finish.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-[1400px] px-5 pb-24 md:px-10">
    <div class="grid gap-6 lg:grid-cols-3">
      <div class="relative overflow-hidden rounded-lg lg:col-span-2 lg:row-span-2">
        <ArtPanel seed={11} tone="clay" class="aspect-[16/11] w-full lg:h-full lg:aspect-auto" />
        <div class="absolute inset-0 flex flex-col justify-end p-8 text-cream">
          <Badge variant="dark" className="w-fit">{services[0].tag}</Badge>
          <h2 class="mt-4 font-display text-3xl">{services[0].title}</h2>
          <p class="mt-3 max-w-md text-sm leading-relaxed text-cream/80">{services[0].description}</p>
          <div class="mt-5 flex flex-wrap gap-2">
            {services[0].tags.map((t) => (
              <span class="rounded-full border border-cream/30 px-3 py-1 text-[11px] uppercase tracking-wide">{t}</span>
            ))}
          </div>
        </div>
      </div>

      <div class="rounded-lg bg-ink p-8 text-cream">
        <div class="grid h-11 w-11 place-items-center rounded-full bg-clay/20 text-clay">
          <Icon name="check" className="h-5 w-5" />
        </div>
        <h3 class="mt-4 font-display text-2xl">Future-Ready Innovation</h3>
        <p class="mt-3 text-sm leading-relaxed text-cream/70">
          Creating structures that blend thoughtful design with long-term technological value.
        </p>
        <ul class="mt-5 space-y-2 text-sm text-cream/80">
          <li class="flex items-center gap-2"><Icon name="check" className="h-3.5 w-3.5 text-clay" /> Smart Integration</li>
          <li class="flex items-center gap-2"><Icon name="check" className="h-3.5 w-3.5 text-clay" /> Eco-Conscious</li>
          <li class="flex items-center gap-2"><Icon name="check" className="h-3.5 w-3.5 text-clay" /> Urban Luxury</li>
        </ul>
      </div>

      {
        services.slice(1).map((s, i) => (
          <div class="rounded-lg border border-border bg-white p-8">
            <div class="grid h-11 w-11 place-items-center rounded-full bg-muted text-clay">
              <Icon name={s.icon as "sofa" | "wrench"} className="h-5 w-5" />
            </div>
            <p class="mt-4 text-[11px] font-semibold uppercase tracking-wide text-clay">{s.tag}</p>
            <h3 class="mt-1 font-display text-2xl">{s.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{s.description}</p>
            {s.tags.length > 0 && (
              <ul class="mt-4 space-y-1.5 text-sm text-ink/70">
                {s.tags.map((t) => (
                  <li class="flex items-center gap-2">
                    <span class="h-1 w-1 rounded-full bg-clay" /> {t}
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-[1400px] px-5 pb-24 md:px-10">
    <div class="grid gap-8 border-t border-border pt-16 sm:grid-cols-3">
      {
        pillars.map((p) => (
          <div>
            <div class="grid h-11 w-11 place-items-center rounded-full bg-muted text-clay">
              <Icon name={p.icon as "shield" | "leaf" | "smile"} className="h-5 w-5" />
            </div>
            <p class="mt-3 font-display text-lg">{p.title}</p>
            <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{p.description}</p>
          </div>
        ))
      }
    </div>
  </section>

  <CtaBanner seed={12} />
</BaseLayout>
