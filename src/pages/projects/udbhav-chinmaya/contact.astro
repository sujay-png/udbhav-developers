---
import "@/styles/global.css";
---
<html>
    <head>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
          href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap"
          rel="stylesheet"
        />
        <style>
            :root {
                --ink: #0c0c0c;
                --ink-soft: #5b5349;
                --paper: #ffffff;
                --paper-soft: #f7f1e7;
                --line: #e7decc;
                --red: #b3261e;
                --red-deep: #8a1b15;
                --red-tint: #fbeae7;
                --cream-on-red: #fcefe8;
                --font-display: "Fraunces", Georgia, serif;
                --font-body: "Inter", -apple-system, BlinkMacSystemFont, sans-serif;
            }
            body {
                background: var(--paper);
                color: var(--ink);
                font-family: var(--font-body);
                margin: 0;
            }
            .wrap {
                max-width: 1180px;
                margin: 0 auto;
                padding: 0 32px;
            }
            .nav {
                background: var(--paper);
                border-bottom: 1px solid var(--line);
                position: relative;
                z-index: 5;
            }
            .nav-inner {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 20px 0;
            }
            .brand {
                display: flex;
                align-items: center;
                gap: 10px;
                font-family: var(--font-display);
                font-weight: 600;
                font-size: 1.3rem;
                color: var(--ink);
            }
            .brand .mark {
                width: 28px;
                height: 28px;
                background: var(--red);
                border-radius: 5px 5px 5px 0;
                flex-shrink: 0;
            }
            .nav-links {
                display: flex;
                align-items: center;
                gap: 34px;
                list-style: none;
            }
            .nav-links a {
                text-decoration: none;
                color: var(--ink-soft);
                font-size: 0.94rem;
                font-weight: 500;
            }
            .nav-links a:hover {
                color: var(--red);
            }
            .credai-badge {
                display: flex;
                align-items: center;
                gap: 8px;
                font-size: 0.78rem;
                font-weight: 600;
                color: var(--ink-soft);
                border: 1px solid var(--line);
                border-radius: 3px;
                padding: 7px 12px;
            }
            .credai-badge .dot {
                width: 8px;
                height: 8px;
                border-radius: 50%;
                background: var(--red);
            }
            @media (max-width: 860px) {
                .nav-links {
                    display: none;
                }
            }

            .hero {
                background: var(--paper);
                padding: 64px 0 0;
            }
            .hero-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 40px;
                align-items: center;
            }
            .hero-copy {
                padding-left: max(32px, calc((80vw - 1170px) / 2 + 32px));
            }
            .hero h1 {
                font-family: var(--font-display);
                font-weight: 600;
                font-size: clamp(2.2rem, 3.4vw, 3.15rem);
                line-height: 1.1;
                margin: 0 0 20px;
                color: var(--ink);
                max-width: 13ch;
            }
            .hero .lede {
                font-size: 1.35rem;
                color: rgb(14 15 16);
                max-width: 46ch;
                margin: 0 0 30px;
                padding-left: 16px;
                border-left: 3px solid var(--red);
            }
            .hero-ctas {
                display: flex;
                gap: 14px;
                flex-wrap: wrap;
                margin-bottom: 56px;
            }
            .btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 15px 26px;
                border-radius: 3px;
                font-size: 0.95rem;
                font-weight: 600;
                text-decoration: none;
                cursor: pointer;
                border: 1.5px solid transparent;
                transition: all 0.18s ease;
            }
            .btn-primary {
                background: var(--red);
                color: #fff;
                padding: 15px 53px;
            }
            .btn-primary:hover {
                background: var(--red-deep);
            }
            .btn-outline {
                background: transparent;
                border-color: var(--ink);
                color: var(--ink);
            }
            .btn-outline:hover {
                border-color: var(--red);
                color: var(--red);
            }
            .btn-white {
                background: #fff;
                color: var(--red-deep);
            }
            .btn-white:hover {
                background: var(--cream-on-red);
            }
        </style>
    </head>
    <body>
        <header class="nav">
            <div class="wrap nav-inner">
                <a
                    href="/"
                    class="brand"
                    style="display:flex; align-items:center; gap:8px; text-decoration:none;"
                >
                    <img
                        src="/images/udbhav-developers-logo-1.png"
                        style="width:24px; height:auto;"
                        alt="Udbhav Logo"
                    />
                    <span
                        style="white-space:nowrap; font-family:var(--font-display); font-weight:600; font-size:1.3rem; color:var(--ink);"
                        >Udbhav <span style="color:var(--red);">Developers</span
                        ></span
                    >
                </a>
                <ul class="nav-links">
                    <li><a href="/about-us">About</a></li>
                    <li><a href="/buyers-guide">Buyers Guide</a></li>
                    <li><a href="/testimonials">Testimonials</a></li>
                </ul>
                <a
                    href="/contact"
                    class="btn btn-primary"
                    style="padding: 10px 20px;">Enquiry</a
                >
            </div>
        </header>
    </body>
</html>
