    <script>
      if (!document.body.dataset.gridReadMoreInit) {
        document.body.dataset.gridReadMoreInit = "true";

        document.addEventListener("click", (e) => {
          const galleryArrow = (e.target as HTMLElement).closest(
            ".gallery-arrow",
          );
          if (galleryArrow) {
            const wrapper = galleryArrow.closest(".gallery-wrapper");
            const scrollContainer = wrapper?.querySelector(".gallery-scroll");
            if (scrollContainer) {
              const firstImg = scrollContainer.querySelector("img");
              const scrollAmount = firstImg
                ? firstImg.clientWidth + 16
                : scrollContainer.clientWidth * 0.8;
              if (galleryArrow.classList.contains("left-arrow")) {
                scrollContainer.scrollBy({
                  left: -scrollAmount,
                  behavior: "smooth",
                });
              } else {
                scrollContainer.scrollBy({
                  left: scrollAmount,
                  behavior: "smooth",
                });
              }
            }
            return;
          }

          const target = (e.target as HTMLElement).closest(
            ".grid-read-more-btn",
          ) as HTMLButtonElement | null;
          if (!target) return;

          const container = target.closest(".group");
          const quote = container?.querySelector(".quote-text") as HTMLElement;

          if (quote) {
            // Collapse all other quotes
            document.querySelectorAll(".quote-text").forEach((otherQuote) => {
              if (
                otherQuote !== quote &&
                !otherQuote.classList.contains("line-clamp-4")
              ) {
                otherQuote.classList.add("line-clamp-4");
                const otherBtn = otherQuote
                  .closest(".group")
                  ?.querySelector(".grid-read-more-btn");
                if (otherBtn) {
                  otherBtn.textContent = "Read more";
                  otherBtn.setAttribute("aria-expanded", "false");
                }
              }
            });

            quote.classList.toggle("line-clamp-4");
            const isExpanded = !quote.classList.contains("line-clamp-4");
            target.textContent = isExpanded ? "Read less" : "Read more";
            target.setAttribute("aria-expanded", isExpanded.toString());
          }
        });
      }
    </script>
