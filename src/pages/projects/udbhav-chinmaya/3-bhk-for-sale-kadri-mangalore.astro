      .journey-line:not(.is-visible) .j-num { transform: scale(0); }
      .journey-line:not(.is-visible) .j-title { opacity: 0; transform: translateY(20px); }
      .journey-line.is-visible .j-num { animation: circlePop 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) forwards; }
      .journey-line.is-visible .j-title { animation: labelFadeUp 0.8s ease-out forwards; }
      .journey-line.is-visible .j-step:nth-child(1) .j-num, .journey-line.is-visible .j-step:nth-child(1) .j-title { animation-delay: 0ms; }
      .journey-line.is-visible .j-step:nth-child(2) .j-num, .journey-line.is-visible .j-step:nth-child(2) .j-title { animation-delay: 600ms; }
      .journey-line.is-visible .j-step:nth-child(3) .j-num, .journey-line.is-visible .j-step:nth-child(3) .j-title { animation-delay: 1200ms; }
      .journey-line.is-visible .j-step:nth-child(4) .j-num, .journey-line.is-visible .j-step:nth-child(4) .j-title { animation-delay: 1800ms; }
      .journey-line.is-visible .j-step:nth-child(5) .j-num, .journey-line.is-visible .j-step:nth-child(5) .j-title { animation-delay: 2400ms; }
      .journey-line.is-visible .j-step:nth-child(6) .j-num, .journey-line.is-visible .j-step:nth-child(6) .j-title { animation-delay: 3000ms; }
      .journey-line.is-visible .j-step:nth-child(7) .j-num, .journey-line.is-visible .j-step:nth-child(7) .j-title { animation-delay: 3600ms; }
      .j-step {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 0 10px;
      }
      .j-num {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: var(--red);
        border: 2px solid var(--red);
        color: #fff;
        font-weight: 700;
        font-size: 1.05rem;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 18px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
      }
      .j-title {
        font-size: 0.92rem;
        font-weight: 700;
        color: var(--ink);
        line-height: 1.3;
        transition: color 0.3s ease;
      }
      .j-step:hover .j-num {
        transform: scale(1.1) !important;
        box-shadow: 0 4px 12px rgba(220, 38, 38, 0.15);
      }
      .j-step:hover .j-title {
        color: var(--red);
      }
      @keyframes circlePop {
        0% { transform: scale(0); }
        100% { transform: scale(1); }
      }
      @keyframes labelFadeUp {
        0% { opacity: 0; transform: translateY(20px); }
        100% { opacity: 1; transform: translateY(0); }
      }
