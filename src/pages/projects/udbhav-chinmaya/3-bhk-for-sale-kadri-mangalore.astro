      .journey-line::before {
        content: "";
        position: absolute;
        top: 24px;
        left: calc(100% / 14);
        right: calc(100% / 14);
        height: 2px;
        background: var(--line);
        z-index: 0;
      }
      .journey-line::after {
        content: "";
        position: absolute;
        top: 24px;
        left: calc(100% / 14);
        right: calc(100% / 14);
        height: 2px;
        background: var(--red);
        z-index: 0;
        transform-origin: left;
        transform: scaleX(0);
