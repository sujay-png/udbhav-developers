    },
    {
      "@type": "CollectionPage",
      "@id": "https://www.udbhavdevelopers.com/projects/#webpage",
      "url": "https://www.udbhavdevelopers.com/projects/",
      "name": "Rera Approved Real Estate Project In Mangalore",
