---

<BaseLayout seoTitle={pageSeoData.ourProjects.seoTitle} seoDescription={pageSeoData.ourProjects.seoDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(projectsSchema)} />
  <section class="mx-auto max-w-[1400px] px-5 pb-10 pt-16 md:px-10 md:pt-24">
    <h1 class="flex items-center gap-2 text-sm font-bold uppercase tracking-[0.2em] text-clay md:text-base">
      <span class="h-px w-6 bg-current"></span>
      Premium Real Estate Projects in Mangalore
    </h1>
    <div class="mt-6 max-w-3xl">
      <h2 class="font-display text-2xl font-medium text-ink md:text-3xl">
        Building Trust and Structural Excellence in Mangaluru
      </h2>
      <p class="mt-3 text-[15px] leading-relaxed text-ink-soft md:text-base">
        At Udbhav Developers, we build top-quality residential apartments, commercial spaces, and retail shops with excellence, honesty, and creativity throughout Mangaluru. Each of our developments follows our core values: precise architecture, strong construction, and the best locations. Explore Our Portfolio of Premier Residential and Commercial Developments.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-[1400px] px-5 md:px-10">
    <div id="filter-bar" class="flex flex-wrap gap-x-7 gap-y-3 border-b border-border pb-4">
      {
        filters.map((f, i) => (
          <button
            type="button"
            data-filter={f}
            class:list={[
              "filter-btn text-[13px] font-medium uppercase tracking-wide transition-colors",
              i === 0 ? "text-clay" : "text-muted-foreground hover:text-ink",
            ]}
          >
            {f}
          </button>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-[1400px] px-5 py-14 md:px-10">
    <div id="project-grid" class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((p, i) => (
          <div class="project-item" data-status={p.status} data-category={p.category}>
            <ProjectCard project={p} seed={i + 2} showDescription={true} />
          </div>
        ))
      }
    </div>
    <p id="empty-state" class="hidden py-16 text-center text-sm text-muted-foreground">
      No projects match this filter yet — check back soon.
    </p>
  </section>

  <section class="mx-auto max-w-[1400px] px-5 pb-20 pt-2 md:px-10">
    <div class="border-t border-border pt-12 md:pt-16">
      <div class="max-w-3xl">
        <h2 class="font-display text-3xl font-medium text-ink md:text-4xl">
          Why Invest in Mangalore Real Estate Projects?
        </h2>
        <div class="mt-5 space-y-4 text-[15px] leading-relaxed text-ink-soft md:text-base">
          <p>
            Mangaluru is becoming one of India's fastest-growing second-tier real estate markets. Strong infrastructure, airport connectivity, quality educational institutions, and a growing IT and corporate presence are driving this growth. These factors make the city a strong place for property investment, offering significant value appreciation and high rental returns.
          </p>
          <p>
            When looking for real estate projects in Mangalore, choose the right local area for long-term value.
          </p>
        </div>
      </div>

      <!-- Area Cards -->
      <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          investmentAreas.map((area) => (
            <div class="location-card relative overflow-hidden flex flex-col rounded-xl border border-border bg-white p-6 md:p-8">
              <!-- 📍 Tag -->
              <div class="mb-5">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-sand/40 px-3 py-1 font-sans text-xs font-semibold uppercase tracking-wider text-ink border border-border/60">
                  <span class="text-xs">📍</span>
                  <span>{area.tag}</span>
                </span>
              </div>

              <!-- Card Content and Information -->
              <div class="flex flex-1 flex-col">
                <h3 class="location-title font-display text-2xl font-medium text-ink">
                  {area.title}
                </h3>
                <p class="mt-1.5 font-sans text-xs font-semibold uppercase tracking-wider text-clay">
                  {area.sublabel}
                </p>
                <p class="mt-4 text-[15px] leading-relaxed text-ink-soft">
                  {area.description}
                </p>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Our Commitment to Excellence -->
      <div class="mt-16 border-t border-border pt-12 md:mt-20 md:pt-16">
        <div class="max-w-3xl">
          <h2 class="font-display text-2xl font-medium text-ink md:text-3xl">
            Our Commitment to Excellence
          </h2>
          <p class="mt-4 text-[15px] leading-relaxed text-ink-soft md:text-base">
            Every project we create in Mangaluru meets strict international standards, ensuring your property grows in value over time.
          </p>
        </div>

        <!-- Commitment Cards -->
        <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {
            commitments.map((item) => (
              <div class="location-card relative overflow-hidden flex flex-col rounded-xl border border-border bg-white p-6 md:p-8">
                <div class="flex flex-1 flex-col">
                  <h3 class="location-title font-display text-2xl font-medium text-ink">
                    {item.title}
                  </h3>
                  <p class="mt-4 text-[15px] leading-relaxed text-ink-soft">
                    {item.description}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <ContactSection showHeading={false} />

  <style>
    .location-card {
      position: relative;
      overflow: hidden;
      height: 100%;
      box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
      transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
    }

    .location-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 0;
      height: 3px;
      background-color: var(--color-clay, #a83a24);
      transition: width 0.3s ease-in-out;
    }

    .location-title {
      transition: transform 0.3s ease-in-out, color 0.3s ease-in-out;
    }

    @media (hover: hover) {
      .location-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.12), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
      }

      .location-card:hover::before {
        width: 100%;
      }

      .location-card:hover .location-title {
        transform: translateX(4px);
        color: var(--color-clay, #a83a24);
      }
    }

    :global(#project-grid p) {
      color: var(--color-ink-soft, #2a231d) !important;
    }
  </style>

  <CtaBanner seed={14} />
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const items = document.querySelectorAll<HTMLElement>(".project-item");
  const empty = document.getElementById("empty-state");

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      buttons.forEach((b) => b.classList.remove("text-clay"));
      buttons.forEach((b) => b.classList.add("text-muted-foreground"));
      btn.classList.add("text-clay");
      btn.classList.remove("text-muted-foreground");

      const filter = btn.dataset.filter;
      let visibleCount = 0;

      items.forEach((item) => {
        const status = item.dataset.status;
        const category = item.dataset.category;
        const matches =
          filter === "All Projects" || filter === status || filter === category;
        item.style.display = matches ? "" : "none";
        if (matches) visibleCount++;
      });

      empty?.classList.toggle("hidden", visibleCount > 0);
    });
  });
</script>
