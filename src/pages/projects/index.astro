---
import { pageSeoData } from "@/lib/site-data";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import CtaBanner from "@/components/sections/CtaBanner.astro";
import ContactSection from "@/components/sections/ContactSection.astro";
import { projects } from "@/lib/site-data";

const filters = ["All Projects", "Ongoing", "Completed", "Residential", "Commercial"];

const investmentAreas = [
  {
    tag: "Kadri & Shivabhag",
    title: "Kadri & Shivabhag",
    sublabel: "Residential · Premium",
    description:
      "These areas are often seen as the best in Mangaluru for residential properties. They mix old-world charm with calm, tree-lined streets and are close to top healthcare, fine dining, and excellent schools.",
  },
  {
    tag: "Kottara Chowki",
    title: "Kottara Chowki",
    sublabel: "Commercial · Prime Transit",
    description:
      "This area is a key hub for commerce and transportation. Near main highways, it is ideal for retail businesses, corporate offices, and other ventures that need high visibility and foot traffic.",
  },
  {
    tag: "Nantoor",
    title: "Nantoor",
    sublabel: "Residential · Greenery",
    description:
      "This busy central area is surrounded by greenery, offering a peaceful and convenient lifestyle. It's ideal for families looking for high-quality homes, and our development is a great option here.",
  },
];

const commitments = [
  {
    title: "Strict RERA Compliance",
    description:
      "All our ongoing projects have full RERA approvals and clear ownership, making it easier to get loans from major banks like Karnataka Bank.",
  },
  {
    title: "Architectural Excellence",
    description:
      "Our designs use natural cross-ventilation and plenty of natural light. We use high-quality materials and top engineering standards to create long-lasting, elegant homes that improve your lifestyle and maintain their value for many years.",
  },
  {
    title: "Sustainable Engineering",
    description:
      "We include features like rainwater harvesting and eco-friendly building methods. These help reduce environmental impact and keep future maintenance costs low.",
  },
];

const projectsSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": "https://www.udbhavdevelopers.com/projects/#breadcrumb",
