            "description": "RERA-approved luxury 3 & 4 BHK apartments located in Chandrika Layout, Swami Vivekananda Road, Kadri, Mangalore.",
            "address": {
              "@type": "PostalAddress",
              "streetAddress": "Chandrika Layout, Swami Vivekananda Road, Kadri",
              "addressLocality": "Mangaluru",
              "addressRegion": "Karnataka",
              "postalCode": "575002",
              "addressCountry": "IN"
            }
          }
        },
        {
          "@type": "ListItem",
          "position": 2,
          "item": {
