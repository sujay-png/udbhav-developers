      }
    },
    {
      "@type": "ItemList",
      "@id": "https://www.udbhavdevelopers.com/projects/#itemlist",
      "name": "Real Estate Projects in Mangalore by Udbhav Developers",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "item": {
            "@type": "ApartmentComplex",
            "name": "Udbhav Chinmaya",
