---
import type { Project } from "../../../lib/site-data";
import { projects } from "../../../lib/site-data";
import { Image } from "astro:assets";

// 1. Tell Astro to prerender this dynamic route statically at build time
export const prerender = true;

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug }, 
    props: { project },             
  }));
}

interface Props {
  project?: Project;
}

const { project } = Astro.props;

const projectUpdates = project?.updates ? [...project.updates].reverse() : [];
const slugify = (text: string) => text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');

const allImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/**/*.{jpeg,jpg,png,webp,gif}', { eager: true });
---

{projectUpdates.length > 0 ? (
  <div class="space-y-12">
    {projectUpdates.map((update, index) => (
      <div class="space-y-4">
        {/* Month Title */}
        <h3 class="font-display text-xl sm:text-2xl text-ink border-l-4 border-clay pl-3">
          {update.title}
        </h3>

        {/* Carousel for this Month */}
        <div class="relative mt-2">
          <div class="relative group/gallery" data-gallery-id={`updates-carousel-${index}`}>
            <div
              id={`updates-carousel-${index}`}
              class="flex gap-6 overflow-x-auto scroll-smooth pb-6 select-none snap-x snap-mandatory [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"
            >
              {update.images.map((imgSrc, imgIdx) => {
                const imgObj = allImages[imgSrc]?.default;
                return (
                <div class="min-w-[220px] sm:min-w-[280px] lg:min-w-[320px] max-w-[320px] flex-shrink-0 group snap-start">
                  <div class="relative overflow-hidden rounded-2xl aspect-[4/3] bg-ink/5 shadow-sm border border-border">
                    {imgObj ? (
                      <Image
                        src={imgObj}
                        alt={`${update.title} - Photo ${imgIdx + 1}`}
                        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                        loading="lazy"
                        widths={[320, 640]}
                        sizes="(max-width: 640px) 320px, 640px"
                      />
                    ) : (
                      <img
                        src={imgSrc}
                        alt={`${update.title} - Photo ${imgIdx + 1}`}
                        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                        loading="lazy"
                      />
                    )}
                  </div>
                </div>
              )})}
            </div>

            <!-- Navigation Buttons for this carousel -->
            <button data-action="prev" aria-label="Previous" class="hidden sm:flex items-center justify-center absolute left-2 lg:-left-4 top-1/2 -translate-y-1/2 z-50 w-10 h-10 rounded-full bg-clay/90 text-white hover:bg-clay transition-colors shadow-md cursor-pointer pointer-events-auto">
              <svg class="w-5 h-5 pointer-events-none" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6" /></svg>
            </button>
            <button data-action="next" aria-label="Next" class="hidden sm:flex items-center justify-center absolute right-2 lg:-right-4 top-1/2 -translate-y-1/2 z-50 w-10 h-10 rounded-full bg-clay/90 text-white hover:bg-clay transition-colors shadow-md cursor-pointer pointer-events-auto">
              <svg class="w-5 h-5 pointer-events-none" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6" /></svg>
            </button>
          </div>

          <!-- View All Button -->
          <div class="flex justify-center mt-2 mb-6 z-10 relative">
            <a href={`/projects/${project?.slug}/gallery#${slugify(update.title)}`} class="inline-flex h-12 items-center justify-center rounded-md bg-clay px-8 text-sm font-bold text-cream shadow hover:bg-clay-hover transition-colors">
              View All
            </a>
          </div>
        </div>
      </div>
    ))}
  </div>
) : (
  <p class="text-muted-foreground">No gallery updates available.</p>
)}

<script lang="ts">
  function setupAllGalleries() {
    const galleries = document.querySelectorAll('[data-gallery-id]');

    galleries.forEach((gallery) => {
      const containerId = gallery.getAttribute('data-gallery-id');
      if (!containerId) return;

      const container = gallery.querySelector(`#${containerId}`);
      const btnPrev = gallery.querySelector('[data-action="prev"]');
      const btnNext = gallery.querySelector('[data-action="next"]');

      if (!container || !btnPrev || !btnNext) return;

      const getScrollAmount = () => {
        const firstItem = container.querySelector('.snap-start');
        return firstItem ? firstItem.offsetWidth + 24 : 344;
      };

      const scrollNext = () => {
        if (container.scrollLeft + container.clientWidth >= container.scrollWidth - 10) {
          container.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          container.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
        }
      };

      const scrollPrev = () => {
        if (container.scrollLeft <= 10) {
          container.scrollTo({ left: container.scrollWidth, behavior: 'smooth' });
        } else {
          container.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
        }
      };

      btnPrev.onclick = scrollPrev;
      btnNext.onclick = scrollNext;
      
      // Auto-slide animation functionality
      let autoPlayInterval;
      
      const startAutoPlay = () => {
        autoPlayInterval = setInterval(scrollNext, 3000);
      };

      const stopAutoPlay = () => {
        clearInterval(autoPlayInterval);
      };

      // Start autoplay by default
      startAutoPlay();

      // Pause auto-sliding on hover or touch to allow manual clicking
      gallery.addEventListener('mouseenter', stopAutoPlay);
      gallery.addEventListener('mouseleave', startAutoPlay);
      gallery.addEventListener('touchstart', stopAutoPlay, { passive: true });
      gallery.addEventListener('touchend', startAutoPlay, { passive: true });
    });
  }

  setupAllGalleries();
  document.addEventListener('astro:page-load', setupAllGalleries);
</script>
