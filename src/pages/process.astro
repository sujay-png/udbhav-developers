---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import CtaBanner from "@/components/sections/CtaBanner.astro";
import { Accordion, AccordionItem, AccordionTrigger, AccordionContent } from "@/components/ui/accordion";
import { processSteps } from "@/lib/site-data";
import { Faq } from "@/components/Faq";

const faqs = [
  {
    q: "How long does construction typically take?",
    a: "Most residential projects take 24–36 months from groundbreaking to handover, depending on scale. We share a detailed construction timeline at booking so you always know where a project stands.",
  },
  {
    q: "What is UDS and why does it matter?",
    a: "Undivided Share of Land (UDS) is the proportionate land ownership tied to your apartment. It's the single most important factor in long-term value appreciation — our sales team walks every buyer through their UDS before booking.",
  },
  {
    q: "Do you offer post-handover maintenance?",
    a: "Yes — ASK & Associates, our maintenance wing, handles statutory compliance, repairs, and specialised upkeep after inauguration, so ownership stays effortless.",
  },
  {
    q: "Can I customise my unit's interiors?",
    a: "Udbhav Interiors works directly with buyers on customisation, from fittings to finishes, ahead of possession.",
  },
];
---

<BaseLayout title="Process" description="How Udbhav Developers takes a project from site feasibility to handover — and what buyers can expect at every stage.">
  <section class="mx-auto max-w-[1400px] px-5 pb-16 pt-16 md:px-10 md:pt-24">
    <Eyebrow>From Foundation to Handover</Eyebrow>
    <h1 class="mt-4 max-w-2xl text-balance font-display text-5xl leading-[1.05] md:text-6xl">
      A process built on <em class="italic text-clay">transparency.</em>
    </h1>
    <p class="mt-5 max-w-lg text-[15px] leading-relaxed text-muted-foreground">
      Every Udbhav project follows the same disciplined sequence — because predictability is what turns a buyer into a long-term reference.
    </p>
  </section>

  <section class="mx-auto max-w-[1400px] px-5 pb-24 md:px-10">
    <div class="grid gap-px overflow-hidden rounded-lg border border-border bg-border sm:grid-cols-2 lg:grid-cols-4">
      {
        processSteps.map((step, i) => (
          <div class="bg-white p-8">
            <p class="font-display text-4xl text-clay/40">{String(i + 1).padStart(2, "0")}</p>
            <h3 class="mt-4 font-display text-xl">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{step.description}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="bg-blush">
    <div class="mx-auto max-w-3xl px-5 py-24 md:px-10">
      <div class="text-center">
        <Eyebrow class="justify-center">Buyer's Guide</Eyebrow>
        <h2 class="mt-3 text-balance font-display text-4xl leading-[1.1] md:text-[2.75rem]">Common questions</h2>
      </div>
      <Faq items={faqs} client:visible />
    </div>
  </section>

  <CtaBanner seed={13} title="Ready to start your journey with Udbhav?" cta="Talk to Our Team" />
</BaseLayout>
