---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import ArtPanel from "@/components/ArtPanel.astro";
import { Icon } from "@/components/Icon";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";

const updates = [
  {
    tag: "Corporate",
    date: "March 15, 2026",
    title: "Udbhav Developers Marks 12 Years of Building in Mangalore",
    excerpt: "Reflecting on over a decade of residential and commercial development across the city, and what comes next.",
    seed: 15,
  },
  {
    tag: "Upcoming",
    date: "February 26, 2026",
    title: "Udbhav Square: A New Vision for Integrated Commercial Spaces",
    excerpt: "Our upcoming commercial project aims to create a column-free, future-ready workplace in the city centre.",
    seed: 16,
  },
  {
    tag: "Interview",
    date: "January 12, 2026",
    title: "Leadership Insight: Where Udbhav Goes From Here",
    excerpt: "In an exclusive conversation, our leadership team outlines the next phase of expansion into commercial real estate.",
    seed: 17,
  },
];
---

<BaseLayout title="Media & Press" description="News, corporate updates, and media resources for Udbhav Developers.">
  <section class="relative overflow-hidden bg-ink text-cream">
    <ArtPanel seed={18} tone="ink" class="absolute inset-0 opacity-90" />
    <div class="relative mx-auto max-w-[1400px] px-5 py-24 md:px-10 md:py-32">
      <Badge>Featured Story</Badge>
      <h1 class="mt-5 max-w-2xl text-balance font-display text-5xl leading-[1.05] md:text-6xl">
        Udbhav Horizon: Redefining Our Mangalore Skyline
      </h1>
      <p class="mt-5 max-w-lg text-[15px] leading-relaxed text-cream/70">
        A look at how twelve years of disciplined construction has shaped Mangalore's residential and commercial landscape.
      </p>
      <div class="mt-8">
        <Button asChild variant="outlineLight">
          <a href="#updates">Read Full Story</a>
        </Button>
      </div>
    </div>
  </section>

  <section id="updates" class="mx-auto max-w-[1400px] px-5 py-24 md:px-10">
    <div class="flex items-end justify-between">
      <h2 class="font-display text-3xl">News & Corporate Updates</h2>
    </div>
    <div class="mt-10 grid gap-8 md:grid-cols-3">
      {
        updates.map((u) => (
          <article>
            <div class="relative aspect-[4/3] overflow-hidden rounded-lg">
              <ArtPanel seed={u.seed} tone="sand" class="h-full w-full" />
              <div class="absolute left-3 top-3">
                <Badge variant="dark">{u.tag}</Badge>
              </div>
            </div>
            <p class="mt-4 text-xs uppercase tracking-wide text-muted-foreground">{u.date}</p>
            <h3 class="mt-1.5 font-display text-xl leading-snug">{u.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{u.excerpt}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-[1400px] px-5 pb-24 md:px-10">
    <div class="grid gap-10 rounded-lg bg-ink p-8 text-cream md:p-14 lg:grid-cols-2 lg:gap-16">
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-clay">Journalist Resources</p>
        <h2 class="mt-3 font-display text-3xl leading-tight md:text-4xl">Professional Media Assets</h2>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-cream/65">
          Access brand assets and our corporate profile — designed for publishers and media partners.
        </p>
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          <div class="rounded-md border border-cream/15 p-5">
            <Icon name="download" className="h-5 w-5 text-clay" />
            <p class="mt-3 text-sm font-semibold">Logo Package</p>
            <p class="mt-1 text-xs text-cream/50">SVG, PNG, and AI formats</p>
          </div>
          <div class="rounded-md border border-cream/15 p-5">
            <Icon name="user" className="h-5 w-5 text-clay" />
            <p class="mt-3 text-sm font-semibold">Exec Profiles</p>
            <p class="mt-1 text-xs text-cream/50">Portraits and bios for leadership</p>
          </div>
        </div>
      </div>

      <div>
        <h3 class="font-display text-xl">Press Inquiry</h3>
        <form class="mt-5 space-y-4">
          <Input placeholder="Full Name" className="border-cream/25 text-cream placeholder:text-cream/35" />
          <Input placeholder="Media Outlet" className="border-cream/25 text-cream placeholder:text-cream/35" />
          <textarea
            placeholder="Message"
            rows="4"
            class="w-full rounded-sm border border-cream/25 bg-transparent px-3.5 py-3 text-sm text-cream placeholder:text-cream/35 focus-visible:outline-none focus-visible:border-clay"
          ></textarea>
          <Button variant="accent" size="lg" className="w-full">Submit Request</Button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
