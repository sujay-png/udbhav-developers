---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArtPanel from "@/components/ArtPanel.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import { Badge } from "@/components/ui/badge";
import { Icon } from "@/components/Icon";
import { getAllPosts } from "@/lib/wordpress";

export async function getStaticPaths() {
  const posts = await getAllPosts(100);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const resolved = post;

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString("en-IN", { year: "numeric", month: "long", day: "numeric" });
}
---

<BaseLayout title={resolved.title} description={resolved.excerpt}>
  <article>
    <section class="relative overflow-hidden">
      {
        resolved.featuredImage ? (
          <img src={resolved.featuredImage} alt={resolved.title} class="h-[46vh] w-full object-cover md:h-[56vh]" />
        ) : (
          <ArtPanel seed={resolved.id.length + resolved.slug.length} tone="ink" class="h-[46vh] w-full md:h-[56vh]" />
        )
      }
      <div class="absolute inset-0 flex items-end bg-gradient-to-t from-ink/80 via-ink/10 to-transparent">
        <div class="mx-auto w-full max-w-3xl px-5 pb-10 text-cream md:px-10 md:pb-14">
          {resolved.categories[0] && <Badge>{resolved.categories[0]}</Badge>}
          <h1 class="mt-4 text-balance font-display text-3xl leading-[1.1] md:text-5xl">{resolved.title}</h1>
          <div class="mt-4 flex flex-wrap items-center gap-4 text-xs uppercase tracking-wide text-cream/70">
            <span class="flex items-center gap-1.5"><Icon name="calendar" size={14} /> {formatDate(resolved.date)}</span>
            <span class="flex items-center gap-1.5"><Icon name="user" size={14} /> {resolved.author}</span>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-3xl px-5 py-14 md:px-10 md:py-20">
      <div
        class="prose-content max-w-none text-[15px] leading-relaxed text-ink/80 [&_a]:text-clay [&_a]:underline [&_a]:underline-offset-2 [&_h2]:mt-10 [&_h2]:font-display [&_h2]:text-2xl [&_h2]:text-ink [&_h3]:mt-8 [&_h3]:font-display [&_h3]:text-xl [&_h3]:text-ink [&_img]:my-6 [&_img]:rounded-lg [&_p]:mt-4 [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-5"
        set:html={resolved.content}
      />

      <div class="mt-14 flex items-center justify-between border-t border-border pt-8">
        <a href="/blog" class="flex items-center gap-2 text-sm font-medium uppercase tracking-wide text-ink hover:text-clay">
          <Icon name="arrow-left" size={16} /> Back to Blog
        </a>
        <a href="/contact" class="flex items-center gap-2 text-sm font-medium uppercase tracking-wide text-clay hover:text-clay-hover">
          Enquire About a Project <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </section>
  </article>
</BaseLayout>
