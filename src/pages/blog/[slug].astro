---
// src/pages/blog/[slug].astro
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArtPanel from "@/components/ArtPanel.astro";
import { Icon } from "@/components/Icon";
import { getAllPosts, formatDate, estimateReadTime } from "@/lib/wordpress";
import { SidebarEnquiryForm } from "@/components/SidebarEnquiryForm";

export const prerender = true;
export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

import * as cheerio from 'cheerio';

let contentHtml = post.content;

// Server-side HTML parsing to prevent CLS
const $ = cheerio.load(contentHtml, null, false);

// 1. Generate TOC Server-side
const headings = $('h2, h3');
if (headings.length > 0) {
  const tocWidget = $('.elementor-widget-table-of-contents');
  if (tocWidget.length > 0) {
    const tocHeader = tocWidget.find('.elementor-toc__header');
    const tocBody = tocWidget.find('.elementor-toc__body');
    
    // Clear out existing toggles
    tocHeader.find('.elementor-toc__toggle-button').remove();
    
    // Add our custom arrow toggle
    tocHeader.append(`<div class="toc-arrow" style="transition: transform 0.3s ease; cursor: pointer;"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#554946" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"></polyline></svg></div>`);
    
    // Generate TOC
    const rootOl = $('<ol class="elementor-toc__list"></ol>');
    let currentUl: any = null;
    let lastLi: any = null;
    
    headings.each((i, el) => {
      const heading = $(el);
      if (!heading.attr('id')) {
        heading.attr('id', 'heading-' + i);
      }
      
      const li = $('<li class="elementor-toc__list-item" style="margin-bottom: 0.75rem;"></li>');
      const a = $('<a></a>').attr('href', '#' + heading.attr('id')).text(heading.text());
      a.css({ color: '#121417', textDecoration: 'none', transition: 'color 0.2s' });
      li.append(a);
      
      if (el.tagName.toLowerCase() === 'h3') {
        if (!currentUl) {
          currentUl = $('<ul class="elementor-toc__nested-list"></ul>');
          if (lastLi) {
            lastLi.append(currentUl);
          } else {
            rootOl.append(currentUl);
          }
        }
        currentUl.append(li);
      } else {
        currentUl = null;
        rootOl.append(li);
        lastLi = li;
      }
    });
    
    
    tocBody.empty().append(rootOl);
  }
}

// 2. Wrap ALL blockquotes into a single Swiper carousel
const blockquotes = $('blockquote, .wp-block-quote');
if (blockquotes.length > 0) {
  const swiperContainer = $('<div class="swiper blog-testimonial-swiper" style="padding-bottom: 3rem; margin: 3rem 0;"><div class="swiper-wrapper"></div><div class="swiper-pagination"></div></div>');
  const swiperWrapper = swiperContainer.find('.swiper-wrapper');
  
  // Insert the carousel exactly where the first testimonial was
  $(blockquotes[0]).before(swiperContainer);
  
  // Move all testimonials from the article into this single carousel
  blockquotes.each((i, el) => {
    $(el).css('margin', '0');
    const slide = $('<div class="swiper-slide" style="height: auto; padding: 0.5rem;"></div>');
    slide.append($(el));
    swiperWrapper.append(slide);
  });
}

contentHtml = $.html();
---

<BaseLayout seoTitle={post.title} seoDescription={post.excerpt}>
  <article class="bg-white font-sans">
    
    <!-- Hero Header -->
    <section class="relative overflow-hidden bg-[#121417]">
      {
        post.featuredImage ? (
          <img src={post.featuredImage} alt={post.title} class="h-[50vh] w-full object-cover md:h-[65vh] opacity-60" />
        ) : (
          <ArtPanel seed={post.id.length + post.slug.length} tone="ink" class="h-[50vh] w-full md:h-[65vh] opacity-60" />
        )
      }
      <div class="absolute inset-0 bg-gradient-to-t from-[#121417] via-[#121417]/40 to-transparent"></div>
      
      <div class="absolute inset-0 flex items-end">
        <div class="mx-auto w-full max-w-7xl px-6 pb-12 md:px-12 md:pb-20 flex flex-col md:flex-row md:items-end justify-between gap-8">
          
          <div class="max-w-4xl">
            {post.categories[0] && (
              <span class="inline-block rounded-full bg-[#B02317] px-4 py-2 text-[10px] font-bold uppercase tracking-[0.25em] text-white shadow-sm mb-6">
                {post.categories[0]}
              </span>
            )}
            
            <h1 class="text-balance font-serif text-4xl font-medium leading-[1.1] text-white sm:text-5xl md:text-6xl lg:text-7xl">
              {post.title}
            </h1>
            
            <div class="mt-8 flex flex-wrap items-center gap-6 text-xs font-semibold uppercase tracking-widest text-gray-300">
              <span class="flex items-center gap-2">
                <Icon name={"calendar" as any} className="h-4 w-4 text-[#B02317]" /> 
                {formatDate(post.date)}
              </span>
              <span class="flex items-center gap-2">
                <Icon name={"user" as any} className="h-4 w-4 text-[#B02317]" /> 
                {post.author}
              </span>
              <span class="flex items-center gap-2">
                <Icon name={"clock" as any} className="h-4 w-4 text-[#B02317]" /> 
                {estimateReadTime(post.content)}
              </span>
            </div>
          </div>

          <!-- Enquire Now button in Hero -->
          <div class="shrink-0">
            <button
              data-open-enquiry="true"
              class="inline-flex h-12 items-center justify-center rounded-md bg-[#B02317] px-8 text-sm font-bold text-white shadow-xl transition-all hover:bg-[#8e1c12] hover:-translate-y-1"
            >
              Enquire Now
            </button>
          </div>

        </div>
      </div>
    </section>

    <!-- Main Content Area -->
    <section class="mx-auto max-w-7xl px-6 py-16 md:px-12 md:py-24 grid lg:grid-cols-[1fr_380px] gap-12 lg:gap-20 items-start">
      
      <!-- Left: Article Content -->
      <div class="w-full overflow-hidden">
        <div
          class="prose-content max-w-none text-lg font-light leading-relaxed text-[#554946]"
          set:html={contentHtml}
        />

        <div class="mt-20 flex flex-col sm:flex-row items-center justify-between gap-6 border-t border-gray-100 pt-10">
          <a href="/blog/" class="group flex items-center gap-3 text-sm font-semibold uppercase tracking-widest text-[#88726F] hover:text-[#B02317] transition-colors">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-[#FDF9F7] transition-colors group-hover:bg-[#B02317]/10">←</span> 
            Back to Blog
          </a>
        </div>
      </div>

      <!-- Right: Sticky Sidebar -->
      <aside class="sticky top-24 hidden lg:block rounded-2xl border border-gray-100 bg-[#FDF9F7] p-8 shadow-sm">
        <div class="mb-6 text-center">
          <h3 class="font-sans text-xl font-bold text-[#121417] tracking-tight">Enquire Here</h3>
        </div>
        <SidebarEnquiryForm dark={false} client:load />
      </aside>

    </section>
  </article>

  <script>
    import Swiper from "swiper/bundle";
    import "swiper/css/bundle";

    // Client-side script to handle toggles (TOC and Accordions)
    document.addEventListener('DOMContentLoaded', () => {
      
      // Initialize Blog Testimonial Swiper (Custom blockquotes & ElementsKit native carousels)
      const testimonialSwipers = document.querySelectorAll('.blog-testimonial-swiper, .ekit-main-swiper');
      testimonialSwipers.forEach(el => {
        // If it's an ElementsKit slider, it might not have the pagination div
        if (!el.querySelector('.swiper-pagination')) {
          const pagination = document.createElement('div');
          pagination.className = 'swiper-pagination';
          el.appendChild(pagination);
        }
        
        // Ensure ElementsKit sliders get our pagination styling class
        if (el.classList.contains('ekit-main-swiper')) {
          el.classList.add('blog-testimonial-swiper');
        }

        new Swiper(el as HTMLElement, {
          slidesPerView: 1,
          spaceBetween: 20,
          loop: true,
          speed: 800,
          autoplay: {
            delay: 5000,
            disableOnInteraction: false,
          },
          pagination: {
            el: el.querySelector('.swiper-pagination') as HTMLElement,
            clickable: true,
          }
        });
      });

      const tocHeader = document.querySelector('.elementor-toc__header') as HTMLElement | null;
      const tocBody = document.querySelector('.elementor-toc__body') as HTMLElement | null;
      
      if (tocHeader && tocBody) {
        const arrow = tocHeader.querySelector('.toc-arrow') as HTMLElement | null;
        if (arrow) {
          let isCollapsed = false;
          tocHeader.addEventListener('click', () => {
            isCollapsed = !isCollapsed;
            tocBody.style.display = isCollapsed ? 'none' : 'block';
            arrow.style.transform = isCollapsed ? 'rotate(180deg)' : 'rotate(0deg)';
          });
        }
        
        // Add hover effects for TOC links
        const tocLinks = tocBody.querySelectorAll('a');
        tocLinks.forEach(a => {
          a.addEventListener('mouseenter', () => a.style.color = '#B02317');
          a.addEventListener('mouseleave', () => a.style.color = '#121417');
        });
      }

      // Elementor FAQ Accordion logic
      const accordions = document.querySelectorAll('.elementor-accordion, .elementor-toggle');
      accordions.forEach(acc => {
        const items = acc.querySelectorAll('.elementor-accordion-item, .elementor-toggle-item');
        items.forEach(item => {
          const titleWrap = item.querySelector('.elementor-tab-title') as HTMLElement;
          const content = item.querySelector('.elementor-tab-content') as HTMLElement;
          if (titleWrap && content) {
            titleWrap.style.cursor = 'pointer';
            titleWrap.style.display = 'flex';
            titleWrap.style.justifyContent = 'space-between';
            titleWrap.style.alignItems = 'center';
            titleWrap.style.padding = '1.25rem 0';
            titleWrap.style.borderBottom = '1px solid #E5E7EB';
            titleWrap.style.fontWeight = '600';
            
            const a = titleWrap.querySelector('a');
            if (a) {
              (a as HTMLElement).style.color = '#121417';
              (a as HTMLElement).style.textDecoration = 'none';
              (a as HTMLElement).style.fontSize = '1.125rem';
            }

            const arrow = document.createElement('span');
            arrow.innerHTML = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#B02317" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>`;
            arrow.style.transition = 'transform 0.3s ease';
            titleWrap.appendChild(arrow);

            titleWrap.addEventListener('click', (e) => {
              e.preventDefault();
              const isOpen = (content as HTMLElement).style.display === 'block';
              (content as HTMLElement).style.display = isOpen ? 'none' : 'block';
              arrow.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(180deg)';
              if (a) (a as HTMLElement).style.color = isOpen ? '#121417' : '#B02317';
            });
          }
        });
      });

      // ElementsKit FAQ Accordion logic
      const ekitAccordions = document.querySelectorAll('.elementskit-accordion');
      ekitAccordions.forEach(acc => {
        const items = acc.querySelectorAll('.elementskit-card');
        items.forEach(item => {
          const header = item.querySelector('.elementskit-card-header') as HTMLElement;
          const content = item.querySelector('.elementskit-card-body') as HTMLElement;
          const a = item.querySelector('.ekit-accordion--toggler') as HTMLElement;
          
          if (header && content && a) {
            header.style.cursor = 'pointer';
            header.style.borderBottom = '1px solid #E5E7EB';
            header.style.padding = '1.25rem 0';
            
            a.style.display = 'flex';
            a.style.justifyContent = 'space-between';
            a.style.alignItems = 'center';
            a.style.textDecoration = 'none';
            a.style.color = '#121417';
            a.style.fontWeight = '600';
            a.style.fontSize = '1.125rem';
            
            // Remove the default elementskit icons
            const iconGroup = a.querySelector('.ekit_accordion_icon_group');
            if (iconGroup) iconGroup.remove();
            
            // Add custom SVG arrow
            const arrow = document.createElement('span');
            arrow.innerHTML = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#B02317" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>`;
            arrow.style.transition = 'transform 0.3s ease';
            a.appendChild(arrow);
            
            // Fix collapse container toggle logic
            const collapseDiv = (content as HTMLElement).closest('.collapse') as HTMLElement || (content as HTMLElement);
            collapseDiv.style.visibility = 'visible'; 
            collapseDiv.style.opacity = '1';
            collapseDiv.style.height = 'auto';
            
            (header as HTMLElement).addEventListener('click', (e) => {
              e.preventDefault();
              const isOpen = collapseDiv.style.display === 'block';
              collapseDiv.style.display = isOpen ? 'none' : 'block';
              arrow.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(180deg)';
              (a as HTMLElement).style.color = isOpen ? '#121417' : '#B02317';
            });
          }
        });
      });
    });
  </script>
</BaseLayout>

<style is:global>
  /* Blog Testimonial Swiper Pagination */
  .blog-testimonial-swiper .swiper-pagination {
    position: relative !important;
    bottom: auto !important;
    margin-top: 3rem !important;
  }
  .blog-testimonial-swiper .swiper-pagination-bullet {
    background-color: #B02317 !important;
    opacity: 1 !important;
    width: 10px !important;
    height: 10px !important;
    margin: 0 6px !important;
  }
  .blog-testimonial-swiper .swiper-pagination-bullet-active {
    background-color: #121417 !important;
  }

  /* FAQ Accordions Pre-hide to prevent CLS */
  .prose-content .elementor-tab-content,
  .prose-content .elementskit-card-body,
  .prose-content .collapse:not(.show) {
    display: none;
    padding: 1.5rem 0;
    color: #554946;
  }
  
  /* Prose Global Typography & Spacing */
  .prose-content a { color: #B02317; transition: color 0.2s; }
  .prose-content a:hover { color: #8e1c12; }
  .prose-content h2 { margin-top: 3.5rem; margin-bottom: 1.5rem; font-family: var(--font-serif, serif); font-size: 1.875rem; font-weight: 500; color: #121417; }
  .prose-content h3 { margin-top: 2.5rem; margin-bottom: 1rem; font-family: var(--font-serif, serif); font-size: 1.5rem; font-weight: 500; color: #121417; }
  .prose-content h4, .prose-content h5, .prose-content h6 { margin-top: 2rem; margin-bottom: 1rem; font-weight: 600; color: #121417; }
  .prose-content p { margin-top: 1.5rem; }
  .prose-content ul { margin-top: 1.5rem; margin-bottom: 1.5rem; list-style: none; padding-left: 0; }
  .prose-content ul li { position: relative; padding-left: 1.5rem; margin-bottom: 0.5rem; }
  .prose-content ul li::before { content: ''; position: absolute; left: 0; top: 0.6rem; height: 0.375rem; width: 0.375rem; border-radius: 50%; background-color: #B02317; }
  .prose-content ol { margin-top: 1.5rem; margin-bottom: 1.5rem; padding-left: 1.25rem; }
  .prose-content ol li { margin-bottom: 0.5rem; }
  
  /* Media/Images/Iframes/Tables */
  .prose-content img { margin: 2.5rem auto; border-radius: 1.5rem; box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1); border: 1px solid #f3f4f6; max-width: 100%; height: auto; }
  .prose-content figure { margin: 2.5rem 0; }
  .prose-content figcaption { text-align: center; font-size: 0.875rem; color: #88726F; margin-top: 0.75rem; font-style: italic; }
  .prose-content iframe { border-radius: 1.5rem; width: 100%; aspect-ratio: 16/9; margin: 2rem 0; }
  .prose-content table { width: 100%; margin: 2.5rem 0; border-collapse: collapse; text-align: left; }
  .prose-content th, .prose-content td { padding: 1rem; border-bottom: 1px solid #E5E7EB; }
  .prose-content th { font-weight: 600; color: #121417; background-color: #FDF9F7; }

  /* Gallery / Elementor Gallery - 4 Column Grid */
  .prose-content .wp-block-gallery,
  .prose-content .elementor-image-gallery .gallery,
  .prose-content .gallery {
    display: grid !important;
    grid-template-columns: repeat(2, 1fr) !important;
    gap: 1.5rem !important;
    margin: 2.5rem 0 !important;
    padding: 0 !important;
    list-style: none !important;
  }
  @media (min-width: 768px) {
    .prose-content .wp-block-gallery,
    .prose-content .elementor-image-gallery .gallery,
    .prose-content .gallery {
      grid-template-columns: repeat(4, 1fr) !important;
    }
  }
  .prose-content .wp-block-gallery .wp-block-image,
  .prose-content .wp-block-gallery figure,
  .prose-content .elementor-image-gallery .gallery-item,
  .prose-content .gallery .gallery-item {
    margin: 0 !important;
    width: 100% !important;
    display: block !important;
  }
  .prose-content .wp-block-gallery img,
  .prose-content .elementor-image-gallery img,
  .prose-content .gallery img {
    margin: 0 !important;
    width: 100% !important;
    height: 100% !important;
    aspect-ratio: 1 / 1 !important;
    object-fit: cover !important;
    border-radius: 1rem !important;
  }

  /* Table of Contents Styling */
  .prose-content .elementor-widget-table-of-contents {
    background: #ffffff;
    border: 1px solid #E5E7EB;
    border-radius: 4px;
    margin: 2.5rem 0;
    width: 100%;
    display: block;
  }
  .prose-content .elementor-toc__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid #E5E7EB;
    margin: 0;
  }
  .prose-content .elementor-toc__header-title {
    font-family: var(--font-sans, sans-serif);
    font-size: 1.25rem !important;
    font-weight: 800 !important;
    color: #121417 !important;
    margin: 0 !important;
  }
  .prose-content .elementor-toc__body {
    padding: 1.5rem;
    display: block;
  }
  .prose-content .elementor-toc__list {
    list-style-type: decimal !important;
    list-style-position: outside !important;
    padding-left: 2.5rem !important;
    margin: 0 !important;
  }
  .prose-content .elementor-toc__nested-list {
    list-style-type: disc !important;
    list-style-position: outside !important;
    padding-left: 1.5rem !important;
    margin-top: 0.75rem !important;
    margin-bottom: 0 !important;
  }
  .prose-content .elementor-toc__nested-list li::before {
    display: none !important;
  }

  /* Testimonials / Blockquotes Styling */
  .prose-content blockquote,
  .prose-content .wp-block-quote {
    margin: 3rem 0;
    background: #ffffff;
    padding: 2rem;
    border-radius: 1.5rem;
    border: 1px solid #94a3b8;
    position: relative;
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
  }
  .prose-content blockquote p,
  .prose-content .wp-block-quote p {
    font-size: 1rem;
    line-height: 1.6;
    color: #121417;
    font-style: normal;
    margin: 0;
  }
  .prose-content blockquote cite,
  .prose-content .wp-block-quote cite {
    display: block;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid #E5E7EB;
    font-family: var(--font-serif, serif);
    font-size: 1.125rem;
    font-weight: 700;
    color: #B02317;
    font-style: normal;
  }
  .prose-content blockquote::before,
  .prose-content .wp-block-quote::before {
    display: none;
  }

  /* Universal SVG Fix to prevent giant icons */
  .prose-content svg {
    max-width: 2rem;
    height: auto;
    display: inline-block;
    vertical-align: middle;
  }

  /* Elementor Icon Lists & Lists containing SVGs (Stars) */
  .prose-content .elementor-icon-list-items,
  .prose-content ul:has(svg) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-left: 0;
    margin: 0 0 1.5rem 0;
    list-style: none;
  }
  .prose-content .elementor-icon-list-item,
  .prose-content ul:has(svg) > li {
    padding-left: 0 !important;
    margin-bottom: 0 !important;
    display: flex;
    align-items: center;
  }
  .prose-content .elementor-icon-list-item::before,
  .prose-content ul:has(svg) > li::before {
    display: none !important;
  }
  .prose-content .elementor-icon-list-icon svg,
  .prose-content .elementor-icon-list-icon i,
  .prose-content ul:has(svg) > li svg {
    width: 1.5rem !important;
    height: 1.5rem !important;
    flex-shrink: 0;
    font-size: 1.5rem;
    color: #B02317;
    fill: currentColor;
  }
  /* ElementsKit Native Testimonial Styling */
  .prose-content .elementskit-single-testimonial-slider {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 1rem;
    padding: 2rem;
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.05);
    margin: 0.5rem 0.5rem; /* Prevent clipping of box shadow in swiper */
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%; /* Make cards equal height */
  }
  .prose-content .elementskit-commentor-content p {
    font-size: 1.125rem;
    line-height: 1.75;
    color: #374151;
    margin: 0;
  }
  .prose-content .elementskit-profile-info {
    border-top: 1px solid #e5e7eb;
    padding-top: 1.5rem;
    margin-top: 0.5rem;
    display: block;
  }
  .prose-content .elementskit-author-name {
    display: block;
    font-size: 1.125rem;
    font-weight: 700;
    color: #B02317;
    margin-bottom: 0.25rem;
  }
  .prose-content .elementskit-author-des {
    font-size: 0.875rem;
    color: #6b7280;
  }
  .prose-content .elementskit-stars {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    list-style: none !important;
    padding-left: 0 !important;
  }
  .prose-content .elementskit-stars li {
    padding-left: 0 !important;
    margin-bottom: 0 !important;
    display: flex;
    align-items: center;
  }
  .prose-content .elementskit-stars li::before {
    display: none !important;
  }
  .prose-content .elementskit-stars svg {
    width: 1.5rem !important;
    height: 1.5rem !important;
    fill: #B02317;
    flex-shrink: 0;
  }
</style>
