---
import { pageSeoData } from "@/lib/site-data";
import BaseLayout from "@/layouts/BaseLayout.astro";

import Hero from "@/components/about/hero.astro";

import AboutUdbhav from "@/components/about/AboutUdbhav.astro";
import ValuesSection from "@/components/about/ValuesSection.astro";

import ContactCta from "@/components/about/contactCta.astro";
import Aboutus from "@/components/about/aboutus.astro";
import Philosophies from "@/components/about/philosophies.astro";

// import TestimonialCard from "@/components/TestimonialCard.astro";

const aboutSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://www.udbhavdevelopers.com/#website",
      "url": "https://www.udbhavdevelopers.com/",
      "name": "Udbhav Developers",
      "description": "Premier construction company in Mangalore."
    },
    {
      "@type": "AboutPage",
      "@id": "https://www.udbhavdevelopers.com/about-us/#webpage",
      "url": "https://www.udbhavdevelopers.com/about-us/",
      "name": "About | Construction Company In Mangalore",
      "description": "Learn about Udbhav Developers, a premier construction company in Mangalore. Constructing residential & commercial landmarks since 2012.",
      "isPartOf": {
        "@id": "https://www.udbhavdevelopers.com/#website"
      },
      "about": {
        "@id": "https://www.udbhavdevelopers.com/about-us/#organization"
      }
    },
    {
      "@type": "HomeAndConstructionBusiness",
      "@id": "https://www.udbhavdevelopers.com/about-us/#organization",
      "name": "Udbhav Developers",
      "alternateName": "Construction Company in Mangalore",
      "url": "https://www.udbhavdevelopers.com/about-us/",
      "logo": "https://www.udbhavdevelopers.com/images/construction-company-mangalore.webp",
      "image": "https://www.udbhavdevelopers.com/images/Mr-BK-Kiran.webp",
      "telephone": "+91-7760471269",
      "foundingDate": "2012",
      "founder": {
        "@type": "Person",
        "name": "Mr. B.K. Kiran",
        "jobTitle": "Founder & Managing Director",
        "description": "Qualified Civil Engineer with over two decades of domestic and international construction and real estate expertise."
      },
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "C6, 1st Floor, City Gate Commercial Complex, Shivbagh Rd, Kadri",
        "addressLocality": "Mangaluru",
        "addressRegion": "Karnataka",
        "postalCode": "575002",
        "addressCountry": "IN"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 12.8765,
        "longitude": 74.8485
      },
      "areaServed": {
        "@type": "City",
        "name": "Mangaluru"
      },
      "memberOf": {
        "@type": "Organization",
        "name": "CREDAI",
        "sameAs": "https://credai.org/"
      }
    }
  ]
};
---

<BaseLayout
  seoTitle={pageSeoData.aboutUs.seoTitle}
  seoKeywords={pageSeoData.aboutUs.seoKeywords}
  seoDescription={pageSeoData.aboutUs.seoDescription}
  preloadImage="/images/Udbhav-website.webp"
>
  <script type="application/ld+json" set:html={JSON.stringify(aboutSchema)} />
  <Hero />
  <Aboutus/>
  <AboutUdbhav />
  <Philosophies/>
  <ValuesSection />
  
  <!-- <TestimonialCard /> -->
  <ContactCta />
</BaseLayout>
