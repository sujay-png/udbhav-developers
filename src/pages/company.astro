---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import ArtPanel from "@/components/ArtPanel.astro";
import TestimonialsSection from "@/components/sections/TestimonialsSection.astro";
import { EnquiryForm } from "@/components/EnquiryForm";
import { Icon } from "@/components/Icon";
import { pillars, siteConfig } from "@/lib/site-data";
---

<BaseLayout title="Company" description="Established 2012 — Udbhav Developers stands for excellence, integrity, and innovation in premium residential apartments, commercial spaces, and retail shops.">
  <section class="relative overflow-hidden bg-ink text-cream">
    <ArtPanel seed={7} tone="ink" class="absolute inset-0 opacity-80" />
    <div class="relative mx-auto max-w-[1400px] px-5 py-24 md:px-10 md:py-32">
      <Eyebrow light>Established {siteConfig.founded}</Eyebrow>
      <h1 class="mt-4 max-w-2xl text-balance font-display text-5xl leading-[1.05] md:text-6xl">
        Building with Purpose, <em class="italic text-clay">Driven by Trust.</em>
      </h1>
      <p class="mt-6 max-w-lg text-[15px] leading-relaxed text-cream/70">
        At Udbhav Developers, we stand for excellence, integrity, and innovation in the development of premium residential apartments, commercial spaces, and retail shops.
      </p>
    </div>
  </section>

  <section class="mx-auto grid max-w-[1400px] gap-12 px-5 py-24 md:px-10 lg:grid-cols-2 lg:items-center lg:gap-20">
    <div class="order-2 lg:order-1">
      <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-clay">Since {siteConfig.founded}</p>
      <h2 class="mt-4 text-balance font-display text-3xl leading-tight md:text-4xl">
        A reputation built one address at a time.
      </h2>
      <p class="mt-5 max-w-md text-[15px] leading-relaxed text-muted-foreground">
        Since our inception in {siteConfig.founded}, we have been committed to creating future-ready structures that trend thoughtful design with long-term value. Our journey is paved with projects that aren't just buildings, but benchmarks of architectural precision.
      </p>
      <blockquote class="mt-6 border-l-2 border-clay pl-4 font-display text-lg italic text-ink/80">
        "We aim to create a benchmark in the real estate industry with a long-lasting reputation for quality, trust, and innovation."
      </blockquote>
    </div>
    <div class="order-1 aspect-[4/3] overflow-hidden rounded-lg lg:order-2">
      <ArtPanel seed={8} tone="sand" class="h-full w-full" />
    </div>
  </section>

  <section class="bg-blush">
    <div class="mx-auto max-w-[1400px] px-5 py-24 md:px-10">
      <div class="mx-auto max-w-xl text-center">
        <Eyebrow class="justify-center">Why We're Different</Eyebrow>
        <h2 class="mt-3 text-balance font-display text-4xl leading-[1.1] md:text-[2.75rem]">Why we're your best choice</h2>
        <p class="mt-4 text-sm text-muted-foreground">Our philosophy is built on three core pillars that define every square foot we develop.</p>
      </div>
      <div class="mx-auto mt-14 grid max-w-4xl gap-6 sm:grid-cols-3">
        {
          pillars.map((p) => (
            <div class="rounded-lg bg-white p-7 text-center">
              <div class="mx-auto grid h-11 w-11 place-items-center rounded-full bg-muted text-clay">
                <Icon name={p.icon as "shield" | "leaf" | "smile"} className="h-5 w-5" />
              </div>
              <p class="mt-4 font-display text-lg">{p.title}</p>
              <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{p.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <TestimonialsSection title="What people are saying about us" />

  <section class="mx-auto max-w-[1400px] px-5 pb-24 md:px-10">
    <div class="grid gap-10 rounded-lg bg-ink p-8 text-cream md:p-14 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="font-display text-3xl leading-tight md:text-4xl">Get in touch with us.</h2>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-cream/65">
          Ready to upgrade to a lifestyle of your choice? Our team is standing by to help you find your dream space.
        </p>
        <div class="mt-8 space-y-4 text-sm">
          <p class="flex items-center gap-3"><Icon name="phone" className="h-4 w-4 text-clay" /> {siteConfig.phone}</p>
          <p class="flex items-center gap-3"><Icon name="mail" className="h-4 w-4 text-clay" /> {siteConfig.email}</p>
        </div>
      </div>
      <EnquiryForm client:load dark={true} redirectUrl="/thank-you" />
    </div>
  </section>
</BaseLayout>
