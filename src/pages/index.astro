---
import { pageSeoData } from "@/lib/site-data";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/sections/Hero.astro";
import FeaturedProjects from "@/components/sections/FeaturedProjects.astro";
import AboutTeaser from "@/components/sections/AboutTeaser.astro";
import TestimonialsSection from "@/components/sections/TestimonialsSection.astro";
import Whychooseus from "@/components/sections/Whychooseus.astro";
import HomeContactSection from "@/components/sections/HomeContactSection.astro";

const homeSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://www.udbhavdevelopers.com/#webpage",
      "url": "https://www.udbhavdevelopers.com/",
      "name": "Leading Real Estate Builders In Mangalore · Udbhav Developers",
      "description": "A premier real estate developers and builders in Mangalore with 13+ years of experience. Discover RERA approved projects by builders in mangalore.",
      "keywords": "Developers in mangaluru, Builders in mangaluru",
      "about": {
        "@id": "https://www.udbhavdevelopers.com/#organization"
      }
    },
    {
      "@type": "RealEstateAgent",
      "@id": "https://www.udbhavdevelopers.com/#organization",
      "name": "Udbhav Developers",
      "url": "https://www.udbhavdevelopers.com/",
      "logo": "https://www.udbhavdevelopers.com/wp-content/uploads/logo.png",
      "telephone": "+91 77604 71269",
      "founder": {
        "@type": "Person",
        "name": "Mr. B.K. Kiran"
      },
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "C6, 1st Floor, City Gate Commercial Complex, Shivbagh Rd, Kadri",
        "addressLocality": "Mangaluru",
        "addressRegion": "Karnataka",
        "postalCode": "575002",
        "addressCountry": "IN"
      },
      "sameAs": [
        "https://www.facebook.com/udbhavdevelopers/",
        "https://www.instagram.com/udbhavdevelopers/",
        "https://www.youtube.com/@udbhavdevelopersmlr"
      ]
    }
  ]
};
---

<BaseLayout
  seoTitle={pageSeoData.home.seoTitle}
  seoDescription={pageSeoData.home.seoDescription}
  seoKeywords={pageSeoData.home.seoKeywords}
  preloadImage="/images/Udbhav-website.webp"
>
  <script type="application/ld+json" set:html={JSON.stringify(homeSchema)} />
  <Hero />
  <FeaturedProjects />
  <AboutTeaser />
  <TestimonialsSection />
  <Whychooseus/>
  <HomeContactSection />
</BaseLayout>
