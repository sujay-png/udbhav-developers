---
import { pageSeoData } from "@/lib/site-data";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/sections/Hero.astro";
import FeaturedProjects from "@/components/sections/FeaturedProjects.astro";
import AboutTeaser from "@/components/sections/AboutTeaser.astro";
import TestimonialsSection from "@/components/sections/TestimonialsSection.astro";
import Whychooseus from "@/components/sections/Whychooseus.astro";
import ContactCta from "@/components/about/contactCta.astro";

const homeSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://www.udbhavdevelopers.com/#website",
      "url": "https://www.udbhavdevelopers.com/",
      "name": "Udbhav Developers",
      "description": "Premier construction company and real estate developers in Mangaluru founded by Mr. B.K. Kiran.",
      "publisher": {
        "@id": "https://www.udbhavdevelopers.com/#organization"
      }
    },
    {
      "@type": "ConstructionBusiness",
      "@id": "https://www.udbhavdevelopers.com/#organization",
      "name": "Udbhav Developers",
      "alternateName": "Construction Company in Mangaluru",
      "url": "https://www.udbhavdevelopers.com/",
      "logo": "https://www.udbhavdevelopers.com/assets/images/logo.png",
      "image": "https://www.udbhavdevelopers.com/assets/images/logo.png",
      "telephone": "+91-9845082466",
      "priceRange": "₹₹₹",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "C6, 1st Floor, City Gate Commercial Complex, Shivbagh Rd, Kadri",
        "addressLocality": "Mangaluru",
        "addressRegion": "Karnataka",
        "postalCode": "575002",
        "addressCountry": "IN"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 12.8833,
        "longitude": 74.8500
      },
      "memberOf": [
        {
          "@type": "Organization",
          "name": "CREDAI (Confederation of Real Estate Developers' Associations of India)",
          "sameAs": "https://credai.org/"
        }
      ],
      "founder": {
        "@type": "Person",
        "name": "Mr. B.K. Kiran",
        "jobTitle": "Founder & Managing Director",
        "description": "Qualified Civil Engineer with over two decades of domestic and international real estate development and structural engineering expertise."
      },
      "areaServed": [
        {
          "@type": "City",
          "name": "Mangaluru"
        },
        {
          "@type": "AdministrativeArea",
          "name": "Kadri"
        }
      ],
      "knowsAbout": [
        "Construction Company in Mangaluru",
        "Luxury Residential Construction",
        "Civil Engineering Quality Audits"
      ]
    },
    {
      "@type": "LocalBusiness",
      "@id": "https://www.udbhavdevelopers.com/#ratingsubject",
      "name": "Udbhav Developers - Reviews",
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.5",
        "reviewCount": "23",
        "bestRating": "5",
        "worstRating": "1"
      }
    }
  ]
};
---

<BaseLayout seoTitle={pageSeoData.home.seoTitle} seoDescription={pageSeoData.home.seoDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(homeSchema)} />
  <Hero />
  <FeaturedProjects />
  <AboutTeaser />
  <TestimonialsSection />
  <Whychooseus/>
  <ContactCta showBadge={false} />
</BaseLayout>
