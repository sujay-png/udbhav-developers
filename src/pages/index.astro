---
import { pageSeoData } from "@/lib/site-data";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/sections/Hero.astro";
import FeaturedProjects from "@/components/sections/FeaturedProjects.astro";
import AboutTeaser from "@/components/sections/AboutTeaser.astro";
import TestimonialsSection from "@/components/sections/TestimonialsSection.astro";
import Whychooseus from "@/components/sections/Whychooseus.astro";
import HomeContactSection from "@/components/sections/HomeContactSection.astro";
import HomeFaqSection from "@/components/sections/HomeFaqSection.astro";

const homeSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://www.udbhavdevelopers.com/#webpage",
      "url": "https://www.udbhavdevelopers.com/",
      "name": "Leading Real Estate Builders In Mangalore · Udbhav Developers",
      "description": "A premier real estate developers and builders in Mangalore with 13+ years of experience. Discover RERA approved projects by builders in mangalore.",
      "keywords": "Developers in mangaluru, Builders in mangaluru",
      "about": {
        "@id": "https://www.udbhavdevelopers.com/#organization"
      }
    },
    {
      "@type": "RealEstateAgent",
      "@id": "https://www.udbhavdevelopers.com/#organization",
      "name": "Udbhav Developers",
      "url": "https://www.udbhavdevelopers.com/",
      "logo": "https://www.udbhavdevelopers.com/wp-content/uploads/logo.png",
      "telephone": "+91 77604 71269",
      "founder": {
        "@type": "Person",
        "name": "Mr. B.K. Kiran"
      },
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "C6, 1st Floor, City Gate Commercial Complex, Shivbagh Rd, Kadri",
        "addressLocality": "Mangaluru",
        "addressRegion": "Karnataka",
        "postalCode": "575002",
        "addressCountry": "IN"
      },
      "sameAs": [
        "https://www.facebook.com/udbhavdevelopers/",
        "https://www.instagram.com/udbhavdevelopers/",
        "https://www.youtube.com/@udbhavdevelopersmlr"
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://www.udbhavdevelopers.com/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Who are the leading builders in Mangalore for luxury apartments?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Udbhav Developers is recognized as one of the premier builders in Mangalore, founded in 2012 by qualified civil engineer Mr. B.K. Kiran. Specializing in luxury residential spaces and premium commercial properties in prime micro-locations like Kadri, Udbhav Developers delivers uncompromising structural integrity and complete RERA compliance."
          }
        },
        {
          "@type": "Question",
          "name": "What makes Udbhav Developers a trusted real estate builder in Mangalore?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "As a CREDAI-affiliated construction company, Udbhav Developers stands out among real estate builders in Mangalore due to direct civil engineering leadership, transparent project tracking, earthquake-resistant architectural designs, and a proven track record of delivering premium homes like Udbhav Chinmaya."
          }
        },
        {
          "@type": "Question",
          "name": "Are projects by Udbhav Developers RERA approved?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, all ongoing and completed residential and commercial projects by Udbhav Developers are 100% RERA-approved, ensuring complete legal transparency, secure title deeds, and adherence to Karnataka real estate regulatory standards."
          }
        },
        {
          "@type": "Question",
          "name": "Which localities do Udbhav Developers build in?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Udbhav Developers focuses on high-demand, prime urban micro-markets across Mangaluru, including Kadri, Shivbagh Road, and surrounding central residential hubs."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout
  seoTitle={pageSeoData.home.seoTitle}
  seoDescription={pageSeoData.home.seoDescription}
  seoKeywords={pageSeoData.home.seoKeywords}
  preloadImage="/images/Udbhav-website.webp"
>
  <script type="application/ld+json" set:html={JSON.stringify(homeSchema)} />
  <Hero />
  <FeaturedProjects />
  <AboutTeaser />
  <TestimonialsSection />
  <Whychooseus/>
  <HomeContactSection />
  <HomeFaqSection />
</BaseLayout>
