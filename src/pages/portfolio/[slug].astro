    size: "Ground + 4 Floors",
    area: "18 Cents",
    galleryImages: [
      { src: "https://udbhavdevelopers.com/wp-content/uploads/2025/07/DSC_5349-min.jpg", alt: "Udbhav Shanthi Elevation", title: "Udbhav Shanthi", subtitle: "Kadri, Mangalore" },
      { src: "https://udbhavdevelopers.com/wp-content/uploads/2025/07/DSC_5346-min.jpg", alt: "Udbhav Shanthi Facade", title: "Facade View", subtitle: "Kadri, Mangalore" },
