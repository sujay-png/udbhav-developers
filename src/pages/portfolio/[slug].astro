    mapSrc: "https://maps.google.com/maps?q=3-28-2326%2C%20Kadri%20Temple%20Rd%2C%20Mallikatte%2C%20Kadri%2C%20Mangaluru%2C%20Karnataka%20575003&t=m&z=16&output=embed&iwloc=near",
