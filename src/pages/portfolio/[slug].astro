<script>
  function setupGallery() {
    const container = document.getElementById('gallery-container');
    const btnLeft = document.getElementById('scroll-left');
    const btnRight = document.getElementById('scroll-right');

    if (!container || !btnLeft || !btnRight) return;

    const scrollAmount = 480;

    btnLeft.onclick = () => {
      container.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
    };

    btnRight.onclick = () => {
      container.scrollBy({ left: scrollAmount, behavior: 'smooth' });
    };
  }

  function setupFloorPlans() {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.plan-card');
    const container = document.getElementById('plans-container');
    const overlayLeft = document.getElementById('plans-overlay-left');
    const overlayRight = document.getElementById('plans-overlay-right');
    const scrollContainers = document.querySelectorAll('.plans-controls-container');
    
    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        // Update active button styling
        filterBtns.forEach(b => {
          b.classList.remove('bg-clay', 'text-cream');
          b.classList.add('bg-ink/5', 'text-ink');
        });
        btn.classList.remove('bg-ink/5', 'text-ink');
        btn.classList.add('bg-clay', 'text-cream');
        
        const filter = btn.getAttribute('data-filter');
        const isCarouselMode = filter === '3BHK';

        // Toggle layout
        if (container) {
          if (isCarouselMode) {
             container.classList.add('flex', 'overflow-x-auto', 'snap-x', 'snap-mandatory', '[&::-webkit-scrollbar]:hidden');
             container.classList.remove('grid', 'grid-cols-1', 'sm:grid-cols-3');
          } else {
             container.classList.remove('flex', 'overflow-x-auto', 'snap-x', 'snap-mandatory', '[&::-webkit-scrollbar]:hidden');
             container.classList.add('grid', 'grid-cols-1', 'sm:grid-cols-3');
          }
        }

        // Hide/show overlays and controls
        if (overlayLeft) overlayLeft.style.display = isCarouselMode ? 'block' : 'none';
        if (overlayRight) overlayRight.style.display = isCarouselMode ? 'block' : 'none';
        
        scrollContainers.forEach(controls => {
          (controls as HTMLElement).style.display = isCarouselMode ? '' : 'none';
        });
        
        // Handle autoplay logic
        if (!isCarouselMode) {
           (window as any).stopAutoplay();
        } else {
           (window as any).startAutoplay();
        }

        // Filter cards and toggle classes
        cards.forEach(card => {
          const c = card as HTMLElement;
          if (c.getAttribute('data-category') === filter) {
            c.style.display = 'block';
          } else {
            c.style.display = 'none';
          }

          if (isCarouselMode) {
            c.classList.add('snap-start', 'flex-shrink-0', 'w-full', 'sm:w-[calc(50%-12px)]', 'lg:w-[calc(33.333%-16px)]');
          } else {
            c.classList.remove('snap-start', 'flex-shrink-0', 'w-full', 'sm:w-[calc(50%-12px)]', 'lg:w-[calc(33.333%-16px)]');
          }
        });
        
        // Reset scroll position on filter change
        if (container && isCarouselMode) {
          container.scrollLeft = 0;
        }
      });
    });

    // Carousel logic for plans
    const btnsLeft = document.querySelectorAll('.plans-scroll-left');
    const btnsRight = document.querySelectorAll('.plans-scroll-right');
    let autoplayInterval: any;

    const getScrollAmount = () => {
      const firstCard = container?.querySelector('.plan-card') as HTMLElement;
      if (firstCard) {
         return firstCard.offsetWidth + 24; // width + gap-6 (24px)
      }
      return 340; // fallback
    };

    (window as any).startAutoplay = () => {
      (window as any).stopAutoplay();
      autoplayInterval = setInterval(() => {
        if (container && container.classList.contains('flex')) {
          const scrollAmount = getScrollAmount();
          // Check if we're at the end (with a small 10px buffer)
          if (container.scrollLeft + container.clientWidth >= container.scrollWidth - 10) {
             container.scrollTo({ left: 0, behavior: 'smooth' });
          } else {
             container.scrollBy({ left: scrollAmount, behavior: 'smooth' });
          }
        }
      }, 3500); // 3.5 seconds
    };

    (window as any).stopAutoplay = () => {
      if (autoplayInterval) clearInterval(autoplayInterval);
    };

    // Export to local scope for backward compatibility with the click handler we just defined above
    const startAutoplay = (window as any).startAutoplay;
    const stopAutoplay = (window as any).stopAutoplay;

    if (container && btnsLeft.length > 0 && btnsRight.length > 0) {
      btnsLeft.forEach(btn => {
        btn.addEventListener('click', () => {
          container.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
          startAutoplay();
        });
      });

      btnsRight.forEach(btn => {
        btn.addEventListener('click', () => {
          container.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
          startAutoplay();
        });
      });

      // Pause autoplay when interacting
      container.addEventListener('mouseenter', stopAutoplay);
      container.addEventListener('mouseleave', startAutoplay);
      container.addEventListener('touchstart', stopAutoplay, { passive: true });
      container.addEventListener('touchend', startAutoplay, { passive: true });
    }

    startAutoplay();

    // Initialize first filter
    const activeBtn = document.querySelector('.filter-btn[data-filter="3BHK"]') as HTMLElement;
    if(activeBtn) activeBtn.click();
    
    // Lightbox logic
    const lightbox = document.getElementById('plan-lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const closeBtn = document.getElementById('close-lightbox');
    
    (window as any).openLightbox = (imgSrc: string) => {
      if(!lightboxImg || !lightbox) return;
      lightboxImg.src = imgSrc;
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      // small delay for transition
      setTimeout(() => {
        lightbox.classList.remove('opacity-0');
        lightboxImg.classList.remove('scale-95');
        lightboxImg.classList.add('scale-100');
      }, 10);
      document.body.style.overflow = 'hidden';
    };
    
    const closeLightboxFn = () => {
      if(!lightbox || !lightboxImg) return;
      lightbox.classList.add('opacity-0');
      lightboxImg.classList.remove('scale-100');
      lightboxImg.classList.add('scale-95');
      setTimeout(() => {
        lightbox.classList.remove('flex');
        lightbox.classList.add('hidden');
        document.body.style.overflow = '';
      }, 300);
    };
    
    if(closeBtn) closeBtn.addEventListener('click', closeLightboxFn);
    
    if(lightbox) {
      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) {
          closeLightboxFn();
        }
      });
    }
    
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && lightbox && !lightbox.classList.contains('hidden')) {
        closeLightboxFn();
      }
    });
  }

  function setupAmenitiesCarousel() {
    const carousel = document.getElementById('amenities-carousel');
    const btnPrev = document.getElementById('amenity-prev');
    const btnNext = document.getElementById('amenity-next');
    const dots = document.querySelectorAll('.amenity-dot');
    
    if (!carousel || !btnPrev || !btnNext || dots.length === 0) return;
    
    let currentIndex = 0;
    const total = dots.length;
    let autoplayInterval: any;
    
    function goToSlide(index: number) {
      if (index < 0) index = total - 1;
      if (index >= total) index = 0;
      currentIndex = index;
      
      carousel!.style.transform = `translateX(-${currentIndex * 100}%)`;
      
      dots.forEach((dot, i) => {
        if (i === currentIndex) {
          dot.classList.remove('bg-white/40');
          dot.classList.add('bg-white');
        } else {
          dot.classList.remove('bg-white');
          dot.classList.add('bg-white/40');
        }
      });
    }

    function startAutoplay() {
      stopAutoplay();
      autoplayInterval = setInterval(() => {
        goToSlide(currentIndex + 1);
      }, 4000); // 4 seconds
    }

    function stopAutoplay() {
      if (autoplayInterval) clearInterval(autoplayInterval);
    }
    
    btnPrev.addEventListener('click', () => {
      goToSlide(currentIndex - 1);
      startAutoplay();
    });
    
    btnNext.addEventListener('click', () => {
      goToSlide(currentIndex + 1);
      startAutoplay();
    });
    
    dots.forEach((dot) => {
      dot.addEventListener('click', (e) => {
        const index = parseInt((e.target as HTMLElement).getAttribute('data-index') || '0');
        goToSlide(index);
        startAutoplay();
      });
    });

    const parent = carousel.parentElement;
    if (parent) {
      parent.addEventListener('mouseenter', stopAutoplay);
      parent.addEventListener('mouseleave', startAutoplay);
      parent.addEventListener('touchstart', stopAutoplay, { passive: true });
      parent.addEventListener('touchend', startAutoplay, { passive: true });
    }

    startAutoplay();
  }

  function setupSpecsViewMore() {
    const viewMoreBtn = document.getElementById('view-more-specs');
    const extraSpecs = document.querySelectorAll('.spec-item-extra');
    
    if (viewMoreBtn && extraSpecs.length > 0) {
      let isExpanded = false;
      
      viewMoreBtn.addEventListener('click', () => {
        isExpanded = !isExpanded;
        
        extraSpecs.forEach(item => {
          if (isExpanded) {
            item.classList.remove('hidden');
          } else {
            item.classList.add('hidden');
          }
        });
        
        if (isExpanded) {
          viewMoreBtn.innerHTML = `
            View Less
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
          `;
        } else {
          viewMoreBtn.innerHTML = `
            View More
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          `;
        }
      });
    }
  }

  function setupUpdatesCarousel() {
    const container = document.getElementById('updates-scroll-container');
    const btnPrev = document.getElementById('updates-prev');
    const btnNext = document.getElementById('updates-next');
    
    if (!container || !btnPrev || !btnNext) return;
    
    const scrollAmount = 340; // Card width + gap roughly
    
    btnPrev.addEventListener('click', () => {
      container.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
    });
    
    btnNext.addEventListener('click', () => {
      container.scrollBy({ left: scrollAmount, behavior: 'smooth' });
    });
    
    function updateButtons() {
      if (!container || !btnPrev || !btnNext) return;
      btnPrev.style.opacity = container.scrollLeft <= 5 ? '0.3' : '';
      btnPrev.style.pointerEvents = container.scrollLeft <= 5 ? 'none' : 'auto';
      
      const isAtEnd = container.scrollLeft >= container.scrollWidth - container.clientWidth - 5;
      btnNext.style.opacity = isAtEnd ? '0.3' : '';
      btnNext.style.pointerEvents = isAtEnd ? 'none' : 'auto';
    }
    
    container.addEventListener('scroll', updateButtons, { passive: true });
    setTimeout(updateButtons, 100);
    window.addEventListener('resize', updateButtons);

    // Autoplay logic
    let autoplayTimer: any;
    
    function startAutoplay() {
      stopAutoplay();
      autoplayTimer = setInterval(() => {
        if (!container) return;
        const isAtEnd = container.scrollLeft >= container.scrollWidth - container.clientWidth - 5;
        if (isAtEnd) {
          container.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          container.scrollBy({ left: scrollAmount, behavior: 'smooth' });
        }
      }, 3000);
    }
    
    function stopAutoplay() {
      if (autoplayTimer) clearInterval(autoplayTimer);
    }
    
    // Pause autoplay on hover or interaction
    const wrapper = container.parentElement;
    if (wrapper) {
      wrapper.addEventListener('mouseenter', stopAutoplay);
      wrapper.addEventListener('mouseleave', startAutoplay);
      wrapper.addEventListener('touchstart', stopAutoplay, { passive: true });
    }
    
    startAutoplay();
  }

  setupGallery();
  setupFloorPlans();
  setupAmenitiesCarousel();
  setupSpecsViewMore();
  setupUpdatesCarousel();
  document.addEventListener('astro:page-load', () => {
    setupGallery();
    setupFloorPlans();
    setupAmenitiesCarousel();
    setupSpecsViewMore();
    setupUpdatesCarousel();
  });
</script>