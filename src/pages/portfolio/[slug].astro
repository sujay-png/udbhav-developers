    possession: "Project completed in 2022",
    rera: "PRM/KA/RERA/1257/334/PR/210219/003923",
    size: "Ground + 3 Floors",
    area: "18 Cents",
    galleryImages: [
      { src: "https://udbhavdevelopers.com/wp-content/uploads/2025/07/Picture3-1.jpg", alt: "K.R.K. Aayush Building", title: "K.R.K. Aayush", subtitle: "Urwa Hoigebail, Mangalore" },
      { src: "https://udbhavdevelopers.com/wp-content/uploads/2025/07/Picture15-1.jpg", alt: "K.R.K. Aayush Exterior", title: "Exterior View", subtitle: "Urwa Hoigebail, Mangalore" },
      { src: "https://udbhavdevelopers.com/wp-content/uploads/2025/07/Picture13-1.jpg", alt: "K.R.K. Aayush Facade", title: "Facade Detail", subtitle: "Contemporary Styling" },
      { src: "https://udbhavdevelopers.com/wp-content/uploads/2025/07/Picture1-1.jpg", alt: "K.R.K. Aayush Interior", title: "Interior Finish", subtitle: "1 & 2 BHK Apartments" },
      { src: "https://udbhavdevelopers.com/wp-content/uploads/2025/07/Picture5-1-1.jpg", alt: "K.R.K. Aayush Common Area", title: "Common Area", subtitle: "Urwa Hoigebail, Mangalore" },
      { src: "https://udbhavdevelopers.com/wp-content/uploads/2025/07/Picture6-1.jpg", alt: "K.R.K. Aayush Amenities", title: "Amenities", subtitle: "Modern Living" },
      { src: "https://udbhavdevelopers.com/wp-content/uploads/2025/07/Picture7-1.jpg", alt: "K.R.K. Aayush Detail", title: "Architectural Detail", subtitle: "Urwa Hoigebail, Mangalore" },
      { src: "https://udbhavdevelopers.com/wp-content/uploads/2025/07/Picture8-1.jpg", alt: "K.R.K. Aayush View", title: "Building View", subtitle: "Urwa Hoigebail, Mangalore" },
    ]

  },
  "udbhav-square": {
    subtitle: "Commercial Landmark",
    overview: "Udbhav Square is an elegantly designed 20,000 sq. ft. commercial space at Kottara Chowki, built with a contemporary touch and an eco-friendly footprint suited to a wide range of businesses — from banks, polyclinics, and individual clinics to offices, automobile showrooms, shipping offices, and supermarkets. Ample parking at road level and in the basement rounds out a dependable, business-ready address.",
    mapTitle: "Kottara Chowki",
    mapDesc: "Kottara Chowki is a well-connected commercial junction in Mangaluru, popular with retailers, clinics, and offices for its visibility and accessibility.",
    mapSrc: "https://maps.google.com/maps?q=Udbhav%20Square%2C%20Kottara%20Chowki%2C%20Mangalore&t=m&z=16&output=embed&iwloc=near",
    mapQueryName: "Kottara Chowki, Mangaluru",
      typology: "Office & Retail Space",
    possession: "Project completed in 2020",
    rera: "PRM/KA/RERA/1257/334/PR/180222/002553",
    size: "Basement + Ground + 3 Floors",
    area: "25 Cents",
    galleryImages: [
      { src: "https://udbhavdevelopers.com/wp-content/uploads/2025/07/lrg25-1-1.jpg", alt: "Udbhav Square Exterior", title: "Udbhav Square", subtitle: "Kottara Chowki, Mangalore" },
      { src: "https://udbhavdevelopers.com/wp-content/uploads/2025/07/Square-1.webp", alt: "Udbhav Square Facade", title: "Facade View", subtitle: "Commercial Space" },
      { src: "https://udbhavdevelopers.com/wp-content/uploads/2025/07/Square-2.webp", alt: "Udbhav Square Retail Frontage", title: "Retail Frontage", subtitle: "Kottara Chowki, Mangalore" },
      { src: "https://udbhavdevelopers.com/wp-content/uploads/2025/07/Square-3.webp", alt: "Udbhav Square Interior", title: "Interior Finish", subtitle: "Office & Retail Space" },
      { src: "https://udbhavdevelopers.com/wp-content/uploads/2025/07/Square-4.webp", alt: "Udbhav Square Parking", title: "Parking & Access", subtitle: "Basement + Ground Level" },
      { src: "https://udbhavdevelopers.com/wp-content/uploads/2025/07/lrg24-1.jpg", alt: "Udbhav Square Detail", title: "Architectural Detail", subtitle: "Kottara Chowki, Mangalore" },
      { src: "https://udbhavdevelopers.com/wp-content/uploads/2025/07/lrg14-1.jpg", alt: "Udbhav Square View", title: "Building View", subtitle: "Kottara Chowki, Mangalore" },
      { src: "https://udbhavdevelopers.com/wp-content/uploads/2025/07/lrg21-1.jpg", alt: "Udbhav Square Streetside", title: "Street View", subtitle: "Kottara Chowki, Mangalore" },
    ]
  
  },
  "bhaskar-coconut-groves": {
    subtitle: "Green-Canopy Residences",
    overview: "Bhaskar Coconut Groves is a five-storeyed premium apartment complex near Nantoor Junction, set in a calm, green neighbourhood and housing 28 homes including duplex units. Amenities include a children's play area, recreation room, gym, spacious lobby, reticulated gas connection, security, power backup, ample parking, and automatic lifts. Floor plans follow Vaastu principles, with spacious rooms designed for maximum ventilation and natural light.",
    mapTitle: "Maroli",
    mapDesc: "Maroli offers a calm, green residential setting near Nantoor Junction, combining natural surroundings with easy access to the rest of Mangaluru.",
    mapSrc: "https://maps.google.com/maps?q=Bhaskar%20Coconut%20Groves%2C%20Tharethotta%20Road%2C%20Adu%2C%20Maroli%2C%20Mangaluru%2C%20Karnataka%20575002&t=m&z=16&output=embed&iwloc=near",
    mapQueryName: "Tharethotta Road, Maroli, Mangaluru",
     typology: "Residential Apartments",
    possession: "Project completed in 2015",
    rera: "—",
    size: "Ground + 5 Floors",
    area: "35 Cents",
    galleryImages: [
      { src: "https://udbhavdevelopers.com/wp-content/uploads/2025/07/lrg11.jpg", alt: "Bhaskar Coconut Groves Exterior", title: "Bhaskar Coconut Groves", subtitle: "Maroli, Mangalore" },
      { src: "https://udbhavdevelopers.com/wp-content/uploads/2025/07/lrg8.jpg", alt: "Bhaskar Coconut Groves Facade", title: "Facade View", subtitle: "Maroli, Mangalore" },
      { src: "https://udbhavdevelopers.com/wp-content/uploads/2025/07/lrg10.jpg", alt: "Bhaskar Coconut Groves Grounds", title: "Landscaped Grounds", subtitle: "Coconut Grove Setting" },
      { src: "https://udbhavdevelopers.com/wp-content/uploads/2025/07/lrg9.jpg", alt: "Bhaskar Coconut Groves Interior", title: "Interior Finish", subtitle: "Duplex & Apartment Units" },
      { src: "https://udbhavdevelopers.com/wp-content/uploads/2025/07/lrg6.jpg", alt: "Bhaskar Coconut Groves Amenities", title: "Amenities", subtitle: "Recreation & Play Area" },
      { src: "https://udbhavdevelopers.com/wp-content/uploads/2025/07/lrg2.jpg", alt: "Bhaskar Coconut Groves Lobby", title: "Lobby", subtitle: "Maroli, Mangalore" },
      { src: "https://udbhavdevelopers.com/wp-content/uploads/2025/07/lrg13.jpg", alt: "Bhaskar Coconut Groves Detail", title: "Architectural Detail", subtitle: "Maroli, Mangalore" },
      { src: "https://udbhavdevelopers.com/wp-content/uploads/2025/07/lrg14.jpg", alt: "Bhaskar Coconut Groves View", title: "Building View", subtitle: "Maroli, Mangalore" },
    ]
   
  }
};

const currentInfo = projectDetails[project.slug as keyof typeof projectDetails] || {
  subtitle: project.tagline,
  overview: project.description,
  mapTitle: project.location,
  mapDesc: "A prime location offering optimal accessibility and neighborhood amenities.",
  mapSrc: "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3889.3564993883187!2d74.8485!3d12.8647!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3ba35c0245645679%3A0x629c12345678abcd!2sMangaluru%2C%20Karnataka!5e0!3m2!1sen!2sin!4v1710000000000!5m2!1sen!2sin",
  mapQueryName: project.location,
  galleryImages: [{ src: "/images/projects/chinmaya.jpg", alt: project.name, title: project.name, subtitle: project.location }]
};
---

<BaseLayout title={project.name} description={`${project.tagline} — ${project.name} by Udbhav Developers in ${project.location}.`}>
  <section class="relative overflow-hidden bg-ink text-cream">
    <ArtPanel seed={seed} tone={project.category === "Commercial" ? "ink" : "clay"} class="absolute inset-0" />
    <div class="relative mx-auto max-w-[1400px] px-5 py-24 md:px-10 md:py-32">
      <a href="/portfolio" class="inline-flex items-center gap-2 text-xs font-medium uppercase tracking-wide text-cream/60 hover:text-cream">
        <Icon name="arrow-left" className="h-3.5 w-3.5" /> Back to Portfolio
      </a>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <Badge>{project.status}</Badge>
        <Badge variant="outline" class="border-cream/30 text-cream">{project.category}</Badge>
      </div>
      <h1 class="mt-5 max-w-2xl text-balance font-display text-5xl leading-[1.05] md:text-6xl">{project.name}</h1>
      <p class="mt-4 max-w-lg text-[15px] text-cream/70">{project.tagline}</p>
    </div>
  </section>

  <section class="mx-auto grid max-w-[1400px] gap-12 px-5 py-20 md:px-10 lg:grid-cols-[1fr_320px]">
    <div class="space-y-6">
      <div>
        <h2 class="font-display text-2xl font-normal text-[#1A1A1A]">Overview</h2>
      </div>

      <div class="bg-[#FCECE8] border border-[#F5D6CE]/40 rounded-3xl p-8 sm:p-10 shadow-sm space-y-4">
        <h3 class="font-serif text-2xl sm:text-3xl font-normal text-[#1A1A1A]">
          {currentInfo.subtitle}
        </h3>
        <p class="text-[15px] sm:text-base leading-relaxed text-gray-700 font-normal">
          {currentInfo.overview}
        </p>
      </div>
    </div>

    <aside class="h-fit space-y-5 rounded-lg border border-border bg-white p-7">
      <div class="flex items-center justify-between border-b border-border pb-3">
        <span class="text-xs uppercase tracking-wide text-muted-foreground">Location</span>
        <span class="font-medium">{project.location}</span>
      </div>
      {project.units && (
        <div class="flex items-center justify-between border-b border-border pb-3">
          <span class="text-xs uppercase tracking-wide text-muted-foreground">Configuration</span>
          <span class="font-medium">{project.units}</span>
        </div>
      )}
      <div class="flex items-center justify-between border-b border-border pb-3">
        <span class="text-xs uppercase tracking-wide text-muted-foreground">Year</span>
        <span class="font-medium">{project.year}</span>
      </div>
      <div class="flex items-center justify-between">
        <span class="text-xs uppercase tracking-wide text-muted-foreground">Status</span>
        <span class="font-medium">{project.status}</span>
      </div>
      
      
      <a href="/contact" class="mt-2 flex items-center justify-center gap-2 rounded-sm bg-primary px-6 py-3 text-[13px] font-medium uppercase tracking-wide text-primary-foreground hover:bg-clay-hover">
        Project Area
      </a>
    </aside>
  </section>

  <section class="py-20 px-6 max-w-[1440px] mx-auto font-sans">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Column: Location & Neighborhood Details -->
      <div class="lg:col-span-5 space-y-8">
        <div>
          <h3 class="text-xs font-bold uppercase tracking-widest text-[#C23B22] mb-2">The Address</h3>
          <h2 class="font-serif text-4xl sm:text-5xl font-normal text-[#1A1A1A]">{currentInfo.mapTitle}</h2>
        </div>

        <p class="text-gray-600 text-base leading-relaxed">
          {currentInfo.mapDesc}
        </p>

        <div class="flex items-center justify-between border-t border-gray-200 pt-6">
          <span class="text-xs uppercase tracking-wide text-gray-400 font-semibold">Location</span>
          <span class="font-bold text-[#1A1A1A] text-sm">{currentInfo.mapQueryName}</span>
        </div>
      </div>

      <!-- Right Column: Embedded Google Map Card -->
      <div class="lg:col-span-7">
        <div class="bg-white border border-gray-200 rounded-3xl p-3 shadow-sm overflow-hidden relative">
          <div class="w-full h-[450px] sm:h-[500px] rounded-2xl overflow-hidden bg-gray-100">
            <iframe 
              src={currentInfo.mapSrc} 
              width="100%" 
              height="100%" 
              style="border:0;" 
              allowfullscreen="" 
              loading="lazy" 
              referrerpolicy="no-referrer-when-downgrade"
              class="w-full h-full grayscale-[20%] contrast-[105%]"
            ></iframe>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Scrollable Dynamic Gallery Section -->
  <section class="py-20 px-6 font-sans overflow-hidden max-w-[1440px] mx-auto">
    <div class="space-y-8">
      <div class="flex items-end justify-between">
        <div>
          <h3 class="text-xs font-bold uppercase tracking-widest text-[#C23B22] mb-2">Visual Showcase</h3>
          <h2 class="font-serif text-3xl sm:text-4xl text-[#1A1A1A]">Project Gallery</h2>
        </div>

        <div class="hidden sm:flex gap-3">
          <button 
            id="scroll-left" 
            aria-label="Scroll left"
            class="h-12 w-12 rounded-full border border-gray-200 bg-white hover:bg-gray-50 flex items-center justify-center transition-colors shadow-sm text-gray-700"
          >
            ←
          </button>
          <button 
            id="scroll-right" 
            aria-label="Scroll right"
            class="h-12 w-12 rounded-full border border-gray-200 bg-white hover:bg-gray-50 flex items-center justify-center transition-colors shadow-sm text-gray-700"
          >
            →
          </button>
        </div>
      </div>

      <div 
        id="gallery-container" 
        class="flex gap-6 overflow-x-auto scroll-smooth no-scrollbar pb-6 pt-2"
        style="scrollbar-width: none; -ms-overflow-style: none;"
      >
        {currentInfo.galleryImages.map((img) => (
          <div class="min-w-[300px] sm:min-w-[420px] lg:min-w-[480px] flex-shrink-0 group">
            <div class="relative overflow-hidden rounded-3xl aspect-[4/3] bg-gray-100 shadow-sm mb-4">
              <img 
                src={img.src} 
                alt={img.alt} 
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            </div>
            
            {img.title && (
              <div class="flex items-center justify-between px-1">
                <h4 class="font-bold text-[#1A1A1A] text-base">{img.title}</h4>
                {img.subtitle && (
                  <span class="text-xs font-medium tracking-wide text-gray-500 uppercase">{img.subtitle}</span>
                )}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1400px] px-5 pb-24 md:px-10">
    <h2 class="font-display text-3xl">More Projects</h2>
    <div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {related.map((p, i) => <ProjectCard project={p} seed={i + 5} />)}
    </div>
  </section>

  <CtaBanner seed={seed + 3} />
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('gallery-container');
    const btnLeft = document.getElementById('scroll-left');
    const btnRight = document.getElementById('scroll-right');

    if (!container || !btnLeft || !btnRight) return;

    const scrollAmount = 500;

    btnLeft.addEventListener('click', () => {
      container.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
    });

    btnRight.addEventListener('click', () => {
      container.scrollBy({ left: scrollAmount, behavior: 'smooth' });
    });
  });
</script>