---
export const prerender = true;

import BaseLayout from "@/layouts/BaseLayout.astro";
import ArtPanel from "@/components/ArtPanel.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import ProjectContactForm from "@/components/sections/ProjectContactForm.astro";
import { Icon } from "@/components/Icon";
import { projects, type Project } from "@/lib/site-data";
import { Faq } from "@/components/Faq";
import { EnquiryForm } from "@/components/EnquiryForm";
import { Badge } from "@/components/ui/badge";
import ChinmayaGallery from "./[slug]/chinmaya_gallery.astro";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}


interface Props {
  project: Project;
}


const { project } = Astro.props;
const related = projects.filter((p) => p.slug !== project.slug).slice(0, 3);
const seed = projects.findIndex((p) => p.slug === project.slug) + 2;
const updates = project?.updates ?? [];

// Fallback values if specific fields are missing

const allUpdateImages = project.updates?.flatMap((update) => 
  update.images.map((imgSrc, imgIndex) => ({
    src: imgSrc,
    alt: `${update.title} - Image ${imgIndex + 1}`,
    title: update.title,
    subtitle: `Photo ${imgIndex + 1}`
  }))
) ?? [];
const subtitle = project.subtitle || project.tagline;
const mapTitle = project.mapTitle || project.location;
const mapDesc = project.mapDesc || "A prime location offering optimal accessibility and neighborhood amenities.";
const mapSrc = project.mapSrc || "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3889.3564993883187!2d74.8485!3d12.8647!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3ba35c0245645679%3A0x629c12345678abcd!2sMangaluru%2C%20Karnataka!5e0!3m2!1sen!2sin!4v1710000000000!5m2!1sen!2sin";
const mapQueryName = project.mapQueryName || project.location;
const galleryImages = project.galleryImages || [];
const updateImages = project.updates ? project.updates.flatMap(u => u.images) : [];

// Determines if we should show the rich detailed view
const isRich = !!project.reraNo;
---

<BaseLayout title={project.name} description={`${project.tagline} — ${project.name} by Udbhav Developers in ${project.location}.`}>
  
  {isRich ? (
    <>
      <!-- Rich Hero Section -->
      <section class="relative bg-ink text-cream pt-24 pb-48 md:pt-32 md:pb-64">
        <div class="absolute inset-0 overflow-hidden z-0">
          {galleryImages.length > 0 ? (
             <div class="absolute inset-0 opacity-40 mix-blend-overlay">
               <img src={galleryImages[0].src} alt="" class="w-full h-full object-cover" />
             </div>
          ) : (
             <ArtPanel seed={seed} tone="ink" class="absolute inset-0" />
          )}
        </div>
        
        <div class="relative mx-auto max-w-[1400px] px-5 flex flex-col items-center text-center z-10">
          <h1 class="font-display text-5xl md:text-7xl leading-tight mb-2">{project.name}</h1>
          <p class="text-xl md:text-3xl font-display mb-4 text-cream/90">{project.subtitle}</p>
          
          <div class="flex flex-wrap justify-center gap-2 text-sm font-medium tracking-wide text-cream/70 mb-8">
             <a href="/" class="hover:text-cream transition-colors">Home</a>
             <span>/</span>
             <a href="/portfolio" class="hover:text-cream transition-colors">Project</a>
             <span>/</span>
             <span class="text-clay">{project.name}</span>
          </div>
          
          <div class="flex flex-col sm:flex-row gap-4 mb-4">
             <a href="#enquire" class="inline-flex h-12 items-center justify-center rounded bg-clay px-8 text-sm font-medium text-cream hover:bg-clay-hover transition-colors shadow-lg hover:-translate-y-0.5 duration-300">
               Enquiry Now
             </a>
             <a href="#360" class="inline-flex h-12 items-center justify-center rounded bg-clay px-8 text-sm font-medium text-cream hover:bg-clay-hover transition-colors shadow-lg hover:-translate-y-0.5 duration-300">
               View 360° Virtual Work
             </a>
          </div>
          {project.brochureUrl && (
             <a href={project.brochureUrl} target="_blank" class="w-full sm:w-auto inline-flex h-12 items-center justify-center rounded-sm bg-[#f2ebd9] border-l-4 border-yellow-500 px-12 text-sm font-medium text-ink transition-colors shadow-lg relative overflow-hidden group">
               <span class="absolute inset-0 bg-yellow-500 origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-500 ease-out z-0"></span>
               <span class="relative z-10 flex items-center">
                 <Icon name="download" className="w-4 h-4 mr-2 text-ink/70 group-hover:text-ink transition-colors" /> Download Brochure
               </span>
             </a>
          )}
        </div>

        <!-- 5 Floating Info Cards -->
        <div class="relative md:absolute md:bottom-0 left-0 w-full md:translate-y-1/2 px-5 z-20 mt-12 md:mt-0">
          <div class="mx-auto max-w-[1200px] grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 gap-4">
             <div class="bg-white rounded-xl shadow-lg border border-border p-6 text-center text-ink flex flex-col items-center gap-3 hover:-translate-y-1 transition-transform duration-500">
                <Icon name="tag" className="w-8 h-8 text-yellow-500" />
                <h4 class="font-display text-sm md:text-base leading-tight">Starting Price</h4>
                <p class="text-[10px] md:text-xs text-muted-foreground leading-relaxed">Apartments start from {project.price}. This gives you a clear entry point while allowing choice across configurations.</p>
             </div>
             <div class="bg-white rounded-xl shadow-lg border border-border p-6 text-center text-ink flex flex-col items-center gap-3 hover:-translate-y-1 transition-transform duration-500">
                <Icon name="calendar-check" className="w-8 h-8 text-blue-500" />
                <h4 class="font-display text-sm md:text-base leading-tight">Easy Booking</h4>
                <p class="text-[10px] md:text-xs text-muted-foreground leading-relaxed">Our easy booking process is designed to give you complete transparency and expert guidance.</p>
             </div>
             <div class="bg-white rounded-xl shadow-lg border border-border p-6 text-center text-ink flex flex-col items-center gap-3 hover:-translate-y-1 transition-transform duration-500">
                <Icon name="file-text" className="w-8 h-8 text-green-500" />
                <h4 class="font-display text-sm md:text-base leading-tight">Agreement Payment</h4>
                <p class="text-[10px] md:text-xs text-muted-foreground leading-relaxed">25% payable at the time of agreement This includes the booking amount and confirms your purchase legally.</p>
             </div>
             <div class="bg-white rounded-xl shadow-lg border border-border p-6 text-center text-ink flex flex-col items-center gap-3 hover:-translate-y-1 transition-transform duration-500">
                <Icon name="bar-chart" className="w-8 h-8 text-orange-500" />
                <h4 class="font-display text-sm md:text-base leading-tight">Construction-Linked Flexible Payments</h4>
                <p class="text-[10px] md:text-xs text-muted-foreground leading-relaxed">You pay in stages as the project develops, instead of a heavy upfront commitment.</p>
             </div>
             <div class="bg-white rounded-xl shadow-lg p-6 flex flex-col items-center text-center border-t-4 border-yellow-500 hover:-translate-y-1 transition-transform duration-300">
               <img src="/images/udbahv-chinmaya/home-loan.png" alt="Home Loan" class="w-10 h-10 object-contain mb-3" />
               <h4 class="font-bold text-ink text-sm mb-2">Home Loan Assistance</h4>
               <p class="text-[10px] text-muted-foreground leading-tight">Loan facility available from all major banks such as Karnataka Bank, Canara Bank & SBI Bank. Smooth loan processing, Competitive interest rates and Easy EMIs.</p>
             </div>
          </div>
        </div>
      </section>
      
      <!-- Main Content Container -->
      <section class="mx-auto max-w-[1300px] px-5 py-16 md:py-24 mt-8">
        
        <!-- Our Partners (Full Width) -->
        <div class="mb-16">
  <h3 class="font-display text-3xl text-ink mb-8 flex items-center">
    Our Partners
    <span class="w-1.5 h-1.5 rounded-full bg-yellow-500 ml-2 mt-2"></span>
  </h3>

  <div class="relative overflow-hidden group">
    <!-- Fade edges -->
    <div class="pointer-events-none absolute inset-y-0 left-0 w-16 bg-gradient-to-r from-white to-transparent z-10"></div>
    <div class="pointer-events-none absolute inset-y-0 right-0 w-16 bg-gradient-to-l from-white to-transparent z-10"></div>

    <div class="flex w-max animate-marquee group-hover:[animation-play-state:paused]">
      <!-- Set 1 -->
      <div class="flex items-center shrink-0">
        <img src="/images/udbahv-chinmaya/canara-bank.png" alt="Canara Bank" class="h-20 w-auto object-contain mix-blend-darken mx-12" />
        <img src="/images/udbahv-chinmaya/sb-bank.png" alt="State Bank of India" class="h-20 w-auto object-contain mix-blend-darken mx-12" />
        <img src="/images/udbahv-chinmaya/kbank.png" alt="Karnataka Bank" class="h-20 w-auto object-contain mix-blend-darken mx-12" />
      </div>
      <!-- Set 2 (duplicate, aria-hidden for a11y) -->
      <div class="flex items-center shrink-0" aria-hidden="true">
        <img src="/images/udbahv-chinmaya/canara-bank.png" alt="" class="h-20 w-auto object-contain mix-blend-darken mx-12" />
        <img src="/images/udbahv-chinmaya/sb-bank.png" alt="" class="h-20 w-auto object-contain mix-blend-darken mx-12" />
        <img src="/images/udbahv-chinmaya/kbank.png" alt="" class="h-20 w-auto object-contain mix-blend-darken mx-12" />
      </div>
    </div>
  </div>
</div>

        <!-- Two Column Layout -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
          
          <!-- Left Column -->
          <div class="lg:col-span-7 space-y-16">
           
           <!-- Video & Description -->
           <div class="space-y-8">
             <div class="aspect-video w-full rounded-2xl overflow-hidden bg-ink/5 border border-border relative group shadow-sm hover:shadow-md transition-all duration-500">
               {project.videoUrl ? (
                  <iframe 
                    width="100%" 
                    height="100%" 
                    src={project.videoUrl} 
                    title="Project Video" 
                    frameborder="0" 
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                    referrerpolicy="strict-origin-when-cross-origin" 
                    allowfullscreen
                    class="w-full h-full"
                  ></iframe>
               ) : galleryImages.length > 0 ? (
                  <>
                    <img src={galleryImages[0].src} alt="Project Video" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                    <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                      <div class="w-16 h-16 rounded-full bg-clay text-cream flex items-center justify-center group-hover:scale-110 transition-transform shadow-lg">
                         <Icon name="play" className="w-6 h-6 ml-1" />
                      </div>
                    </div>
                  </>
               ) : (
                  <div class="w-full h-full flex items-center justify-center text-muted-foreground">No media</div>
               )}
             </div>
             
             <div class="prose prose-ink max-w-none text-muted-foreground leading-relaxed">
               <p>{project.description}</p>
               <p>With only {project.totalUnits} exclusive apartments, {project.name} ensures privacy, comfort, and a refined living experience in a prime urban location. <a href="/images/udbahv-chinmaya/RERACERT.pdf" target="_blank" class="text-clay font-bold hover:underline">View RERA Certificate Here.</a></p>
             </div>
           </div>

           <!-- Why Choose Us -->
           {project.whyChooseUs && (
             <div class="space-y-6">
               <h2 class="font-display text-3xl text-ink">Why Choose {project.name}?</h2>
               <div class="prose prose-ink max-w-none text-muted-foreground leading-relaxed">
                 <p>Finding a home in the city often means compromising — either on space, peace, or connectivity. {project.name} eliminates that compromise.</p>
                 <p>{project.whyChooseUs}</p>
                 <p>Thoughtfully planned layouts, premium fittings, advanced security systems, and lifestyle amenities come together to deliver a living experience that feels complete in every way.</p>
               </div>
             </div>
           )}

           <!-- How We Help -->
           <div>
             <h2 class="font-display text-3xl text-ink mb-8">How We Help</h2>
             <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                <div class="bg-white rounded-2xl border border-border p-6 text-center shadow-sm hover:-translate-y-1 hover:shadow-md transition-all duration-500">
                   <img src="/images/udbahv-chinmaya/property-selection.png" alt="Property Selection" class="w-12 h-12 mx-auto mb-4 object-contain" />
                   <h4 class="font-bold text-sm text-clay mb-2">Property Selection</h4>
                   <p class="text-[11px] text-muted-foreground leading-relaxed">We assist you in identifying properties that perfectly align with your investment goals and personal preferences. Our team offers comprehensive information, virtual tours, and personalized support to ensure you make a confident and informed decision.</p>
                </div>
                <div class="bg-white rounded-2xl border border-border p-6 text-center shadow-sm hover:-translate-y-1 hover:shadow-md transition-all duration-500">
                   <img src="/images/udbahv-chinmaya/legal-finance-assistance.png" alt="Legal and Financial Assistance" class="w-12 h-12 mx-auto mb-4 object-contain" />
                   <h4 class="font-bold text-sm text-clay mb-2">Legal and Financial Assistance</h4>
                   <p class="text-[11px] text-muted-foreground leading-relaxed">Our experts provide comprehensive guidance on the legal and financial aspects of property investment, ensuring full compliance with regulations and facilitating smooth, hassle-free transactions.</p>
                </div>
                <div class="bg-white rounded-2xl border border-border p-6 text-center shadow-sm hover:-translate-y-1 hover:shadow-md transition-all duration-500">
                   <img src="/images/udbahv-chinmaya/post-purchase.png" alt="Post-Purchase Support" class="w-12 h-12 mx-auto mb-4 object-contain" />
                   <h4 class="font-bold text-sm text-clay mb-2">Post-Purchase Support</h4>
                   <p class="text-[11px] text-muted-foreground leading-relaxed">Our commitment to you goes beyond the purchase. We provide comprehensive post-purchase support, including property management, rental assistance, and resale services, ensuring your investment remains valuable, well-maintained, and rewarding.</p>
                </div>
             </div>
           </div>

           <!-- Apartment Configuration -->
           <div>
             <h2 class="font-display text-3xl text-ink mb-1 inline-block">Apartment Configuration</h2>
             <div class="h-1 w-24 bg-yellow-400 mb-8 mt-2"></div>
             
             <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
                <div class="bg-white rounded-2xl border border-border p-6 text-center shadow-sm hover:shadow-md transition-shadow flex flex-col items-center justify-center gap-3 h-32">
                   <img src="/images/udbahv-chinmaya/property-selection.png" alt="Configuration" class="w-10 h-10 object-contain" />
                   <h4 class="font-bold text-xs text-clay">{project.configurations}</h4>
                </div>
                <div class="bg-white rounded-2xl border border-border p-6 text-center shadow-sm hover:shadow-md transition-shadow flex flex-col items-center justify-center gap-3 h-32">
                   <img src="/images/udbahv-chinmaya/property-selection.png" alt="Total Units" class="w-10 h-10 object-contain" />
                   <h4 class="font-bold text-xs text-clay">Total Units: {project.totalUnits}</h4>
                </div>
                <div class="bg-white rounded-2xl border border-border p-6 text-center shadow-sm hover:shadow-md transition-shadow flex flex-col items-center justify-center gap-3 h-32">
                   <img src="/images/udbahv-chinmaya/gound-structure.png" alt="Structure" class="w-10 h-10 object-contain" />
                   <h4 class="font-bold text-xs text-clay">Structure: Ground + 5 Floors</h4>
                </div>
                <div class="bg-white rounded-2xl border border-border p-6 text-center shadow-sm hover:shadow-md transition-shadow flex flex-col items-center justify-center gap-3 h-32">
                   <img src="/images/udbahv-chinmaya/project-area.png" alt="Project Area" class="w-10 h-10 object-contain" />
                   <h4 class="font-bold text-xs text-clay">Project Area: {project.developmentSize}</h4>
                </div>
                <div class="bg-white rounded-2xl border border-border p-6 text-center shadow-sm hover:shadow-md transition-shadow flex flex-col items-center justify-center gap-3 h-32">
                   <img src="/images/udbahv-chinmaya/post-purchase.png" alt="Possession" class="w-10 h-10 object-contain" />
                   <h4 class="font-bold text-xs text-clay">Possession: {project.completionDate}</h4>
                </div>
                <div class="bg-white rounded-2xl border border-border p-6 text-center shadow-sm hover:shadow-md transition-shadow flex flex-col items-center justify-center gap-3 h-32">
                   <img src="/images/udbahv-chinmaya/gound-structure.png" alt="Price" class="w-10 h-10 object-contain" />
                   <h4 class="font-bold text-xs text-clay">Starts From {project.price}</h4>
                </div>
             </div>
           </div>

           <!-- Plans -->
           {project.floorPlans && project.floorPlans.length > 0 && (
             <div>
               <h2 class="font-display text-3xl text-ink mb-6">Plans</h2>
               
               <div class="flex items-center justify-between mb-8">
                 <div class="flex flex-wrap gap-3 filter-buttons">
                    <button data-filter="3BHK" class="filter-btn px-6 py-2 rounded bg-clay text-cream font-medium text-sm transition-colors">3 Bhk</button>
                    <button data-filter="4BHK" class="filter-btn px-6 py-2 rounded bg-ink/5 text-ink font-medium text-sm">4 Bhk</button>
                    <button data-filter="Master Plan" class="filter-btn px-6 py-2 rounded bg-ink/5 text-ink font-medium text-sm">Master Plan</button>
                 </div>
                 <!-- Desktop Controls -->
                 <div class="hidden sm:flex gap-3 plans-controls-container" data-desktop="true">
                    <button class="plans-scroll-left h-10 w-10 rounded-full border border-border bg-white hover:bg-muted flex items-center justify-center transition-colors shadow-sm text-ink">
                      ←
                    </button>
                    <button class="plans-scroll-right h-10 w-10 rounded-full border border-border bg-white hover:bg-muted flex items-center justify-center transition-colors shadow-sm text-ink">
                      →
                    </button>
                 </div>
               </div>

               <div class="relative">
                 <div id="plans-container" class="flex gap-6 overflow-x-auto scroll-smooth pb-8 pt-2 select-none [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden snap-x snap-mandatory">
                   {project.floorPlans.map(plan => (
                     <div data-category={plan.category || '3BHK'} class="plan-card snap-start w-full sm:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)] flex-shrink-0 bg-white rounded-2xl border border-border overflow-hidden shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-500 cursor-pointer" onclick={`openLightbox('${plan.image}')`}>
                       <div class="aspect-[4/3] bg-ink/5 overflow-hidden border-b border-border p-4">
                         <img src={plan.image} alt={plan.title} class="w-full h-full object-contain transition-transform duration-700 hover:scale-105" loading="lazy" />
                       </div>
                       <div class="p-4 text-center bg-white">
                         <h4 class="font-display text-sm font-bold text-ink">{plan.title}</h4>
                       </div>
                     </div>
                   ))}
                 </div>
                 
                 <!-- Edge gradient overlays -->
                 <div id="plans-overlay-left" class="pointer-events-none absolute left-0 top-0 bottom-8 w-12 sm:w-24 bg-gradient-to-r from-[var(--color-background)] to-transparent z-10"></div>
                 <div id="plans-overlay-right" class="pointer-events-none absolute right-0 top-0 bottom-8 w-12 sm:w-24 bg-gradient-to-l from-[var(--color-background)] to-transparent z-10"></div>
               </div>

               <!-- Mobile Controls -->
               <div class="flex sm:hidden justify-center gap-4 mt-6 plans-controls-container" data-mobile="true">
                  <button class="plans-scroll-left h-12 w-12 rounded-full border border-border bg-white hover:bg-muted flex items-center justify-center transition-colors shadow-sm text-ink">
                    ←
                  </button>
                  <button class="plans-scroll-right h-12 w-12 rounded-full border border-border bg-white hover:bg-muted flex items-center justify-center transition-colors shadow-sm text-ink">
                    →
                  </button>
               </div>
             </div>
           )}

            <!-- Special Amenities -->
            {project.amenities && project.amenities.length > 0 && (
              <div class="space-y-6 pt-12">
                <h2 class="font-display text-4xl text-ink text-center mb-10">Special Amenities</h2>
                
                <div class="relative overflow-hidden group shadow-md bg-ink rounded-xl">
                  <div id="amenities-carousel" class="flex transition-transform duration-500 ease-out h-[300px] md:h-[400px]">
                    {project.amenities.map((amenity, idx) => (
                      <div class="w-full flex-shrink-0 relative h-full">
                        <img src={amenity.image} alt={amenity.title} class="w-full h-full object-cover opacity-80" />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent flex items-end justify-center pb-16">
                          <h3 class="text-white font-bold text-2xl md:text-4xl">{amenity.title}</h3>
                        </div>
                      </div>
                    ))}
                  </div>
                  
                  <!-- Navigation -->
                  <button id="amenity-prev" class="absolute left-6 top-1/2 -translate-y-1/2 text-white/70 hover:text-white transition-colors outline-none focus:outline-none" aria-label="Previous Amenity">
                    <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                  </button>
                  <button id="amenity-next" class="absolute right-6 top-1/2 -translate-y-1/2 text-white/70 hover:text-white transition-colors outline-none focus:outline-none" aria-label="Next Amenity">
                    <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                  </button>
                  
                  <!-- Indicators -->
                  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex gap-2">
                    {project.amenities.map((_, idx) => (
                      <button class={`amenity-dot w-2 h-2 rounded-full transition-colors ${idx === 0 ? 'bg-white' : 'bg-white/40'}`} data-index={idx} aria-label={`Go to slide ${idx + 1}`}></button>
                    ))}
                  </div>
                </div>
                
                <div class="text-center pt-8">
                  <a href="#enquire" class="inline-flex h-12 items-center justify-center rounded bg-[#c32828] px-8 text-sm font-bold text-white shadow hover:bg-[#a02020] transition-colors">
                    Ask For More Information
                  </a>
                </div>
              </div>
            )}

            <!-- Specifications -->
            {project.specifications && project.specifications.length > 0 && (
              <div class="space-y-10 pt-16">
                <h2 class="font-display text-4xl text-ink text-center">High-End Specifications & Smart Features</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-6" id="specs-list">
                  {project.specifications.map((spec, idx) => (
                    <div class={`flex items-start gap-4 border-b border-border pb-4 spec-item ${idx >= 8 ? 'hidden spec-item-extra' : ''}`}>
                      <div class="mt-1 flex-shrink-0 text-[#c32828] bg-[#c32828]/10 p-1 rounded-full">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
                          <path fill-rule="evenodd" d="M19.916 4.626a.75.75 0 01.208 1.04l-9 13.5a.75.75 0 01-1.154.114l-6-6a.75.75 0 011.06-1.06l5.353 5.353 8.493-12.739a.75.75 0 011.04-.208z" clip-rule="evenodd" />
                        </svg>
                      </div>
                      <p class="text-sm text-ink leading-relaxed">{spec}</p>
                    </div>
                  ))}
                </div>
                {project.specifications.length > 8 && (
                   <div class="text-center pt-2">
                     <button id="view-more-specs" class="text-[#c32828] font-bold text-sm hover:underline inline-flex items-center justify-center gap-1">
                       View More
