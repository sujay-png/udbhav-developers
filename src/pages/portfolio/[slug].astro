      { src: "https://udbhavdevelopers.com/wp-content/uploads/2025/07/DSC_5471-min.jpg", alt: "Udbhav Shanthi Amenities", title: "Amenities", subtitle: "Ground-floor Retail" },
      { src: "https://udbhavdevelopers.com/wp-content/uploads/2025/07/DSC_5483-min.jpg", alt: "Udbhav Shanthi Common Area", title: "Common Area", subtitle: "Kadri, Mangalore" },
