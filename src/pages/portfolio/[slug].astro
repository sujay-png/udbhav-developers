      { src: "https://udbhavdevelopers.com/wp-content/uploads/2025/07/NBP_5593.jpg", alt: "Marcel's Maison View", title: "Building View", subtitle: "Valencia, Mangalore" },
      { src: "https://udbhavdevelopers.com/wp-content/uploads/2025/07/NBP_5602.jpg", alt: "Marcel's Maison Detail", title: "Architectural Detail", subtitle: "Premium Finish" }
