    mapQueryName: "Kadri, Mangaluru",
    galleryImages: [
      { src: "/images/projects/chinmaya.jpg", alt: "Udbhav Chinmaya Exterior", title: "Udbhav Chinmaya", subtitle: "Kadri, Mangalore" },
