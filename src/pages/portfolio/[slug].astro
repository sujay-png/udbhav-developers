      { src: "https://udbhavdevelopers.com/wp-content/uploads/2025/07/DSC_5510-min.jpg", alt: "Udbhav Shanthi View", title: "Building View", subtitle: "Kadri, Mangalore" },
      { src: "https://udbhavdevelopers.com/wp-content/uploads/2025/07/udbhav-image.jpg", alt: "Udbhav Shanthi Exterior", title: "Exterior", subtitle: "Kadri, Mangalore" },
    ]
  
  },
  "marcels-maison": {
    subtitle: "Contemporary Mixed-Use Living",
    overview: "Udbhav Developers presents Marcel's Maison, a mixed-use project located in the premium address of Valencia, one of Mangaluru's most sought-after neighbourhoods. Sitting in the heart of the city with strong connectivity to places of worship, shopping, education, hospitals, and entertainment, the project pairs contemporary architecture with modern amenities. Whether commercial space or residential apartment, every unit carries the same premium finish.",
    mapTitle: "Valencia",
    mapDesc: "Valencia has grown into a premium part of Mangaluru over the last decade, offering residents and businesses an unmatched geographic advantage in the heart of the city.",
