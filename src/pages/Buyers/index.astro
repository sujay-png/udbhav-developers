---
// src/pages/buyers-guide.astro
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArtPanel from "@/components/ArtPanel.astro";
import CtaBanner from "@/components/sections/CtaBanner.astro";
import { Icon as IconBase } from "@/components/Icon";
const Icon = IconBase as any;

// Content paraphrased and restructured from udbhavdevelopers.com/buyers-guide/
const tabs = [
  { id: "checklist", label: "Booking Checklist" },
  { id: "loan", label: "Loan Enquiry" },
  { id: "nri", label: "NRI Corner" },
  { id: "emi", label: "EMI Calculator" },
  { id: "general", label: "General Guide" },
];

const bookingDocs = {
  resident: [
    "Self-attested copy of PAN card",
    "Self-attested residence proof — Driver's Licence, Ration Card, Passport, Voter ID, or Aadhaar",
    "Passport-size photographs, one set per applicant",
    "A cheque book for the payment account",
  ],
  nri: [
    "Copy of passport, or PIO card for Persons of Indian Origin",
    "Two passport-size photographs per applicant",
    "All cheque payments must be drawn on the applicant's NRE, NRO, or FCNR account, or sent via foreign remittance",
  ],
};

const loanFaqs = [
  { q: "Who is eligible for a home loan?", a: "In general, applicants must be at least 21 years old and show a regular income, whether salaried or self-employed." },
  { q: "When can I apply, and what are the stages?", a: "You can apply before you've even chosen a property — an in-principle approval helps you set a budget in advance. From there, a loan moves through two stages: sanction, where the amount is approved, and disbursement, released in step with construction progress." },
  { q: "Who can be a co-applicant?", a: "Every co-owner of the property must also be a co-applicant on the loan, though the reverse isn't true — a co-applicant doesn't need to hold ownership." },
  { q: "What's the difference between EMI and Pre-EMI?", a: "An EMI (Equated Monthly Installment) blends a principal and an interest component into one fixed monthly payment. Pre-EMI applies before the full loan is disbursed — you pay interest only on the portion released so far." },
];

const whyInvest = [
  { title: "Trust & Reliability", body: "Over a decade in Mangaluru real estate has built a reputation for quality, follow-through, and customer care." },
  { title: "Premium Properties", body: "A portfolio of residential and commercial addresses in prime locations, designed to a consistently high standard." },
  { title: "Hassle-Free Transactions", body: "Support across every stage — selection, documentation, financing, and after-sales — for a smoother purchase." },
  { title: "Transparent Practices", body: "Every transaction is conducted openly, so buyers have what they need to decide with confidence." },
];

const investmentTypes = [
  { title: "Residential Projects", body: "Homes designed for comfort and community, blending contemporary architecture with everyday convenience." },
  { title: "Commercial Projects", body: "Strategically located spaces built for modern businesses, from retail counters to full offices." },
];

const nriGuidelines = [
  { title: "Eligibility", body: "NRIs, OCIs, and PIOs can buy both residential and commercial property in India under current regulations." },
  { title: "Repatriation of Funds", body: "Sale proceeds can generally be repatriated, subject to RBI conditions on amount, property type, and proof of the original overseas investment." },
  { title: "Documentation", body: "Repatriation requires evidence that the original purchase was funded through proper banking channels from abroad, along with proof of the sale itself." },
];

const howWeHelp = [
  { title: "Property Selection", body: "Guidance matched to your goals, with detailed information and virtual tours so you can decide with confidence from anywhere." },
  { title: "Legal & Financial", body: "Support navigating compliance and paperwork, so the transaction stays smooth end to end." },
  { title: "Post-Purchase Support", body: "Help continues after handover — property management, rental assistance, and resale support when you need it." },
];

const generalFaqs = [
  { q: "What should I verify before buying a property?", a: "Check the approved layout and building plan, run a title search through a qualified advocate, and confirm ownership documents, environmental clearance, and the commencement certificate." },
  { q: "What's the difference between carpet, built-up, and super built-up area?", a: "Carpet area excludes wall thickness. Built-up area includes it. Super built-up area adds a share of common spaces — lobbies, lifts, stairwells — and applies mainly to multi-unit developments." },
  { q: "Who pays stamp duty, and whose name goes on the stamps?", a: "The buyer is liable unless the agreement states otherwise, and the stamps are purchased in the name of one of the parties to the document." },
  { q: "Is stamp duty based on the agreement value or market value?", a: "Whichever is higher. Market value is what the property would fetch in an open-market sale on the date the document is executed." },
];
--- 

<BaseLayout title="Buyer's Guide" description="Everything you need before buying a home in Mangaluru from Udbhav Developers.">
  
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-[#121417] text-white">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-[#B02317]/20 via-[#121417] to-[#121417] opacity-60"></div>
    <div class="relative mx-auto max-w-7xl px-6 py-28 md:px-12 md:py-36">
      <span class="font-sans text-xs font-bold uppercase tracking-[0.35em] text-[#B02317] animate-fade-in">
        For Homebuyers
      </span>
      <h1 class="mt-6 max-w-2xl font-serif text-5xl font-medium leading-[1.1] md:text-7xl animate-fade-in-up">
        Buyer's Guide
      </h1>
      <p class="mt-6 max-w-xl font-sans text-lg font-light leading-relaxed text-gray-300 animate-fade-in-up" style="animation-delay: 100ms;">
        Booking paperwork, loan eligibility, NRI investment rules, and the fine print on stamp duty —
        laid out in one place so nothing catches you by surprise.
      </p>
    </div>
  </section>

  <!-- Tab Navigation -->
  <nav class="sticky top-0 z-30 border-b border-gray-200 bg-white/90 backdrop-blur-md transition-all duration-300">
    <div class="mx-auto flex max-w-7xl gap-8 overflow-x-auto px-6 md:px-12 hide-scrollbar" id="guide-tabs">
      {tabs.map((tab, i) => (
        <button
          type="button"
          data-tab={tab.id}
          class:list={[
            "guide-tab relative shrink-0 whitespace-nowrap py-6 font-sans text-sm font-medium uppercase tracking-widest transition-colors duration-300 hover:text-[#B02317]",
            i === 0 ? "text-[#B02317]" : "text-[#88726F]"
          ]}
        >
          {tab.label}
          <span class:list={[
            "absolute bottom-0 left-0 h-0.5 w-full bg-[#B02317] transition-transform duration-300",
            i === 0 ? "scale-x-100" : "scale-x-0"
          ]}></span>
        </button>
      ))}
    </div>
  </nav>

  <div class="mx-auto max-w-7xl px-6 py-20 md:px-12 md:py-28 font-sans bg-white min-h-[60vh]">

    <!-- Panel: Booking Checklist -->
    <section data-panel="checklist" class="guide-panel fade-in-panel space-y-12">
      <div class="max-w-2xl">
        <h3 class="font-sans text-xs font-bold uppercase tracking-[0.35em] text-[#B02317] mb-4">Before You Book</h3>
        <h2 class="font-serif text-4xl sm:text-5xl font-medium text-[#121417]">Documents you'll need</h2>
      </div>
      <div class="grid gap-8 lg:grid-cols-2">
        <div class="group rounded-[32px] bg-[#FDF9F7] p-10 transition-all duration-500 hover:shadow-xl border border-transparent hover:border-[#B02317]/10">
          <h4 class="font-serif text-2xl font-medium text-[#121417] mb-6">Resident of India</h4>
          <ul class="space-y-4">
            {bookingDocs.resident.map((doc) => (
              <li class="flex items-start gap-4 text-base leading-relaxed text-[#88726F]">
                <div class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#B02317]/10 text-[#B02317] transition-colors group-hover:bg-[#B02317] group-hover:text-white">
                  <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                </div>
                <span>{doc}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="group rounded-[32px] bg-white border border-gray-100 p-10 transition-all duration-500 hover:shadow-xl hover:border-[#B02317]/10">
          <h4 class="font-serif text-2xl font-medium text-[#121417] mb-6">NRI / Foreign National</h4>
          <ul class="space-y-4">
            {bookingDocs.nri.map((doc) => (
              <li class="flex items-start gap-4 text-base leading-relaxed text-[#88726F]">
                <div class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#B02317]/10 text-[#B02317] transition-colors group-hover:bg-[#B02317] group-hover:text-white">
                  <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                </div>
                <span>{doc}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Panel: Loan Enquiry & General Guide (Combined Accordion Styles) -->
    {[{id: "loan", title: "Loan enquiry", eyebrow: "Financing", data: loanFaqs}, {id: "general", title: "General guide", eyebrow: "The Fine Print", data: generalFaqs}].map(panel => (
      <section data-panel={panel.id} class="guide-panel hidden fade-in-panel space-y-12">
        <div class="max-w-2xl">
          <h3 class="font-sans text-xs font-bold uppercase tracking-[0.35em] text-[#B02317] mb-4">{panel.eyebrow}</h3>
          <h2 class="font-serif text-4xl sm:text-5xl font-medium text-[#121417]">{panel.title}</h2>
        </div>
        <div class="max-w-4xl divide-y divide-gray-100 border-y border-gray-100">
          {panel.data.map((item) => (
            <div class="accordion-item group">
              <button type="button" class="accordion-trigger flex w-full items-center justify-between gap-6 py-6 text-left transition-colors hover:text-[#B02317]">
                <span class="font-serif text-xl font-medium text-[#121417] group-hover:text-[#B02317] transition-colors">{item.q}</span>
                <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-gray-200 group-hover:border-[#B02317] transition-colors">
                  <svg class="accordion-icon h-4 w-4 text-[#121417] group-hover:text-[#B02317] transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                </div>
              </button>
              <div class="accordion-content hidden overflow-hidden transition-all duration-500">
                <p class="pb-8 pr-12 text-base leading-relaxed text-[#88726F]">
                  {item.a}
                </p>
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}

    <!-- Panel: NRI Corner -->
    <section data-panel="nri" class="guide-panel hidden fade-in-panel space-y-20">
      <!-- Why Invest -->
      <div>
        <div class="max-w-2xl mb-12">
          <h3 class="font-sans text-xs font-bold uppercase tracking-[0.35em] text-[#B02317] mb-4">NRI Corner</h3>
          <h2 class="font-serif text-4xl sm:text-5xl font-medium text-[#121417]">Why invest with Udbhav</h2>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {whyInvest.map((item) => (
            <div class="rounded-[28px] bg-[#FDF9F7] p-8 transition-all duration-300 hover:-translate-y-2 hover:shadow-xl hover:bg-white border border-transparent hover:border-[#B02317]/10">
              <h4 class="font-serif text-xl font-medium text-[#121417] mb-4">{item.title}</h4>
              <p class="text-sm leading-relaxed text-[#88726F]">{item.body}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Guidelines -->
      <div class="grid lg:grid-cols-2 gap-16 items-start">
        <div class="space-y-10">
          <h3 class="font-serif text-3xl font-medium text-[#121417]">Investment Guidelines</h3>
          <div class="space-y-8">
            {nriGuidelines.map((item) => (
              <div class="border-l-2 border-[#B02317]/20 pl-6 transition-colors hover:border-[#B02317]">
                <h4 class="font-serif text-xl font-medium text-[#B02317] mb-2">{item.title}</h4>
                <p class="text-base leading-relaxed text-[#88726F]">{item.body}</p>
              </div>
            ))}
          </div>
        </div>
        
        <div class="rounded-[32px] bg-[#121417] text-white p-10 sm:p-12 shadow-2xl relative overflow-hidden">
          <div class="absolute top-0 right-0 h-64 w-64 rounded-full bg-[#B02317]/20 blur-[80px] pointer-events-none"></div>
          <h3 class="font-serif text-3xl font-medium mb-10 relative z-10">How we help</h3>
          <div class="space-y-8 relative z-10">
            {howWeHelp.map((item) => (
              <div>
                <h4 class="font-serif text-xl font-medium text-white mb-2">{item.title}</h4>
                <p class="text-sm font-light leading-relaxed text-gray-400">{item.body}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Panel: EMI Calculator -->
    <section data-panel="emi" class="guide-panel hidden fade-in-panel space-y-12">
      <div class="max-w-2xl">
        <h3 class="font-sans text-xs font-bold uppercase tracking-[0.35em] text-[#B02317] mb-4">Plan Ahead</h3>
        <h2 class="font-serif text-4xl sm:text-5xl font-medium text-[#121417]">EMI Calculator</h2>
        <p class="mt-6 text-lg text-[#88726F]">Adjust the figures below to estimate your monthly instalment and total interest payload.</p>
      </div>

      <div class="rounded-[40px] bg-[#FDF9F7] p-8 sm:p-12 grid gap-12 lg:grid-cols-[1.2fr_0.8fr] items-center border border-gray-100 shadow-sm">
        
        <!-- Controls -->
        <div class="space-y-10 pr-0 lg:pr-8">
          {[
            { id: "emi-amount", label: "Total Loan Amount", min: 500000, max: 50000000, step: 100000, val: 5000000 },
            { id: "emi-down", label: "Down Payment", min: 0, max: 20000000, step: 50000, val: 1000000 },
            { id: "emi-rate", label: "Interest Rate (%)", min: 5, max: 15, step: 0.1, val: 8.5 },
            { id: "emi-years", label: "Loan Tenure (Years)", min: 1, max: 30, step: 1, val: 20 }
          ].map(ctrl => (
            <div class="group">
              <div class="flex items-center justify-between mb-4">
                <label for={ctrl.id} class="font-sans text-xs font-semibold uppercase tracking-widest text-[#88726F] group-hover:text-[#121417] transition-colors">{ctrl.label}</label>
                <span class="font-serif text-xl font-medium text-[#B02317]" id={`${ctrl.id}-display`}></span>
              </div>
              <input id={ctrl.id} type="range" min={ctrl.min} max={ctrl.max} step={ctrl.step} value={ctrl.val} class="emi-slider w-full" />
            </div>
          ))}
        </div>

        <!-- Output Visual -->
        <div class="rounded-[32px] bg-white p-10 shadow-xl border border-gray-100 text-center flex flex-col items-center">
          <div class="relative w-48 h-48 flex items-center justify-center mb-8">
            <svg viewBox="0 0 200 200" class="w-full h-full -rotate-90">
              <circle cx="100" cy="100" r="80" fill="none" stroke="#FDF9F7" stroke-width="16" />
              <circle id="emi-donut" cx="100" cy="100" r="80" fill="none" stroke="#B02317" stroke-width="16"
                stroke-dasharray="0 502" stroke-linecap="round" class="transition-all duration-700 ease-out" />
            </svg>
            <div class="absolute inset-0 flex flex-col items-center justify-center">
              <span class="text-xs font-semibold uppercase tracking-widest text-[#88726F]">Monthly EMI</span>
              <span class="font-serif text-2xl font-bold text-[#121417] mt-1" id="emi-monthly">—</span>
            </div>
          </div>
          
          <div class="w-full space-y-4 text-sm">
            <div class="flex items-center justify-between border-b border-gray-100 pb-4">
              <span class="flex items-center gap-3 font-medium text-[#88726F]">
                <span class="h-3 w-3 rounded-full bg-[#B02317] shadow-sm"></span>Principal
              </span>
              <span class="font-serif text-lg font-medium text-[#121417]" id="emi-principal">—</span>
            </div>
            <div class="flex items-center justify-between pt-2">
              <span class="flex items-center gap-3 font-medium text-[#88726F]">
                <span class="h-3 w-3 rounded-full bg-[#FDF9F7] border border-gray-200 shadow-sm"></span>Total Interest
              </span>
              <span class="font-serif text-lg font-medium text-[#121417]" id="emi-interest">—</span>
            </div>
          </div>
        </div>
      </div>
      <p class="text-sm text-[#88726F] italic max-w-3xl">Note: This calculator provides an estimate. Actual EMI may vary depending on the lender's final terms, processing fees, and fluctuations in interest rates.</p>
    </section>

  </div>

</BaseLayout>

<style>
  /* Smooth Animations */
  .fade-in-panel {
    animation: fadeIn 0.4s ease-out forwards;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in { animation: fadeInOpacity 1s ease-out forwards; }
  .animate-fade-in-up { animation: fadeInUp 1s ease-out forwards; opacity: 0; }
  @keyframes fadeInOpacity { from { opacity: 0; } to { opacity: 1; } }
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Hide Scrollbar for Tabs */
  .hide-scrollbar::-webkit-scrollbar { display: none; }
  .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

  /* Premium Custom Range Slider */
  .emi-slider {
    -webkit-appearance: none;
    appearance: none;
    height: 6px;
    border-radius: 999px;
    background: #F0EAE8;
    outline: none;
    transition: background 0.3s;
  }
  .emi-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #B02317;
    cursor: pointer;
    border: 4px solid white;
    box-shadow: 0 4px 6px -1px rgba(176, 35, 23, 0.3), 0 0 0 1px #B02317;
    transition: transform 0.2s;
  }
  .emi-slider::-webkit-slider-thumb:hover {
    transform: scale(1.15);
  }
  .emi-slider::-moz-range-thumb {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #B02317;
    cursor: pointer;
    border: 4px solid white;
    box-shadow: 0 4px 6px -1px rgba(176, 35, 23, 0.3), 0 0 0 1px #B02317;
    transition: transform 0.2s;
  }
  .emi-slider::-moz-range-thumb:hover {
    transform: scale(1.15);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // --- Tab switching ---
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('.guide-tab');
    const panels = document.querySelectorAll<HTMLElement>('.guide-panel');

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.dataset.tab;

        tabButtons.forEach((b) => {
          b.classList.remove('text-[#B02317]');
          b.classList.add('text-[#88726F]');
          b.querySelector('span')?.classList.replace('scale-x-100', 'scale-x-0');
        });
        
        btn.classList.remove('text-[#88726F]');
        btn.classList.add('text-[#B02317]');
        btn.querySelector('span')?.classList.replace('scale-x-0', 'scale-x-100');

        panels.forEach((panel) => {
          if (panel.dataset.panel === target) {
            panel.classList.remove('hidden');
            // Re-trigger animation
            panel.classList.remove('fade-in-panel');
            void panel.offsetWidth; 
            panel.classList.add('fade-in-panel');
          } else {
            panel.classList.add('hidden');
          }
        });

        // Smooth scroll to top of tabs if needed
        const tabsContainer = document.getElementById('guide-tabs');
        if (tabsContainer) {
            const yOffset = -100; 
            const y = tabsContainer.getBoundingClientRect().top + window.pageYOffset + yOffset;
            window.scrollTo({top: y, behavior: 'smooth'});
        }
      });
    });

    // Check URL parameters for direct tab navigation
    const params = new URLSearchParams(window.location.search);
    const tabParam = params.get('tab');
    if (tabParam) {
      const activeBtn = Array.from(tabButtons).find(b => b.dataset.tab === tabParam);
      if (activeBtn) {
        // Prevent smooth scrolling on initial load
        setTimeout(() => activeBtn.click(), 100);
      }
    }

    // --- Accordions ---
    document.querySelectorAll<HTMLElement>('.accordion-item').forEach((item) => {
      const trigger = item.querySelector<HTMLElement>('.accordion-trigger');
      const content = item.querySelector<HTMLElement>('.accordion-content');
      const icon = item.querySelector<HTMLElement>('.accordion-icon');
      if (!trigger || !content || !icon) return;

      trigger.addEventListener('click', () => {
        const isOpen = !content.classList.contains('hidden');
        
        // Close others (Optional: comment out if you want multiple open at once)
        document.querySelectorAll<HTMLElement>('.accordion-content').forEach(c => {
           if(c !== content) {
               c.classList.add('hidden');
               c.previousElementSibling?.querySelector('.accordion-icon')?.classList.remove('rotate-45');
           }
        });

        content.classList.toggle('hidden', isOpen);
        if(!isOpen) {
            icon.classList.add('rotate-45');
        } else {
            icon.classList.remove('rotate-45');
        }
      });
    });

    // --- EMI Calculator ---
    const amountEl = document.getElementById('emi-amount') as HTMLInputElement | null;
    const downEl = document.getElementById('emi-down') as HTMLInputElement | null;
    const rateEl = document.getElementById('emi-rate') as HTMLInputElement | null;
    const yearsEl = document.getElementById('emi-years') as HTMLInputElement | null;

    const amountDisplay = document.getElementById('emi-amount-display');
    const downDisplay = document.getElementById('emi-down-display');
    const rateDisplay = document.getElementById('emi-rate-display');
    const yearsDisplay = document.getElementById('emi-years-display');

    const principalOut = document.getElementById('emi-principal');
    const interestOut = document.getElementById('emi-interest');
    const monthlyOut = document.getElementById('emi-monthly');
    const donut = document.getElementById('emi-donut');

    if (!amountEl || !downEl || !rateEl || !yearsEl) return;

    const formatINR = (value: number) =>
      '₹' + Math.round(value).toLocaleString('en-IN');

    function calculate() {
      const amount = parseFloat(amountEl!.value);
      const down = Math.min(parseFloat(downEl!.value), amount);
      const rate = parseFloat(rateEl!.value);
      const years = parseFloat(yearsEl!.value);

      const principal = Math.max(amount - down, 0);
      const monthlyRate = rate / 12 / 100;
      const months = years * 12;

      let emi = 0;
      if (monthlyRate > 0 && principal > 0) {
        const factor = Math.pow(1 + monthlyRate, months);
        emi = (principal * monthlyRate * factor) / (factor - 1);
      } else if (principal > 0) {
        emi = principal / months;
      }

      const totalPaid = emi * months;
      const totalInterest = Math.max(totalPaid - principal, 0);

      if (amountDisplay) amountDisplay.textContent = formatINR(amount);
      if (downDisplay) downDisplay.textContent = formatINR(down);
      if (rateDisplay) rateDisplay.textContent = rate.toFixed(1) + '%';
      if (yearsDisplay) yearsDisplay.textContent = years + (years === 1 ? ' Yr' : ' Yrs');

      if (principalOut) principalOut.textContent = formatINR(principal);
      if (interestOut) interestOut.textContent = formatINR(totalInterest);
      if (monthlyOut) monthlyOut.textContent = formatINR(emi);

      if (donut) {
        const circumference = 2 * Math.PI * 80; // 502.65
        const principalShare = totalPaid > 0 ? principal / totalPaid : 1;
        // Donut shows principal portion colored (or vice-versa depending on design). 
        // We will make the Red stroke represent the Principal portion.
        const dash = circumference * principalShare;
        donut.setAttribute('stroke-dasharray', `${dash} ${circumference}`);
      }
    }

    [amountEl, downEl, rateEl, yearsEl].forEach((el) => {
      el.addEventListener('input', calculate);
    });

    // Initialize
    calculate();
  });
</script>