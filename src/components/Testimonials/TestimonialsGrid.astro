---
// TestimonialsGrid.astro
import { Icon } from "@/components/Icon";

const testimonials = [
  {
    id: "anuroop",
    quote: "We're proud owners of one of the apartments built by Udbhav Developers in their first venture. The build quality is excellent, with branded fittings throughout the plumbing and electricals. The team is approachable and easy to work with.",
    name: "Anuroop Vijaya Kumar",
    role: "Mangalore, India",
    variant: "light",
    span: "lg:col-span-7",
    textSize: "text-2xl sm:text-3xl lg:text-4xl",
  },
  {
    id: "rayan",
    quote: "Kiran has been precise with every detail and always makes quality the priority, which is what sets Udbhav apart. Being abroad most of the time, he's made everything simple, from timely guidance to helping me find tenants.",
    name: "Rayan Cornelio",
    role: "Corporate Investor",
    variant: "ink",
    span: "lg:col-span-5",
    textSize: "text-xl sm:text-2xl",
  },
  {
    id: "varadaraj",
    quote: "The attention to detail in the floor plans and the sustainable materials used is commendable. They truly helped us find our forever home.",
    name: "Verified Homeowner",
    role: "Udbhav Chinmaya",
    variant: "light",
    span: "lg:col-span-4",
    textSize: "text-lg sm:text-xl",
    compact: true,
  },
  {
    id: "praveen",
    quote: "Udbhav's commitment to delivery schedules is their biggest strength. Praveen D kept us updated at every phase of construction.",
    name: "Verified Homeowner",
    role: "Udbhav Shanthi",
    variant: "peach",
    span: "lg:col-span-4",
    textSize: "text-lg sm:text-xl",
    compact: true,
  },
  {
    id: "ravi",
    quote: "Excellence isn't an act, it's a habit here — Ravi S and the site engineering team are true craftsmen.",
    name: "Verified Client",
    role: "K.R.K. Aayush",
    variant: "light",
    span: "lg:col-span-4",
    textSize: "text-lg sm:text-xl",
    compact: true,
  },
  {
    id: "krishnam",
    quote: "This is my fifth year in residence, and there hasn't been a single structural or seepage issue. The workmanship and dedication from Kiran and the team, in both timeline and finish quality, has been excellent.",
    name: "Krishnam Raju",
    role: "Real Estate Consultant",
    variant: "peach",
    span: "lg:col-span-7",
    textSize: "text-2xl sm:text-3xl",
  },
  {
    id: "sachin",
    quote: "The post-sale service is where Udbhav truly shines. Udbhav Square in Kottara is one of the finest projects in Mangalore, with excellent quality and thoughtful design.",
    name: "Sachin Kasaragod",
    role: "Property Owner",
    variant: "light",
    span: "lg:col-span-5",
    textSize: "text-xl sm:text-2xl",
  },
  {
    id: "rohit",
    quote: "Having lived across the UAE and Canada, I find Udbhav's completed projects equal in quality and standard to international buildings — the amenities, structure, and engineering are world-class.",
    name: "Rohit Damodar",
    role: "Property Owner",
    variant: "light",
    span: "lg:col-span-6",
    textSize: "text-xl",
  },
  {
    id: "arshad",
    quote: "Transparency in documentation was a huge relief. I bought a commercial unit at Udbhav Square, and the project is built tastefully, with real attention to detail and strong value for the investment.",
    name: "Arshad Shek",
    role: "Mangalore",
    variant: "ink",
    span: "lg:col-span-6",
    textSize: "text-xl",
  },
];

function initials(name: string) {
  return name.split(" ").filter((w) => /^[A-Za-z]/.test(w)).slice(0, 2).map((w) => w[0]).join("").toUpperCase();
}

// Mapped exactly to your design system
const variantClasses: Record<string, string> = {
  light: "bg-white border border-gray-100 hover:border-[#B02317]/20",
  peach: "bg-[#FDF9F7] border border-[#B02317]/10 hover:border-[#B02317]/30",
  ink: "bg-[#121417] text-white border border-white/10 hover:border-white/20 shadow-2xl",
};
---

<section class="py-16 md:py-24 px-6 bg-white font-sans">
  <div class="mx-auto max-w-7xl">

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      {testimonials.map((t, index) => {
        const isInk = t.variant === "ink";
        const starColor = isInk ? "text-[#B02317]" : "text-[#B02317]";
        const quoteMarkColor = isInk ? "text-white/5" : "text-[#121417]/5";
        const bodyColor = isInk ? "text-gray-300" : t.variant === "peach" ? "text-[#121417]" : "text-[#88726F]";
        const nameColor = isInk ? "text-white" : "text-[#121417]";
        const roleColor = isInk ? "text-gray-400" : "text-[#88726F]";
        const avatarBg = isInk ? "bg-white/10" : "bg-[#B02317]/10";
        const avatarText = isInk ? "text-white" : "text-[#B02317]";

        return (
          <div
            class:list={[
              "group relative overflow-hidden rounded-[32px] flex flex-col justify-between transition-all duration-500 hover:-translate-y-2 hover:shadow-xl animate-fade-in-up",
              t.compact ? "p-8" : "p-10 sm:p-12",
              variantClasses[t.variant],
              t.span,
            ]}
            style={`animation-delay: ${index * 75}ms; animation-fill-mode: both;`}
          >
            <!-- Decorative Quote Mark -->
            <span class:list={["absolute top-6 right-8 font-serif leading-none select-none pointer-events-none transition-transform duration-500 group-hover:scale-110 group-hover:rotate-6", t.compact ? "text-7xl" : "text-9xl", quoteMarkColor]}>
              "
            </span>

            <div class="relative z-10 space-y-6">
              <div class:list={["flex gap-1", starColor]}>
                {Array.from({ length: 5 }).map(() => (
                  <svg class={t.compact ? "h-4 w-4" : "h-5 w-5"} fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                ))}
              </div>
              <p class:list={["font-serif font-medium italic leading-relaxed", t.textSize, bodyColor]}>
                "{t.quote}"
              </p>
            </div>

            <div class="relative z-10 flex items-center gap-4 mt-10 pt-8 border-t border-current/10">
              <div class:list={["h-12 w-12 shrink-0 rounded-full flex items-center justify-center font-sans text-sm font-bold tracking-wider", avatarBg, avatarText]}>
                {initials(t.name)}
              </div>
              <div>
                <h4 class:list={["font-serif text-lg font-medium", nameColor]}>{t.name}</h4>
                <p class:list={["font-sans text-[11px] font-bold tracking-[0.2em] uppercase mt-1", roleColor]}>{t.role}</p>
              </div>
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>