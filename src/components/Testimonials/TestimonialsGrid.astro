---
// TestimonialsGrid.astro
import { Icon } from "@/components/Icon";

// Testimonial copy lightly cleaned up for typos, repetition, and tone —
// meaning and attribution preserved from the original client quotes.
const testimonials = [
  {
    id: "anuroop",
    quote: "We're proud owners of one of the apartments built by Udbhav Developers in their first venture. The build quality is excellent, with branded fittings throughout the plumbing and electricals. The team is approachable and easy to work with, and always answered our questions patiently. We'd highly recommend them.",
    name: "Anuroop Vijaya Kumar",
    role: "Mangalore, India",
    variant: "light",
    span: "lg:col-span-7",
    textSize: "text-2xl sm:text-3xl lg:text-4xl",
  },
  {
    id: "rayan",
    quote: "I was referred to Udbhav Developers, and to Kiran specifically, by a friend — and I've never regretted it. Kiran has been precise with every detail and always makes quality the priority, which is what sets Udbhav apart from other builders I've worked with. Being abroad most of the time, he's made everything simple, from timely guidance on registration deadlines to helping me find tenants and connecting me with a lawyer for the khata and rental agreement. Every phase of construction stayed on schedule.",
    name: "Rayan Cornelio",
    role: "Corporate Investor",
    variant: "ink",
    span: "lg:col-span-5",
    textSize: "text-lg sm:text-xl",
  },
  {
    id: "varadaraj",
    quote: "The attention to detail in the floor plans and the sustainable materials used is commendable. Varadaraj Shanbhag truly helped us find our forever home.",
    name: "Verified Homeowner",
    role: "Udbhav Chinmaya",
    variant: "light",
    span: "lg:col-span-4",
    textSize: "text-base sm:text-lg",
    compact: true,
  },
  {
    id: "praveen",
    quote: "Udbhav's commitment to delivery schedules is their biggest strength. Praveen D kept us updated at every phase of construction.",
    name: "Verified Homeowner",
    role: "Udbhav Shanthi",
    variant: "light",
    span: "lg:col-span-4",
    textSize: "text-base sm:text-lg",
    compact: true,
  },
  {
    id: "ravi",
    quote: "Excellence isn't an act, it's a habit here — Ravi S and the site engineering team are true craftsmen.",
    name: "Verified Client",
    role: "K.R.K. Aayush",
    variant: "peach",
    span: "lg:col-span-4",
    textSize: "text-base sm:text-lg",
    compact: true,
  },
  {
    id: "krishnam",
    quote: "I've worked with many developers across Karnataka, but Krishnam Raju's vision at Udbhav is uniquely focused on client satisfaction and structural integrity. I bought a flat in Udbhav's very first project in Nantoor during construction — this is my fifth year in residence, and there hasn't been a single structural or seepage issue. The workmanship and dedication from Kiran and the team, in both timeline and finish quality, has been excellent, and I see the same standard carried through in their newer projects.",
    name: "Krishnam Raju",
    role: "Real Estate Consultant",
    variant: "peach",
    span: "lg:col-span-7",
    textSize: "text-xl sm:text-2xl",
  },
  {
    id: "sachin",
    quote: "The post-sale service is where Udbhav truly shines — Sachin Kasaragod and the maintenance team are always available. Udbhav Square in Kottara is one of the finest projects in Mangalore, with excellent quality and thoughtful design. Looking forward to more projects like this from the team.",
    name: "Sachin Kasaragod",
    role: "Property Owner",
    variant: "light",
    span: "lg:col-span-5",
    textSize: "text-xl sm:text-2xl",
  },
  {
    id: "rohit",
    quote: "I've known Kiran B.K. since his days in Oman, the UAE, and the UK, through to his return to Mangalore as a developer. Having lived across the UAE and Canada, I find Udbhav's completed projects equal in quality and standard to international buildings — the amenities, structure, and engineering are world-class. Mangalore needs more builders holding this bar.",
    name: "Rohit Damodar",
    role: "Property Owner",
    variant: "light",
    span: "lg:col-span-6",
    textSize: "text-lg sm:text-xl",
  },
  {
    id: "arshad",
    quote: "Transparency in documentation was a huge relief — Arshad Shek made the legal and registration process completely straightforward. I bought a commercial unit at Udbhav Square, and the project is built tastefully, with real attention to detail and strong value for the investment.",
    name: "Arshad Shek",
    role: "Mangalore",
    variant: "light",
    span: "lg:col-span-6",
    textSize: "text-lg sm:text-xl",
  },
];

function initials(name: string) {
  return name
    .split(" ")
    .filter((w) => /^[A-Za-z]/.test(w))
    .slice(0, 2)
    .map((w) => w[0])
    .join("")
    .toUpperCase();
}

const variantClasses: Record<string, string> = {
  light: "bg-white border border-gray-100",
  peach: "bg-[#FCECE8] border border-[#F5D6CE]/40",
  ink: "bg-ink text-cream border border-white/10",
};
---

<section class="py-20 md:py-28 px-6 font-sans">
  <div class="mx-auto max-w-[1440px]">

   

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
      {testimonials.map((t) => {
        const isInk = t.variant === "ink";
        const starColor = isInk ? "text-[#E8836A]" : "text-[#C23B22]";
        const quoteMarkColor = isInk ? "text-white/10" : "text-black/5";
        const bodyColor = isInk ? "text-cream/80" : t.variant === "peach" ? "text-[#1A1A1A]" : "text-gray-700";
        const nameColor = isInk ? "text-cream" : "text-[#1A1A1A]";
        const roleColor = isInk ? "text-cream/50" : "text-gray-500";
        const avatarBg = isInk ? "bg-white/10" : "bg-[#FCECE8]";
        const avatarText = isInk ? "text-cream" : "text-[#C23B22]";

        return (
          <div
            class:list={[
              "relative overflow-hidden rounded-3xl shadow-sm flex flex-col justify-between",
              t.compact ? "p-7" : "p-8 sm:p-10",
              variantClasses[t.variant],
              t.span,
            ]}
          >
            <span class:list={["absolute top-4 right-6 font-serif select-none pointer-events-none", t.compact ? "text-5xl" : "text-8xl", quoteMarkColor]}>
              "
            </span>

            <div class="relative z-10 space-y-5">
              <div class:list={["flex gap-1", starColor]}>
                {Array.from({ length: 5 }).map(() => (
                  <span class={t.compact ? "text-sm" : "text-base"}>★</span>
                ))}
              </div>
              <p class:list={["font-serif font-normal italic leading-relaxed", t.textSize, bodyColor]}>
                "{t.quote}"
              </p>
            </div>

            <div class="relative z-10 flex items-center gap-3 mt-8 pt-6 border-t border-current/10">
              <div class:list={["h-10 w-10 shrink-0 rounded-full flex items-center justify-center font-serif text-sm font-semibold", avatarBg, avatarText]}>
                {initials(t.name)}
              </div>
              <div>
                <h4 class:list={["font-bold text-sm", nameColor]}>{t.name}</h4>
                <p class:list={["text-[10px] font-bold tracking-widest uppercase mt-0.5", roleColor]}>{t.role}</p>
              </div>
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>