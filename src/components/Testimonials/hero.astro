---
// TestimonialsHeader.astro
---

<section class="relative bg-white pt-28 pb-16 px-6 overflow-hidden">
  <!-- Subtle Background Gradient Glow -->
  <div class="absolute left-1/2 top-0 -translate-x-1/2 h-96 w-[800px] rounded-full bg-[#FDF9F7] blur-[120px] pointer-events-none -z-10"></div>

  <div class="mx-auto max-w-3xl flex flex-col items-center text-center animate-fade-in-up">
    
    <!-- Subtitle / Eyebrow (Breadcrumbs equivalent) -->
    <span class="font-sans text-xs font-bold tracking-[0.35em] text-[#B02317] uppercase mb-6">
      Home / Testimonials
    </span>

    <!-- Main Heading -->
    <h1 class="font-serif text-5xl sm:text-6xl lg:text-7xl font-medium text-[#121417] tracking-tight leading-[1.1]">
      <span class="italic text-[#B02317]">Testimonials</span>
    </h1>

  </div>
</section>