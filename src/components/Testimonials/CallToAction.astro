---
// CallToAction.astro
import { Icon } from "@/components/Icon";
---

<section class="relative bg-[#121417] py-32 px-6 font-sans text-center overflow-hidden">
  
  <!-- Abstract Design Elements -->
  <div class="absolute inset-0 opacity-20 pointer-events-none">
    <div class="absolute -top-40 -left-40 h-96 w-96 rounded-full bg-[#B02317] blur-[120px]"></div>
    <div class="absolute -bottom-40 -right-40 h-96 w-96 rounded-full bg-blue-900 blur-[120px]"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-4xl space-y-8 animate-fade-in-up">
    
    <span class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-4 py-2 text-xs font-semibold uppercase tracking-widest text-white/80 backdrop-blur-sm">
      <span class="h-2 w-2 rounded-full bg-[#B02317] animate-pulse"></span>
      Start Your Journey
    </span>

    <h2 class="font-serif text-5xl sm:text-6xl lg:text-7xl font-medium text-white tracking-tight leading-[1.1]">
      Ready to start your <br />
      <span class="italic text-[#B02317]">own story?</span>
    </h2>

    <p class="text-lg sm:text-xl text-gray-400 max-w-2xl mx-auto font-light leading-relaxed">
      Join our community of happy homeowners and experience the Udbhav difference. Let's build your legacy together.
    </p>

    <div class="pt-8">
      <a 
        href="/contact" 
        class="group inline-flex items-center gap-4 bg-[#B02317] hover:bg-[#8e1c12] text-white font-sans font-semibold text-sm uppercase tracking-widest px-10 py-5 rounded-2xl transition-all duration-300 shadow-xl shadow-[#B02317]/20 hover:shadow-[#B02317]/40 hover:-translate-y-1"
      >
        <span>Contact Us</span>
        <span class="flex h-8 w-8 items-center justify-center rounded-full border border-white/40 transition-transform duration-300 group-hover:translate-x-1">
          →
        </span>
      </a>
    </div>

  </div>
</section>