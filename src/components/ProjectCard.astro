---
import { Icon } from "@/components/Icon";
import ArtPanel from "@/components/ArtPanel.astro";
import { Badge } from "@/components/ui/badge";
import type { Project } from "@/lib/site-data";

interface Props {
  project: Project;
  seed?: number;
  size?: "default" | "large";
  showDescription?: boolean;
}
const { project, seed = 1, size = "default", showDescription = false } = Astro.props;
const tone = project.category === "Commercial" ? "ink" : seed % 2 === 0 ? "sand" : "clay";
---

<div class="group block">
  <a href={`/projects/${project.slug}/`} class="block" aria-label={`View ${project.name} details`}>
    <div class:list={["relative overflow-hidden rounded-lg", size === "large" ? "aspect-[16/11]" : "aspect-[4/3]"]}>
      <!-- <ArtPanel seed={seed} tone={tone} class="h-full w-full transition-transform duration-700 group-hover:scale-[1.04]" /> -->
       <img src={`/images/${project.image}.jpg`} alt={project.name} class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" loading="lazy" />
    
      <div class="absolute left-4 top-4">
        <Badge variant={project.status === "Ongoing" ? "default" : "dark"}>{project.status}</Badge>
      </div>
      <div class="absolute right-4 top-4 grid h-10 w-10 place-items-center rounded-full bg-cream/90 text-ink opacity-0 transition-opacity duration-300 group-hover:opacity-100">
        <Icon name="arrow-up-right" className="h-4 w-4" />
      </div>
    </div>
  </a>
  <div class="mt-4 flex items-start justify-between gap-3">
    <div>
      <h3 class="font-display text-xl text-ink transition-colors">
        <a href={`/projects/${project.slug}/`} class="hover:text-clay transition-colors">{project.name}</a>
      </h3>
      {showDescription ? (
        project.slug === "udbhav-chinmaya" ? (
          <p class="mt-2 text-sm text-muted-foreground leading-relaxed">
            Sophisticated low-density residences limited to only 40 luxury homes designed for privacy and luxury living. Discover our ongoing project offering <a href="/projects/udbhav-chinmaya/3-bhk-for-sale-kadri-mangalore/" class="text-clay underline underline-offset-4 font-medium hover:text-clay-hover transition-colors">3 BHK luxury flats</a> with complete RERA approval (PRM/KA/RERA/1257/334/PR/311225/008371), major bank loan sanctions, and high ROI potential in one of Mangaluru's prime residential hubs.
          </p>
        ) : (
          <p class="mt-2 text-sm text-muted-foreground leading-relaxed">{project.description || project.tagline}</p>
        )
      ) : (
        <p class="mt-1 text-sm text-muted-foreground">{project.tagline}</p>
      )}
    </div>
  </div>
</div>
