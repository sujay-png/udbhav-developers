---
import { Icon } from "@/components/Icon";

interface Props {
  quote: string;
  name: string;
  location: string;
  rating?: number;
  featured?: boolean;
}
const { quote, name, location, rating = 5, featured = false } = Astro.props;

// Truncate to ~120 chars for card preview to keep all cards balanced
const preview = quote.length > 130 ? quote.slice(0, 130).trimEnd() + "…" : quote;
const needsReadMore = quote.length > 130;
---

<div
  class:list={[
    "testimonial-card flex h-full flex-col justify-between rounded-md p-5 md:p-6 bg-[#1F1F1F] text-white cursor-pointer"
  ]}
  data-quote={quote}
  data-name={name}
  data-location={location}
  data-rating={rating}
>
  <div>
    <div class="flex items-center justify-between">
      <div class="flex gap-0.5">
        {
          Array.from({ length: rating }).map(() => (
            <Icon name="star" className="h-3.5 w-3.5 text-clay" />
          ))
        }
      </div>
      <Icon name="quote" className="h-5 w-5 text-white/20" />
    </div>
    <!-- Fixed height quote area — always 3 lines, balanced across all cards -->
    <p class="mt-4 text-sm leading-relaxed text-white/90 line-clamp-3 min-h-[4.5rem]">
      "{preview}"
    </p>
    {needsReadMore && (
      <button
        class="read-more-btn mt-2 text-xs font-semibold text-clay hover:underline text-left"
        type="button"
      >
        Read more
      </button>
    )}
  </div>
  <div class="mt-6 border-t pt-4 border-white/15">
    <p class="font-display text-base text-white">{name}</p>
    <p class="mt-0.5 text-xs uppercase tracking-wide text-clay">
      {location}
    </p>
  </div>
</div>

<script>
  // Global testimonial modal — initialise once
  if (!document.body.dataset.testimonialModalInit) {
    document.body.dataset.testimonialModalInit = 'true';

    // Create modal element
    const modal = document.createElement('dialog');
    modal.id = 'testimonial-modal';
    modal.innerHTML = `
      <div class="testi-modal-inner">
        <button class="testi-modal-close" aria-label="Close">&times;</button>
        <div class="testi-modal-stars" id="testi-stars"></div>
        <blockquote class="testi-modal-quote" id="testi-quote"></blockquote>
        <div class="testi-modal-author">
          <p class="testi-modal-name" id="testi-name"></p>
          <p class="testi-modal-location" id="testi-location"></p>
        </div>
      </div>
    `;
    document.body.appendChild(modal);

    const openModal = (card: HTMLElement) => {
      const quote = card.dataset.quote || '';
      const name = card.dataset.name || '';
      const location = card.dataset.location || '';
      const rating = parseInt(card.dataset.rating || '5');

      const starsEl = modal.querySelector('#testi-stars') as HTMLElement;
      const quoteEl = modal.querySelector('#testi-quote') as HTMLElement;
      const nameEl = modal.querySelector('#testi-name') as HTMLElement;
      const locationEl = modal.querySelector('#testi-location') as HTMLElement;

      starsEl.innerHTML = Array.from({ length: rating }).map(() =>
        `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="star-icon"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`
      ).join('');
      quoteEl.textContent = `"${quote}"`;
      nameEl.textContent = name;
      locationEl.textContent = location.toUpperCase();

      document.body.classList.add('overflow-hidden');
      document.documentElement.classList.add('overflow-hidden');
      (modal as HTMLDialogElement).showModal();
    };

    const closeModal = () => {
      (modal as HTMLDialogElement).close();
      document.body.classList.remove('overflow-hidden');
      document.documentElement.classList.remove('overflow-hidden');
    };

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;

      // Close button
      if (target.closest('.testi-modal-close')) {
        closeModal();
        return;
      }

      // Read more button
      const readMoreBtn = target.closest('.read-more-btn') as HTMLElement | null;
      if (readMoreBtn) {
        e.stopPropagation();
        const card = readMoreBtn.closest('.testimonial-card') as HTMLElement | null;
        if (card) openModal(card);
        return;
      }

      // Clicking the card itself also opens modal
      const card = target.closest('.testimonial-card') as HTMLElement | null;
      if (card) {
        openModal(card);
      }
    });

    // Close on backdrop click
    modal.addEventListener('click', (e) => {
      const rect = modal.getBoundingClientRect();
      const isInside = e.clientX >= rect.left && e.clientX <= rect.right &&
                       e.clientY >= rect.top  && e.clientY <= rect.bottom;
      if (!isInside) closeModal();
    });

    modal.addEventListener('close', closeModal);
  }
</script>

<style is:global>
  #testimonial-modal {
    padding: 0;
    border: none;
    border-radius: 1rem;
    background: transparent;
    max-width: min(680px, 94vw);
    width: 100%;
    max-height: 90vh;
    margin: auto;
    box-shadow: 0 24px 80px rgba(0,0,0,0.5);
  }
  #testimonial-modal::backdrop {
    background: rgba(0,0,0,0.65);
    backdrop-filter: blur(4px);
  }
  #testimonial-modal[open] {
    animation: testi-slide-up 0.35s cubic-bezier(0.16,1,0.3,1);
  }
  @keyframes testi-slide-up {
    from { opacity: 0; transform: translateY(24px) scale(0.96); }
    to   { opacity: 1; transform: translateY(0)  scale(1); }
  }
  .testi-modal-inner {
    background: #1F1F1F;
    color: #fff;
    padding: 2.5rem;
    border-radius: 1rem;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-height: 90vh;
    overflow-y: auto;
  }
  .testi-modal-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    font-size: 1.5rem;
    line-height: 1;
    background: rgba(255,255,255,0.08);
    border: none;
    color: #fff;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
  }
  .testi-modal-close:hover {
    background: rgba(255,255,255,0.16);
  }
  .testi-modal-stars {
    display: flex;
    gap: 0.25rem;
  }
  .star-icon {
    color: var(--color-clay, #c9622d);
  }
  .testi-modal-quote {
    font-size: 1rem;
    line-height: 1.75;
    color: rgba(255,255,255,0.88);
    font-style: italic;
    margin: 0;
    border-left: 3px solid var(--color-clay, #c9622d);
    padding-left: 1.25rem;
  }
  .testi-modal-author {
    border-top: 1px solid rgba(255,255,255,0.12);
    padding-top: 1rem;
  }
  .testi-modal-name {
    font-family: var(--font-display, serif);
    font-size: 1.05rem;
    font-weight: 600;
    color: #fff;
  }
  .testi-modal-location {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--color-clay, #c9622d);
    margin-top: 0.25rem;
  }
</style>
