---
import { Icon } from "@/components/Icon";

interface Props {
  quote: string;
  name: string;
  location: string;
  rating?: number;
  featured?: boolean;
}
const { quote, name, location, rating = 5, featured = false } = Astro.props;
---

<div
  class:list={[
    "testimonial-card flex h-full flex-col justify-between rounded-md p-5 md:p-6 bg-[#1F1F1F] text-white"
  ]}
>
  <div>
    <div class="flex items-center justify-between">
      <div class="flex gap-0.5">
        {
          Array.from({ length: rating }).map(() => (
            <Icon name="star" className="h-3.5 w-3.5 text-[#c32828]" />
          ))
        }
      </div>
      <Icon
        name="quote"
        className="h-5 w-5 text-white/20"
      />
    </div>
    <p
      class:list={[
        "mt-4 text-sm leading-relaxed transition-all duration-300 line-clamp-4 quote-text text-white/90"
      ]}
      title={quote}
    >
      "{quote}"
    </p>
    <button
      class:list={[
        "read-more-btn mt-2 text-xs font-semibold hover:underline text-left text-[#c32828]"
      ]}
      aria-expanded="false"
    >
      Read more
    </button>
  </div>
  <div class="mt-6 border-t pt-4 border-white/15">
    <p class="font-display text-base text-white">{name}</p>
    <p class="mt-0.5 text-xs uppercase tracking-wide text-[#c32828]">
      {location}
    </p>
  </div>
</div>

<script>
  if (!document.body.dataset.readMoreInit) {
    document.body.dataset.readMoreInit = 'true';
    
    // Use event delegation so it works for Swiper's cloned slides
    document.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest('.read-more-btn') as HTMLButtonElement | null;
      if (!target) return;
      
      const container = target.closest('.testimonial-card');
      const quote = container?.querySelector('.quote-text') as HTMLElement;
      
      if (quote) {
        quote.classList.toggle('line-clamp-4');
        const isExpanded = !quote.classList.contains('line-clamp-4');
        target.textContent = isExpanded ? 'Read less' : 'Read more';
        target.setAttribute('aria-expanded', isExpanded.toString());
      }
    });
  }
</script>
