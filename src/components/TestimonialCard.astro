---
import { Icon } from "@/components/Icon";

interface Props {
  quote: string;
  name: string;
  location: string;
  rating?: number;
  featured?: boolean;
}
const { quote, name, location, rating = 5, featured = false } = Astro.props;
---
<div
  class:list={[
    "group flex h-full flex-col justify-between rounded-lg p-7 transition-colors duration-300",
    featured
      ? "bg-ink text-cream hover:bg-cream hover:text-ink"
      : "bg-white text-ink hover:bg-ink hover:text-cream",
  ]}
>
  <div>
    <div class="flex items-center justify-between">
      <div class="flex gap-0.5">
        {Array.from({ length: rating }).map(() => (
          <Icon name="star" className="h-3.5 w-3.5 text-clay" />
        ))}
      </div>
      <Icon
        name="quote"
        className={[
          "h-6 w-6 transition-colors duration-300",
          featured ? "text-cream/20 group-hover:text-ink/10" : "text-ink/10 group-hover:text-cream/20",
        ].join(" ")}
      />
    </div>
    <p
      class:list={[
        "mt-5 text-[15px] leading-relaxed transition-colors duration-300",
        featured ? "text-cream/85 group-hover:text-ink/75" : "text-ink/75 group-hover:text-cream/85",
      ]}
    >
      "{quote}"
    </p>
  </div>
  <div
    class:list={[
      "mt-6 border-t pt-4 transition-colors duration-300",
      featured ? "border-cream/15 group-hover:border-ink/10" : "border-border group-hover:border-cream/15",
    ]}
  >
    <p class="font-display text-base">{name}</p>
    <p
      class:list={[
        "mt-0.5 text-xs uppercase tracking-wide transition-colors duration-300",
        featured ? "text-clay group-hover:text-clay" : "text-muted-foreground group-hover:text-clay",
      ]}
    >
      {location}
    </p>
  </div>
</div>