---
// PressMediaSection.astro
import { Icon } from "@/components/Icon";
---

<section class="relative overflow-hidden bg-[#0F1318] px-6 py-24 text-white">
  <!-- Subtle ambient background glow matching the dark theme -->
  <div class="absolute -top-32 -left-32 h-96 w-96 rounded-full bg-red-600/10 blur-3xl pointer-events-none"></div>

  <div class="mx-auto max-w-[1440px] grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
    
    <!-- Left Column: Titles, Description, and Asset Cards -->
    <div class="lg:col-span-7 space-y-10">
      
      <!-- Section Header -->
      <div class="space-y-4">
        <span class="text-xs font-bold tracking-widest text-[#FF4D2D] uppercase">
          JOURNALIST RESOURCES
        </span>
        <h2 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-normal leading-tight tracking-tight text-white">
          Professional Media Assets
        </h2>
        <p class="text-base sm:text-lg text-gray-400 max-w-xl leading-relaxed">
          Access high-resolution brand assets, executive biographies, and our comprehensive corporate profile. Designed for publishers and media partners requiring the highest standard of visual representation.
        </p>
      </div>

      <!-- Asset Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-2xl">
        
        <!-- Logo Package Card -->
        <div class="group relative bg-[#171C23] border border-white/5 rounded-3xl p-8 flex flex-col justify-between transition-all duration-300 hover:border-white/15 hover:shadow-xl hover:shadow-black/40">
          <div class="space-y-4">
            <div class="h-10 w-10 rounded-xl bg-white/5 flex items-center justify-center text-[#FF4D2D]">
              <Icon name="image" className="h-5 w-5" />
            </div>
            <div>
              <h3 class="font-serif text-2xl font-normal text-white">Logo Package</h3>
              <p class="text-xs text-gray-400 mt-2 leading-relaxed">
                SVG, PNG, and AI formats in all brand variants.
              </p>
            </div>
          </div>
          
          <div class="mt-8 pt-4 border-t border-white/5">
            <a href="#download-logo" class="inline-flex items-center gap-2 text-xs font-bold tracking-wider text-[#FF4D2D] uppercase transition-transform group-hover:translate-x-1">
              <span>Download Kit</span>
              <span>↓</span>
            </a>
          </div>
        </div>

        <!-- Exec Profiles Card -->
        <div class="group relative bg-[#171C23] border border-white/5 rounded-3xl p-8 flex flex-col justify-between transition-all duration-300 hover:border-white/15 hover:shadow-xl hover:shadow-black/40">
          <div class="space-y-4">
            <div class="h-10 w-10 rounded-xl bg-white/5 flex items-center justify-center text-[#FF4D2D]">
              <Icon name="user" className="h-5 w-5" />
            </div>
            <div>
              <h3 class="font-serif text-2xl font-normal text-white">Exec Profiles</h3>
              <p class="text-xs text-gray-400 mt-2 leading-relaxed">
                Portraits and bios for the leadership team.
              </p>
            </div>
          </div>
          
          <div class="mt-8 pt-4 border-t border-white/5">
            <a href="#download-exec" class="inline-flex items-center gap-2 text-xs font-bold tracking-wider text-[#FF4D2D] uppercase transition-transform group-hover:translate-x-1">
              <span>Download Kit</span>
              <span>↓</span>
            </a>
          </div>
        </div>

      </div>

    </div>

    <!-- Right Column: Press Inquiry Form Card -->
    <div class="lg:col-span-5 flex justify-center lg:justify-end">
      <div class="w-full max-w-lg bg-[#171C23] border border-white/5 rounded-3xl p-8 sm:p-10 shadow-2xl relative">
        
        <h3 class="font-serif text-2xl sm:text-3xl font-normal text-white mb-8">
          Press Inquiry
        </h3>

        <form class="space-y-6">
          
          <!-- Full Name Field -->
          <div class="space-y-2">
            <label class="block text-[11px] font-bold tracking-wider text-gray-400 uppercase">
              Full Name
            </label>
            <input 
              type="text" 
              class="w-full bg-[#101419] border border-white/10 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-[#FF4D2D] transition-colors"
              placeholder=""
            />
          </div>

          <!-- Media Outlet Field -->
          <div class="space-y-2">
            <label class="block text-[11px] font-bold tracking-wider text-gray-400 uppercase">
              Media Outlet
            </label>
            <input 
              type="text" 
              class="w-full bg-[#101419] border border-white/10 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-[#FF4D2D] transition-colors"
              placeholder=""
            />
          </div>

          <!-- Message Field -->
          <div class="space-y-2">
            <label class="block text-[11px] font-bold tracking-wider text-gray-400 uppercase">
              Message
            </label>
            <textarea 
              rows="4" 
              class="w-full bg-[#101419] border border-white/10 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-[#FF4D2D] transition-colors resize-none"
              placeholder=""
            ></textarea>
          </div>

          <!-- Submit Button -->
          <button 
            type="submit"
            class="w-full py-4 rounded-xl bg-gradient-to-r from-[#C21818] to-[#990F0F] text-white font-bold text-xs tracking-widest uppercase shadow-lg shadow-red-950/50 hover:brightness-110 transition-all cursor-pointer"
          >
            Submit Request
          </button>

        </form>

      </div>
    </div>

  </div>
</section>