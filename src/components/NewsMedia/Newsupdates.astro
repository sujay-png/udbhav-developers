---
// Newsupdates.astro
import MediaCard from "@/components/MediaCard.astro"; // Adjust path if needed
import type { Media } from "@/lib/site-data";

interface Props {
  mediaList: Media[];
}

const { mediaList } = Astro.props;
---

<section class="bg-[#FAF9F5] py-24 px-6 font-sans">
  <div class="mx-auto max-w-[1440px]">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16">
      <div>
        <span class="text-sm font-semibold tracking-wider text-amber-700 uppercase">Updates</span>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-normal text-[#1A1A1A] mt-2">
          News & Corporate Updates
        </h2>
      </div>
      <p class="text-gray-600 max-w-md mt-4 md:mt-0 leading-relaxed">
        Stay informed with our latest announcements, press coverage, and media highlights.
      </p>
    </div>

    <!-- Media Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {mediaList.map((media) => (
        <MediaCard media={media} />
      ))}
    </div>

  </div>
</section>