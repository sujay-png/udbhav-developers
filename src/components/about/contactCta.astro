---
// HeroSection.astro
---

<section class="relative overflow-hidden bg-black text-white">
    <!-- Decorative Gradient Glows for Modern Atmosphere -->
    <div class="absolute -top-40 -left-40 h-96 w-96 rounded-full bg-blue-600/20 blur-3xl pointer-events-none"></div>
    <div class="absolute top-1/2 right-0 h-[500px] w-[500px] rounded-full bg-amber-500/10 blur-3xl pointer-events-none"></div>

    <div class="mx-auto grid max-w-[1440px] grid-cols-1 lg:grid-cols-12 items-center px-6 py-24 lg:py-32 gap-12">
        
        <!-- Left Content Area -->
        <div class="lg:col-span-7 z-10">
            <!-- Badge / Subtitle Pill -->
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 backdrop-blur-md border border-white/10 text-sm font-medium text-amber-400 mb-6 shadow-inner">
                <span class="h-2 w-2 rounded-full bg-amber-400 animate-pulse"></span>
                Premium Real Estate & Architecture
            </div>

            <h2 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.15]">
                Let's build or choose from the 
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-amber-200"> dream space </span> 
                that you always wanted!
            </h2>

            <p class="mt-6 text-lg sm:text-xl leading-relaxed text-gray-300 max-w-[620px]">
                Contact us and get ready to move into the dream space of your choice. It's time to upgrade to a lifestyle that truly reflects your aspirations.
            </p>

            <!-- Action Area -->
            <div class="mt-10 flex flex-wrap items-center gap-6">
                <a
                    href="/contact"
                    class="group inline-flex items-center gap-4 rounded-xl bg-gradient-to-r from-[#ff3d3d] to-[#ef2d59] px-8 py-4 text-lg font-semibold text-white shadow-lg shadow-red-500/25 transition-all duration-300 hover:scale-105 hover:shadow-red-500/40"
                >
                    <span>Contact Us</span>
                    <span class="flex h-8 w-8 items-center justify-center rounded-full border border-white/40 transition-transform duration-300 group-hover:translate-x-1">
                        →
                    </span>
                </a>

                <div class="flex items-center gap-4 border-l border-white/20 pl-6 py-1">
                    <div>
                        <p class="text-2xl font-bold text-white">100%</p>
                        <p class="text-xs text-gray-400 uppercase tracking-wider">Tailored Spaces</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Visual / Illustration Area -->
        <div class="lg:col-span-5 relative flex justify-center lg:justify-end">
            <!-- Subtle Frame Container for Background Illustration -->
            <div class="relative w-full max-w-[600px] aspect-[4/3] lg:aspect-square flex items-center justify-center">
                <div class="absolute inset-0 bg-linear-to-tr from-blue-900/40 to-transparent rounded-3xl border border-white/10 backdrop-blur-sm -z-10"></div>
                
                <img
                    src="/images/udbhav-developers-logo-1.png"
                    alt="Building Architectural Outline"
                    class="w-full h-full object-contain opacity-40 drop-shadow-[0_20px_50px_rgba(0,0,0,0.5)] transition-transform duration-700 hover:scale-105 pointer-events-none"
                />
            </div>
        </div>

    </div>
</section>