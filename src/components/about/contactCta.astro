---
// Contactcta.astro
---
<section class="relative overflow-hidden bg-[#121417] text-white">
    <!-- Subtle Brand Glows -->
    <div class="absolute -left-40 -top-40 h-96 w-96 rounded-full bg-[#B02317]/20 blur-[120px] pointer-events-none"></div>

    <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-16 px-6 py-24 lg:grid-cols-2 lg:px-12 lg:py-32">
        
        <!-- Left Content -->
        <div class="z-10">
            <div class="mb-8 inline-flex items-center gap-3 rounded-full border border-white/20 bg-white/5 px-4 py-2 font-sans text-xs font-medium uppercase tracking-widest text-white/80 backdrop-blur-md">
                <span class="h-2 w-2 rounded-full bg-[#B02317] animate-pulse"></span>
                Premium Architecture
            </div>

            <h2 class="font-serif text-4xl font-medium leading-tight lg:text-6xl">
                Let's build the <br />
                <span class="font-serif italic text-[#B02317]">dream space</span> <br />
                you always wanted.
            </h2>

            <p class="mt-8 max-w-md font-sans text-lg font-light leading-relaxed text-gray-400">
                Contact us and get ready to move into the dream space of your choice. It's time to upgrade to a lifestyle that truly reflects your aspirations.
            </p>

            <div class="mt-12 flex flex-wrap items-center gap-8">
                <a
                    href="/contact"
                    class="group inline-flex items-center gap-4 bg-[#B02317] px-8 py-4 font-sans text-sm font-semibold uppercase tracking-wider text-white transition-all duration-300 hover:bg-[#8e1c12] hover:shadow-lg hover:shadow-[#B02317]/30"
                >
                    <span>Contact Us</span>
                    <span class="transition-transform duration-300 group-hover:translate-x-2">→</span>
                </a>

                <div class="border-l border-white/20 pl-8">
                    <p class="font-serif text-3xl text-white">100%</p>
                    <p class="mt-1 font-sans text-xs uppercase tracking-widest text-gray-400">Tailored Spaces</p>
                </div>
            </div>
        </div>

        <!-- Right Visual -->
        <div class="relative flex justify-center lg:justify-end">
            <div class="relative flex aspect-square w-full max-w-[500px] items-center justify-center rounded-[32px] border border-white/10 bg-white/5 p-8 backdrop-blur-sm">
                <img
                    src="/images/udbhav-developers-logo-1.png"
                    alt="Building Architectural Outline"
                    class="h-full w-full object-contain opacity-60 drop-shadow-2xl transition-transform duration-700 hover:scale-105"
                />
            </div>
        </div>
    </div>
</section>