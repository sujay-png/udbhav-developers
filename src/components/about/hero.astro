---
const heroImage = "/images/Udbhav-website.jpg"; // Replace with your image
---
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">

<section class="relative overflow-hidden bg-[#FDF9F7]">
  <!-- Background Image -->
  <div class="absolute inset-0 overflow-hidden">
    <img
      src={heroImage}
      alt="About Udbhav Developers"
      class="h-full w-full object-cover object-center opacity-20 grayscale transition-transform duration-[10s] hover:scale-105"
    />
    <!-- Gradient Overlays -->
    <div class="absolute inset-0 bg-gradient-to-r from-[#FDF9F7] via-[#FDF9F7]/95 to-[#FDF9F7]/40"></div>
  </div>

  <div class="relative mx-auto flex min-h-[92vh] max-w-7xl items-center px-6 py-24 lg:px-12 animate-fade-in">
    <div class="max-w-2xl">
      <p class="mb-8 font-sans text-xs font-semibold tracking-[0.45em] text-[#B02317] uppercase">
        Established 2012
      </p>

      <h1 class="font-serif text-[56px] font-medium leading-[1.05] text-[#121417] lg:text-[80px]">
        Building with <br /> Purpose,
      </h1>
      <h2 class="mt-2 font-serif text-[54px] italic leading-none text-[#B02317] lg:text-[76px]">
        Driven by Trust.
      </h2>

      <p class="mt-8 max-w-xl font-sans text-lg leading-relaxed text-[#88726F]">
        At Udbhav Developers, we stand for excellence, integrity, and innovation in the development of premium residential apartments, commercial spaces, and retail shops.
      </p>

      <div class="mt-12 flex flex-wrap gap-5">
        <a
          href="/portfolio"
          class="inline-flex items-center justify-center border border-[#121417] bg-[#121417] px-10 py-4 font-sans text-sm font-medium uppercase tracking-[0.2em] text-white transition-all duration-300 hover:bg-[#B02317] hover:border-[#B02317] hover:shadow-lg hover:-translate-y-1"
        >
          View Projects
        </a>
      </div>
    </div>
  </div>
</section>