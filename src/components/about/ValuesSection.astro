---
const values = [
    {
        title: "Transparency",
        description: "Honest communication and ethical practices",
        // Minimal Chat Bubbles SVG
        svg: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-8 w-8 text-[#B02317]"><path d="M14 9a2 2 0 0 1-2 2H6l-4 4V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v5Z"/><path d="M18 9h2a2 2 0 0 1 2 2v11l-4-4h-6a2 2 0 0 1-2-2v-1"/></svg>`,
    },
    {
        title: "Value for Investment",
        description: "Developments that deliver long-term financial sense",
        // Minimal Trending Chart SVG
        svg: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-8 w-8 text-[#B02317]"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/><path d="M14 9h5v5"/></svg>`,
    },
    {
        title: "Customer Centricity",
        description: "Designs shaped around real user needs",
        // Minimal User Focus SVG
        svg: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-8 w-8 text-[#B02317]"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="10" r="3"/><path d="M7 20.662V19a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v1.662"/></svg>`,
    },
    {
        title: "Quality First",
        description: "Uncompromising standards in construction and delivery",
        // Minimal Verified Badge SVG
        svg: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-8 w-8 text-[#B02317]"><path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/><path d="m9 12 2 2 4-4"/></svg>`,
    },
    {
        title: "Prime Locations",
        description: "Sites chosen for relevance and appreciation",
        // Minimal Map Pin SVG
        svg: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-8 w-8 text-[#B02317]"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>`,
    },
];
---

<section class="bg-[#FDF9F7] py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-12">
        
        <!-- Header -->
        <div class="text-center max-w-3xl mx-auto">
            <span class="font-sans text-sm font-semibold uppercase tracking-[0.35em] text-[#B02317]">
                Core Values
            </span>
            <h2 class="mt-6 font-serif text-4xl lg:text-5xl font-medium text-[#121417]">
                What Drives Every Project
            </h2>
            <p class="mt-6 font-sans text-lg text-[#88726F]">
                These principles define every decision we make—from selecting locations to delivering homes that stand the test of time.
            </p>
        </div>

        <!-- Value Cards Grid -->
        <div class="mt-20 flex flex-wrap justify-center gap-8">
            {values.map((value) => (
                <div class="group w-full md:w-[calc(50%-1rem)] lg:w-[calc(33.333%-1.5rem)] rounded-3xl bg-white p-10 text-center shadow-sm transition-all duration-500 hover:-translate-y-2 hover:shadow-xl border border-gray-100 hover:border-[#B02317]/20">
                    
                    <!-- SVG Icon Container -->
                    <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-[#B02317]/5 transition-colors duration-500 group-hover:bg-[#B02317]/10">
                        <div class="transition-transform duration-500 group-hover:scale-110" set:html={value.svg} />
                    </div>

                    <h3 class="mt-8 font-serif text-2xl font-medium text-[#121417]">
                        {value.title}
                    </h3>
                    
                    <p class="mt-4 font-sans text-base leading-relaxed text-[#88726F]">
                        {value.description}
                    </p>

                </div>
            ))}
        </div>

        <!-- Bottom Statement -->
        <div class="mx-auto mt-20 max-w-4xl rounded-3xl bg-white p-10 text-center shadow-sm border border-gray-100">
            <p class="font-serif text-2xl italic leading-relaxed text-[#121417]">
                "These values are embedded into the company culture and reflected consistently across all projects."
            </p>
        </div>

    </div>
</section>