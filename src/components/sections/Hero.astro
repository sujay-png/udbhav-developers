---
import { Icon } from "@/components/Icon";
import ArtPanel from "@/components/ArtPanel.astro";
import { Button } from "@/components/ui/button";
import { stats } from "@/lib/site-data";
---

<section class="relative overflow-hidden bg-ink text-cream">
  <ArtPanel seed={4} tone="ink" class="absolute inset-0" />

  <div class="relative mx-auto flex min-h-[86vh] max-w-[1400px] flex-col justify-end px-5 pb-16 pt-32 md:px-10 md:pb-20 md:pt-40">
    <p class="animate-fade-up text-[11px] font-semibold uppercase tracking-[0.25em] text-clay">
      Premium Architectural Developers · Est. 2012
    </p>

    <h1 class="animate-fade-up mt-5 max-w-3xl text-balance font-display text-[2.75rem] font-normal leading-[1.05] md:text-7xl" style="animation-delay:80ms">
      Live moments away from <em class="font-normal italic text-clay">luxury.</em>
    </h1>

    <p class="animate-fade-up mt-6 max-w-lg text-[15px] leading-relaxed text-cream/70" style="animation-delay:160ms">
      Future-ready living in the heart of Mangalore — upscale residential addresses designed for those who demand nothing less than quality.
    </p>

    <div class="animate-fade-up mt-9 flex flex-wrap items-center gap-4" style="animation-delay:240ms">
      <Button asChild size="lg">
        <a href="/portfolio">
          View Projects <Icon name="arrow-right" className="h-4 w-4" />
        </a>
      </Button>
      <Button asChild variant="outlineLight" size="lg">
        <a href="#virtual-walk">
          <Icon name="play" className="h-4 w-4" /> Take a Virtual Walk
        </a>
      </Button>
    </div>

    <div class="mt-16 grid grid-cols-2 gap-6 border-t border-cream/15 pt-8 sm:grid-cols-4">
      {
        stats.map((s) => (
          <div>
            <p class="font-display text-3xl text-cream md:text-4xl">{s.value}</p>
            <p class="mt-1 text-xs uppercase tracking-wide text-cream/50">{s.label}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
