---
// src/components/sections/HomeFaqSection.astro

const faqs = [
  {
    question: "Who are the leading builders in Mangalore for luxury apartments?",
    answer:
      "Udbhav Developers is recognized as one of the premier builders in Mangalore, founded in 2012 by qualified civil engineer Mr. B.K. Kiran. Specializing in luxury residential spaces and premium commercial properties in prime micro-locations like Kadri, Udbhav Developers delivers uncompromising structural integrity and complete RERA compliance.",
  },
  {
    question: "What makes Udbhav Developers a trusted real estate builder in Mangalore?",
    answer:
      'As a CREDAI-affiliated construction company, Udbhav Developers stands out among real estate builders in Mangalore due to direct civil engineering leadership, transparent project tracking, earthquake-resistant architectural designs, and a proven track record of delivering premium homes like <a href="/projects/udbhav-chinmaya/" class="text-clay font-medium underline underline-offset-2 hover:text-clay-hover transition-colors">Udbhav Chinmaya</a>.',
  },
  {
    question: "Are projects by Udbhav Developers RERA approved?",
    answer:
      "Yes, all ongoing and completed residential and commercial projects by Udbhav Developers are 100% RERA-approved, ensuring complete legal transparency, secure title deeds, and adherence to Karnataka real estate regulatory standards.",
  },
  {
    question: "Which localities do Udbhav Developers build in?",
    answer:
      "Udbhav Developers focuses on high-demand, prime urban micro-markets across Mangaluru, including Kadri, Shivbagh Road, and surrounding central residential hubs.",
  },
];
---

<section class="relative bg-[#FDF9F7] py-20 lg:py-28 border-t border-border/70" id="faq">
  <div class="mx-auto max-w-5xl px-6 lg:px-12">
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-14">
      <p class="font-display text-3xl sm:text-4xl lg:text-5xl font-medium text-ink">
        Frequently Asked Questions
      </p>
    </div>

    <!-- FAQ Accordion List -->
    <div class="bg-white rounded-3xl p-6 sm:p-10 border border-border/80 shadow-sm flex flex-col divide-y divide-border/60">
      {
        faqs.map((faq, index) => (
          <details class="group py-6 first:pt-0 last:pb-0" open={index === 0}>
            <summary class="flex cursor-pointer items-center justify-between gap-4 list-none [&::-webkit-details-marker]:hidden">
              <h2 class="text-lg sm:text-xl font-semibold text-ink group-hover:text-clay transition-colors pr-4 text-left">
                {faq.question}
              </h2>
              <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-border group-open:border-clay group-open:bg-clay/10 transition-colors">
                <svg
                  class="h-4 w-4 text-ink group-hover:text-clay group-open:rotate-180 transition-transform duration-300"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </summary>

            <div class="pt-4 pr-4 sm:pr-10 text-left">
              <p
                class="text-sm sm:text-base leading-relaxed text-ink/80"
                set:html={faq.answer}
              />
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
