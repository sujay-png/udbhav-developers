---
import { Icon } from "@/components/Icon";
import Eyebrow from "@/components/Eyebrow.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { Button } from "@/components/ui/button";
import { projects } from "@/lib/site-data";

const featured = projects.slice(0, 3);
---

<section class="mx-auto max-w-[1400px] px-5 py-24 md:px-10">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div class="max-w-3xl">
      <Eyebrow
        >Construction Company & Real Estate Developers in Mangaluru</Eyebrow
      >
      <p
        class="mt-4 text-[15px] leading-relaxed text-ink-soft md:text-base"
      >
        Welcome to Udbhav Developers, a leading construction company in
        Mangaluru established in 2012 by civil engineer Mr. B.K. Kiran. We
        specialize in crafting boutique luxury residential apartments, premium
        commercial spaces, and high-value properties across prime locations like
        Kadri and Kottara Chowki with uncompromising engineering standards and
        RERA compliance.
      </p>
      <h2
        class="mt-10 text-balance font-display text-3xl font-medium leading-[1.15] text-ink md:text-4xl lg:text-[2.75rem]"
      >
        Recent Projects
      </h2>
    </div>
  </div>

  <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {
      featured.map((p, i) => (
        <ProjectCard project={p} seed={i + 2} showDescription={true} />
      ))
    }
  </div>

  <div class="mt-12 flex justify-center">
    <Button asChild variant="link">
      <a
        href="/projects/"
        class="group flex items-center gap-2 text-sm font-medium uppercase tracking-wide text-ink underline underline-offset-4 transition-colors hover:text-primary hover:decoration-primary"
      >
        View All Projects
        <Icon
          name="arrow-right"
          className="h-4 w-4 transition-transform group-hover:translate-x-1"
        />
      </a>
    </Button>
  </div>
</section>
