---
import { Icon } from "@/components/Icon";
import Eyebrow from "@/components/Eyebrow.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { Button } from "@/components/ui/button";
import { projects } from "@/lib/site-data";

const featured = projects.slice(0, 3);
---

<section class="mx-auto max-w-[1400px] px-5 py-24 md:px-10">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div>
      <Eyebrow>UDBHAV DEVELOPERS MANGALORE</Eyebrow>
      <h2 class="mt-3 max-w-lg text-balance font-display text-4xl leading-[1.1] md:text-[2.75rem]">
        Featured Projects
      </h2>
    </div>
  </div>

  <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {featured.map((p, i) => <ProjectCard project={p} seed={i + 2} />)}
  </div>

  <div class="mt-12 flex justify-center">
    <Button asChild variant="link">
      <a href="/portfolio" class="group flex items-center gap-2 text-sm font-medium uppercase tracking-wide text-ink underline underline-offset-4 transition-colors hover:text-primary hover:decoration-primary">
        View All Projects
        <Icon name="arrow-right" className="h-4 w-4 transition-transform group-hover:translate-x-1" />
      </a>
    </Button>
  </div>
</section>
