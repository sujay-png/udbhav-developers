---
import { chinmayaContact } from "@/lib/site-data";
---

<div class="contact-form-panel">
  <div class="contact-form-header">
    <span class="contact-eyebrow">CONTACT US</span>
    <h2 class="contact-heading">Enquire 3 BHK Flat In Kadri</h2>
  </div>

  <form
    id="chinmaya-contact-form"
    class="contact-form"
    action={`mailto:${chinmayaContact.email}`}
    data-to-email={chinmayaContact.email}
    method="POST"
    enctype="text/plain"
    novalidate
  >
    <!-- Honeypot -->
    <div class="sr-only" aria-hidden="true" style="position:absolute;left:-9999px;opacity:0;">
      <label for="contact-hp">Do not fill this</label>
      <input type="text" id="contact-hp" name="_gotcha" tabindex="-1" autocomplete="off" />
    </div>

    <!-- Error Summary banner (if submission fails) -->
    <div id="contact-submit-error" class="contact-alert contact-alert-error hidden" role="alert">
      Something went wrong while submitting. Please check your information and try again.
    </div>

    <div class="contact-fields-grid">
      <!-- Name Field -->
      <div class="form-group">
        <label for="contact-name" class="form-label">
          ENTER YOUR NAME <span class="required-star">*</span>
        </label>
        <input
          type="text"
          id="contact-name"
          name="name"
          required
          minlength="2"
          autocomplete="name"
          placeholder=""
          class="form-input"
          aria-describedby="contact-name-error"
        />
        <span id="contact-name-error" class="form-error hidden" role="alert"></span>
      </div>

      <!-- Email Field -->
      <div class="form-group">
        <label for="contact-email" class="form-label">
          ENTER YOUR EMAIL <span class="required-star">*</span>
        </label>
        <input
          type="email"
          id="contact-email"
          name="email"
          required
          autocomplete="email"
          placeholder=""
          class="form-input"
          aria-describedby="contact-email-error"
        />
        <span id="contact-email-error" class="form-error hidden" role="alert"></span>
      </div>

      <!-- Phone Field -->
      <div class="form-group">
        <label for="contact-phone" class="form-label">
          PHONE NUMBER <span class="required-star">*</span>
        </label>
        <input
          type="tel"
          id="contact-phone"
          name="phone"
          required
          autocomplete="tel"
          placeholder=""
          class="form-input"
          aria-describedby="contact-phone-error"
        />
        <span id="contact-phone-error" class="form-error hidden" role="alert"></span>
      </div>

      <!-- City Field -->
      <div class="form-group">
        <label for="contact-city" class="form-label">
          CURRENT CITY <span class="required-star">*</span>
        </label>
        <input
          type="text"
          id="contact-city"
          name="city"
          required
          autocomplete="address-level2"
          placeholder=""
          class="form-input"
          aria-describedby="contact-city-error"
        />
        <span id="contact-city-error" class="form-error hidden" role="alert"></span>
      </div>
    </div>

    <!-- Unit Type Field -->
    <div class="form-group">
      <label class="form-label" id="contact-unit-type-label">UNIT TYPE</label>
      <div class="unit-chips" role="radiogroup" aria-labelledby="contact-unit-type-label">
        <label class="unit-chip">
          <input
            type="radio"
            name="unitType"
            value="3 BHK Unit"
            checked
            class="unit-radio"
          />
          <span class="unit-radio-custom" aria-hidden="true">
            <span class="unit-radio-dot"></span>
          </span>
          <span class="unit-chip-text">3 BHK Unit</span>
        </label>
      </div>
    </div>

    <!-- Message Field -->
    <div class="form-group">
      <label for="contact-message" class="form-label">MESSAGE</label>
      <textarea
        id="contact-message"
        name="message"
        maxlength="500"
        rows="3"
        placeholder=""
        class="form-textarea"
        aria-describedby="contact-message-error"
      ></textarea>
      <span id="contact-message-error" class="form-error hidden" role="alert"></span>
    </div>

    <!-- Submit Button -->
    <div class="contact-actions">
      <button
        type="submit"
        id="contact-submit-button"
        class="btn btn-primary"
      >
        Submit
      </button>
    </div>
  </form>
</div>

<script>
  import {
    validateName,
    validateEmail,
    validatePhone,
    validateCity,
    validateMessage,
  } from "@/utils/validation";

  function setupContactForm() {
    const form = document.getElementById("chinmaya-contact-form") as HTMLFormElement | null;
    if (!form || form.dataset.bound === "true") return;
    form.dataset.bound = "true";

    const submitBtn = document.getElementById("contact-submit-button") as HTMLButtonElement | null;
    const submitError = document.getElementById("contact-submit-error");

    const fields = {
      name: {
        input: form.querySelector("#contact-name") as HTMLInputElement,
        error: form.querySelector("#contact-name-error") as HTMLElement,
        validator: validateName,
      },
      email: {
        input: form.querySelector("#contact-email") as HTMLInputElement,
        error: form.querySelector("#contact-email-error") as HTMLElement,
        validator: validateEmail,
      },
      phone: {
        input: form.querySelector("#contact-phone") as HTMLInputElement,
        error: form.querySelector("#contact-phone-error") as HTMLElement,
        validator: validatePhone,
      },
      city: {
        input: form.querySelector("#contact-city") as HTMLInputElement,
        error: form.querySelector("#contact-city-error") as HTMLElement,
        validator: validateCity,
      },
      message: {
        input: form.querySelector("#contact-message") as HTMLTextAreaElement,
        error: form.querySelector("#contact-message-error") as HTMLElement,
        validator: validateMessage,
      },
    };

    function validateSingleField(key: keyof typeof fields): boolean {
      const field = fields[key];
      if (!field.input) return true;
      const value = field.input.value;
      const errorMsg = field.validator(value);

      if (errorMsg) {
        field.input.setAttribute("aria-invalid", "true");
        field.input.classList.add("input-has-error");
        if (field.error) {
          field.error.textContent = errorMsg;
          field.error.classList.remove("hidden");
        }
        return false;
      } else {
        field.input.removeAttribute("aria-invalid");
        field.input.classList.remove("input-has-error");
        if (field.error) {
          field.error.textContent = "";
          field.error.classList.add("hidden");
        }
        return true;
      }
    }

    // Attach blur validation and clear on input
    Object.keys(fields).forEach((key) => {
      const fieldKey = key as keyof typeof fields;
      const field = fields[fieldKey];
      if (!field.input) return;

      field.input.addEventListener("blur", () => {
        validateSingleField(fieldKey);
      });

      field.input.addEventListener("input", () => {
        if (field.input.getAttribute("aria-invalid") === "true") {
          validateSingleField(fieldKey);
        }
      });
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      // Check honeypot
      const hp = (form.querySelector("#contact-hp") as HTMLInputElement)?.value;
      if (hp) {
        // Silently treat as spam bot success
        window.location.href = "/chinmaya-thank-you/";
        return;
      }

      if (submitError) {
        submitError.classList.add("hidden");
      }

      // Validate all fields
      let isAllValid = true;
      (Object.keys(fields) as Array<keyof typeof fields>).forEach((k) => {
        const valid = validateSingleField(k);
        if (!valid && isAllValid) {
          isAllValid = false;
          fields[k].input?.focus();
        }
      });

      if (!isAllValid) {
        return;
      }

      // Prepare payload
      const name = fields.name.input.value.trim();
      const email = fields.email.input.value.trim();
      const phone = fields.phone.input.value.trim();
      const city = fields.city.input.value.trim();
      const message = fields.message.input.value.trim();
      const unitTypeInput = form.querySelector('input[name="unitType"]:checked') as HTMLInputElement | null;
      const unitType = unitTypeInput?.value || "3 BHK Unit";

      const toEmail = form.dataset.toEmail || "info@udbhavdevelopers.com";

      const payload = {
        formId: 2,
        source: "3bhk-landing",
        toEmail,
        name,
        email,
        phone,
        city,
        unitType,
        message,
      };

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "Submitting…";
      }

      try {
        const response = await fetch("/api/contact/", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify(payload),
        });

        if (!response.ok) {
          throw new Error(`Submission failed with status ${response.status}`);
        }

        // Redirect on success to follow chinmaya flow
        window.location.href = "/chinmaya-thank-you/";
      } catch (err) {
        console.error("Contact form submission error:", err);
        if (submitError) {
          submitError.classList.remove("hidden");
        }
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = "Submit";
        }
      }
    });
  }

  setupContactForm();
  document.addEventListener("astro:page-load", setupContactForm);
</script>

<style>
  .contact-form-panel {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 44px 48px;
    background: var(--paper);
  }

  .contact-form-header {
    margin-bottom: 24px;
  }

  .contact-eyebrow {
    display: inline-block;
    color: var(--red);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .contact-heading {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.2vw, 2.15rem);
    font-weight: 600;
    line-height: 1.2;
    color: var(--ink);
    margin: 0;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .contact-alert {
    padding: 12px 14px;
    border-radius: 4px;
    font-size: 0.85rem;
    line-height: 1.4;
  }

  .contact-alert-error {
    background: var(--red-tint);
    border: 1px solid var(--red);
    color: var(--red-deep);
  }

  .contact-fields-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px 24px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0;
  }

  .required-star {
    color: var(--red);
    font-weight: bold;
  }

  .form-input,
  .form-textarea {
    width: 100%;
    box-sizing: border-box;
    font-family: var(--font-body);
    font-size: 0.92rem;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 11px 14px;
    outline: none;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .form-textarea {
    resize: vertical;
    min-height: 105px;
    line-height: 1.5;
  }

  .form-input:focus,
  .form-textarea:focus {
    border-color: var(--red);
    box-shadow: 0 0 0 2px var(--red-tint);
  }

  .form-input.input-has-error,
  .form-textarea.input-has-error {
    border-color: var(--red);
    background-color: #fffaf9;
  }

  .form-error {
    font-size: 0.75rem;
    color: var(--red);
    line-height: 1.3;
    margin-top: 2px;
  }

  .unit-chips {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .unit-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 18px 7px 14px;
    border: 1.5px solid var(--red);
    background: var(--red-tint);
    border-radius: 9999px;
    cursor: pointer;
    user-select: none;
    transition: transform 0.15s ease, background-color 0.15s ease;
  }

  .unit-chip:hover {
    background: #fae2dc;
  }

  .unit-radio {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .unit-radio-custom {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 1.5px solid var(--red);
    background: #ffffff;
    box-sizing: border-box;
  }

  .unit-radio-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--red);
  }

  .unit-chip-text {
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--ink);
  }

  .contact-actions {
    margin-top: 4px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 13px 38px;
    border-radius: 4px;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    border: 1.5px solid transparent;
    transition: all 0.18s ease;
  }

  .btn-primary {
    background: var(--red);
    color: #ffffff;
  }

  .btn-primary:hover:not(:disabled) {
    background: var(--red-deep);
  }

  .btn-primary:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }

  .hidden {
    display: none !important;
  }

  @media (max-width: 900px) {
    .contact-form-panel {
      padding: 36px 28px;
    }

    .contact-fields-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }

  @media (max-width: 480px) {
    .contact-form-panel {
      padding: 28px 20px;
    }
  }
</style>
