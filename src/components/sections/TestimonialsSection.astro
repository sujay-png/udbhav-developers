---
import Eyebrow from "@/components/Eyebrow.astro";
import TestimonialCard from "@/components/TestimonialCard.astro";
import { testimonials } from "@/lib/site-data";

interface Props {
  title?: string;
  subtitle?: string;
}
const { title = "What people are saying", subtitle = "Voices of our proud home-owners and commercial partners." } = Astro.props;
---

<section class="mx-auto max-w-[1400px] px-5 pt-24 pb-40 md:px-10">
  <div class="mx-auto max-w-xl text-center">
    <Eyebrow class="justify-center">Voices of Trust</Eyebrow>
    <h2 class="mt-3 text-balance font-display text-4xl leading-[1.1] md:text-[2.75rem]">{title}</h2>
    <p class="mt-4 text-sm text-muted-foreground">{subtitle}</p>
  </div>

  <div class="relative mt-14 group">
    <div class="swiper testimonialSwiper sm:mt-20 " >
      <div class="swiper-wrapper">
        {
          testimonials.map((t) => (
            <div class="swiper-slide">
              <div class="h-full px-2">
                <TestimonialCard quote={t.quote} name={t.name} location={t.location} rating={t.rating} featured={t.featured} />
              </div>
            </div>
          ))
        }
      </div>
      <div class="swiper-pagination"></div>
    </div>
    
    <button class="swiper-button-prev-testi absolute left-0 top-1/2 z-10 hidden h-12 w-12 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white text-[#B02317] shadow-xl border border-gray-100 transition-all hover:bg-[#B02317] hover:text-white lg:flex lg:opacity-0 lg:group-hover:opacity-100">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
    </button>
    <button class="swiper-button-next-testi absolute right-0 top-1/2 z-10 hidden h-12 w-12 translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white text-[#B02317] shadow-xl border border-gray-100 transition-all hover:bg-[#B02317] hover:text-white lg:flex lg:opacity-0 lg:group-hover:opacity-100">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
    </button>
  </div>

  <div class="relative z-20 mt-4 text-center">
    <a
      href="/testimonials/"
      class="inline-flex h-12 items-center justify-center rounded-md bg-[#c32828] px-8 text-sm font-bold text-white shadow hover:bg-[#a02020] transition-colors gap-2"
    >
      View All Testimonials 
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 12h8"/><path d="m12 16 4-4-4-4"/></svg>
    </a>
  </div>
</section>

<script>
  import Swiper from "swiper/bundle";
  import "swiper/css/bundle";

  function initTestimonialSwiper() {
    const el = document.querySelector(".testimonialSwiper") as HTMLElement;
    if (!el || el.dataset.swiperInit === "true") return;
    el.dataset.swiperInit = "true";

    new Swiper(el, {
      slidesPerView: 1,
      spaceBetween: 24,
      loop: true,
      speed: 800,
      autoplay: {
        delay: 5000,
        disableOnInteraction: false,
      },
      navigation: {
        nextEl: ".swiper-button-next-testi",
        prevEl: ".swiper-button-prev-testi",
      },
      pagination: {
        el: ".testimonialSwiper .swiper-pagination",
        clickable: true,
      },
      breakpoints: {
        640: {
          slidesPerView: 2,
          spaceBetween: 24,
        },
        1024: {
          slidesPerView: 3,
          spaceBetween: 32,
        },
        1280: {
          slidesPerView: 4,
          spaceBetween: 32,
        },
      },
    });
  }

  // Init on first load and on Astro page transitions
  document.addEventListener("DOMContentLoaded", initTestimonialSwiper);
  document.addEventListener("astro:page-load", initTestimonialSwiper);
  // Also try immediately in case DOM is already loaded
  if (document.readyState !== "loading") initTestimonialSwiper();
</script>

<style is:global>
  .testimonialSwiper .swiper-pagination {
    position: relative !important;
    bottom: auto !important;
    margin-top: 3rem !important;
  }
  .testimonialSwiper .swiper-pagination-bullet {
    background-color: var(--color-clay) !important;
    opacity: 1;
  }
  .testimonialSwiper .swiper-pagination-bullet-active {
    background-color: var(--color-ink) !important;
    opacity: 1;
  }
</style>