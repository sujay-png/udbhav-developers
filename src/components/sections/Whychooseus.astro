---
import { Icon } from "../Icon";

const features = [
  {
    icon: "",
    title: "Uncompromising Quality",
    description:
      "Every project we develop or work on is built around quality. Right from design, materials, procurement, vendors to worksmanship, we invest heavily in providing the best quality for our customers."
  },
  {
    image: "/images/Udbhav-website.webp"
  },
  {
    icon: "/icons/eco.svg",
    title: "Eco-conscious Approach",
    description:
      "We strongly believe that for a greater future there has to be a sustainable all-round development, & we strive to account for the environment in all our works."
  },
  
 
];

const seconndfeatures=[
   {
    image: "/images/chinmaya.webp"
  },
   {
    icon: "",
    title: "Strong focus on Customer Satisfaction",
    description:
      "We believe in giving our customers more value than they invest in. Hence, all our projects revolve around this philosophy of utmost customer satisfaction."
  },
  {
    image:"/images/project_image2.jpg"
  },
];
---

<section class="bg-[#FCF8F5] py-24">

  <div class="mx-auto max-w-7xl px-6">

    <!-- Heading -->

    <div class="mx-auto max-w-3xl text-center">

      <span
        class="text-sm font-semibold uppercase tracking-[0.35em] text-[#D63232]">

        WHY CHOOSE US

      </span>

      <h2
        class="mt-4 text-4xl font-bold text-slate-900 md:text-6xl">

        Why we're your best choice

      </h2>

      <p
        class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-black">

     We aim to create a benchmark in the real estate industry with a long lasting reputation in quality, trust and innovation.

      </p>

    </div>

    <!-- Cards -->

    <div
      class="mt-14 grid gap-8 lg:grid-cols-3">

      <!-- Left Card -->

      <div
        class="group flex flex-col justify-between rounded-[36px] border border-gray-200 bg-white p-7 sm:p-8 shadow-lg transition duration-500 hover:-translate-y-3 hover:shadow-2xl">

        <div>
          <h3
            class="text-2xl font-bold text-slate-900">
            {features[0].title}
          </h3>

          <p
            class="mt-3 text-base leading-relaxed text-black">
            {features[0].description}
          </p>
        </div>

        <div
          class="mt-6 h-px bg-gray-200"></div>

      </div>

      <!-- Center Image -->

      <div
        class="group flex h-full min-h-[280px] w-full overflow-hidden rounded-[36px] border border-gray-200 shadow-lg transition duration-500 hover:-translate-y-3 hover:shadow-2xl">

        <img
          src={features[1].image}
          alt=""
          class="h-full w-full flex-1 object-cover object-center"
          style="width: 100%; height: 100%; object-fit: cover; object-position: center;" />

      </div>

      <!-- Right Card -->

      <div
        class="group flex flex-col justify-between rounded-[36px] border border-gray-200 bg-white p-7 sm:p-8 shadow-lg transition duration-500 hover:-translate-y-3 hover:shadow-2xl">

        <div>
          <h3
            class="text-2xl font-bold text-slate-900">
            {features[2].title}
          </h3>

          <p
            class="mt-3 text-base leading-relaxed text-black">
            {features[2].description}
          </p>
        </div>

        <div
          class="mt-6 h-px bg-gray-200"></div>

      </div>

    </div>

   <!--Sencond card  -->
    <div
      class="mt-8 grid gap-8 lg:grid-cols-3">

      <!-- Left Card -->
       <div
        class="group flex h-full min-h-[280px] w-full overflow-hidden rounded-[36px] border border-gray-200 shadow-lg transition duration-500 hover:-translate-y-3 hover:shadow-2xl">

        <img
          src={seconndfeatures[0].image}
          alt=""
          class="h-full w-full flex-1 object-cover object-center"
          style="width: 100%; height: 100%; object-fit: cover; object-position: center;" />

      </div>

      <div
        class="group flex flex-col justify-between rounded-[36px] border border-gray-200 bg-white p-7 sm:p-8 shadow-lg transition duration-500 hover:-translate-y-3 hover:shadow-2xl">

        <div>
          <h3
            class="text-2xl font-bold text-slate-900">
            {seconndfeatures[1].title}
          </h3>

          <p
            class="mt-3 text-base leading-relaxed text-black">
            {seconndfeatures[1].description}
          </p>
        </div>

        <div
          class="mt-6 h-px bg-gray-200"></div>

      </div>

      <!-- Center Image -->
      <div
        class="group flex h-full min-h-[280px] w-full overflow-hidden rounded-[36px] border border-gray-200 shadow-lg transition duration-500 hover:-translate-y-3 hover:shadow-2xl">

        <img
          src={seconndfeatures[2].image}
          alt=""
          class="h-full w-full flex-1 object-cover object-center"
          style="width: 100%; height: 100%; object-fit: cover; object-position: center;" />

      </div>
      

      <!-- Right Card -->


    </div>

  </div>

</section>
