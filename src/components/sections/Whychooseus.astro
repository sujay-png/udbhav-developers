---
import { Icon } from "../Icon";

const features = [
  {
    icon: "",
    title: "Uncompromising Quality",
    description:
      "Every project we undertake is built around exceptional craftsmanship, premium materials, and meticulous attention to detail, ensuring lasting value for our customers."
  },
  {
    image: "/images/Udbhav-website.jpg"
  },
  {
    icon: "/icons/eco.svg",
    title: "Eco-conscious Approach",
    description:
      "We embrace sustainable construction practices that reduce environmental impact while creating healthier and more efficient living spaces."
  },
  
 
];

const seconndfeatures=[
   {
    image: "/images/chinmaya.jpg"
  },
   {
    icon: "",
    title: "Strong focus on Customer Satisfaction",
    description:
      "We believe in giving our customers more value than they invest in. Hence, all our projects revolve around this philosophy of utmost customer satisfaction."
  },
  {
    image:"/images/project_image2.jpg"
  },
];
---

<section class="bg-[#FCF8F5] py-24">

  <div class="mx-auto max-w-7xl px-6">

    <!-- Heading -->

    <div class="mx-auto max-w-3xl text-center">

      <span
        class="text-sm font-semibold uppercase tracking-[0.35em] text-[#D63232]">

        WHY CHOOSE US

      </span>

      <h2
        class="mt-4 text-4xl font-bold text-slate-900 md:text-6xl">

        Why we're your best choice

      </h2>

      <p
        class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-slate-500">

        We aim to create a benchmark in the real estate industry through
        timeless architecture, uncompromising quality, and long-term trust.

      </p>

    </div>

    <!-- Cards -->

    <div
      class="mt-20 grid gap-8 lg:grid-cols-3">

      <!-- Left Card -->

      <div
        class="group rounded-[36px] border border-gray-200 bg-white p-10 shadow-lg transition duration-500 hover:-translate-y-3 hover:shadow-2xl">

     
        <h3
          class="mt-10 text-3xl font-bold text-slate-900">

          {features[0].title}

        </h3>

        <p
          class="mt-6 text-lg leading-9 text-slate-500">

          {features[0].description}

        </p>

        <div
          class="mt-10 h-px bg-gray-200"></div>

      </div>

      <!-- Center Image -->

      <div
        class="overflow-hidden rounded-[36px] shadow-xl">

        <img
          src={features[1].image}
          alt=""
          class="h-full w-full object-cover transition duration-700 hover:scale-110" />

      </div>

      <!-- Right Card -->

      <div
        class="group rounded-[36px] border border-gray-200 bg-white p-10 shadow-lg transition duration-500 hover:-translate-y-3 hover:shadow-2xl">

     

        <h3
          class="mt-10 text-3xl font-bold text-slate-900">

          {features[2].title}

        </h3>

        <p
          class="mt-6 text-lg leading-9 text-slate-500">

          {features[2].description}

        </p>

        <div
          class="mt-10 h-px bg-gray-200"></div>

      </div>

    </div>

   <!--Sencond card  -->
    <div
      class="mt-20 grid gap-8 lg:grid-cols-3">

      <!-- Left Card -->
       <div
        class="overflow-hidden rounded-[36px] shadow-xl">

        <img
          src={seconndfeatures[0].image}
          alt=""
          class="h-full w-full object-cover transition duration-700 hover:scale-110" />

      </div>

      <div
        class="group rounded-[36px] border border-gray-200 bg-white p-10 shadow-lg transition duration-500 hover:-translate-y-3 hover:shadow-2xl">

     
        <h3
          class="mt-10 text-3xl font-bold text-slate-900">

          {seconndfeatures[1].title}

        </h3>

        <p
          class="mt-6 text-lg leading-9 text-slate-500">

          {seconndfeatures[1].description}

        </p>

        <div
          class="mt-10 h-px bg-gray-200"></div>

      </div>

      <!-- Center Image -->
<div
        class="overflow-hidden rounded-[36px] shadow-xl">

        <img
          src={seconndfeatures[2].image}
          alt=""
          class="h-full w-full object-cover transition duration-700 hover:scale-110" />

      </div>
      

      <!-- Right Card -->


    </div>

  </div>

</section>
