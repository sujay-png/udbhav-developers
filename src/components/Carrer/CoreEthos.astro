---
// CoreEthos.astro
---

<section class="bg-[#FDF9F7] py-24 px-6 md:px-16 lg:px-24 flex items-center justify-center min-h-[80vh] overflow-hidden">
  <div class="max-w-7xl w-full grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
    
    <!-- Left Column: Text & Stats -->
    <div class="flex flex-col justify-center animate-fade-in-up">
      
      <!-- Subheading -->
      <span class="font-sans text-xs font-semibold tracking-[0.35em] text-[#B02317] uppercase mb-4">
        Our Core Ethos
      </span>

      <!-- Main Heading -->
      <h2 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-medium text-[#121417] leading-[1.1] tracking-tight mb-8">
        Building with Purpose,<br />
        <span class="italic text-[#B02317]">Driven by Trust.</span>
      </h2>

      <!-- Description Paragraph -->
      <p class="font-sans text-lg leading-relaxed text-[#88726F] max-w-lg mb-10">
        Since our inception in 2012, we have been committed to creating future-ready structures that blend thoughtful design with long-term value. We stand for excellence, integrity, and innovation.
      </p>

      <!-- Divider Line -->
      <div class="w-full h-[1px] bg-gradient-to-r from-[#B02317]/20 to-transparent mb-10"></div>

      <!-- Stats Grid -->
      <div class="grid grid-cols-2 gap-8 max-w-md">
        <div>
          <h3 class="font-serif text-5xl font-medium text-[#121417] mb-2">
            12<span class="text-[#B02317]">+</span>
          </h3>
          <p class="font-sans text-xs font-bold tracking-widest text-[#88726F] uppercase">
            Years of Excellence
          </p>
        </div>

        <div>
          <h3 class="font-serif text-5xl font-medium text-[#121417] mb-2">
            500<span class="text-[#B02317]">+</span>
          </h3>
          <p class="font-sans text-xs font-bold tracking-widest text-[#88726F] uppercase">
            Happy Families
          </p>
        </div>
      </div>

    </div>

    <!-- Right Column: Image -->
    <div class="w-full flex justify-center lg:justify-end relative group">
      <!-- Decorative Backdrop -->
      <div class="absolute -inset-4 rounded-[40px] bg-white border border-gray-100 shadow-xl opacity-0 transition-opacity duration-500 group-hover:opacity-100 translate-y-4 group-hover:translate-y-2 -z-10"></div>

      <div class="relative w-full max-w-lg aspect-[4/5] rounded-[32px] overflow-hidden shadow-sm transition-transform duration-500 group-hover:-translate-y-2">
        <div class="absolute inset-0 bg-[#121417]/5 group-hover:bg-transparent transition-colors duration-500 z-10"></div>
        <img 
          src="https://images.unsplash.com/photo-1531482615713-2afd69097998?auto=format&fit=crop&w=1000&q=80" 
          alt="Team collaborating over architectural blueprints" 
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
        />
      </div>
    </div>

  </div>
</section>