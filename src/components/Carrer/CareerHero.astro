---
// CareerHero.astro
---

<section class="relative h-[95vh] overflow-hidden bg-[#121417]">

  <!-- Background Image with subtle continuous zoom -->
  <img
    src="/images/Udbhav-website.jpg"
    alt="Career Hero"
    class="absolute inset-0 h-full w-full object-cover opacity-60 grayscale transition-transform duration-[20s] hover:scale-110"
  />

  <!-- Dark & Brand Overlays -->
  <div class="absolute inset-0 bg-gradient-to-b from-[#121417]/40 via-[#121417]/60 to-[#121417]"></div>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-[#B02317]/10 to-transparent mix-blend-overlay"></div>

  <!-- Content -->
  <div class="relative z-10 mx-auto flex h-full max-w-7xl flex-col items-center justify-center px-6 text-center animate-fade-in-up">

    <span class="mb-6 font-sans text-xs font-bold uppercase tracking-[0.35em] text-[#B02317]">
      Join Our Team
    </span>

    <h1 class="max-w-5xl font-serif text-5xl font-medium leading-[1.1] text-white md:text-7xl lg:text-8xl">
      Be a part of our <br />
      <span class="font-light italic text-[#B02317]">journey</span>
    </h1>

    <p class="mt-8 max-w-2xl font-sans text-lg font-light leading-relaxed text-gray-300 md:text-xl">
      At Udbhav, we believe great spaces are built by great people.
      Join a team shaping exceptional residential and commercial
      developments across Mangalore.
    </p>

    <!-- Button -->
    <a
      href="#openings"
      class="group mt-12 inline-flex items-center gap-4 rounded-full bg-[#B02317] px-10 py-5 font-sans text-sm font-semibold uppercase tracking-widest text-white shadow-xl shadow-[#B02317]/20 transition-all duration-300 hover:-translate-y-1 hover:bg-[#8e1c12] hover:shadow-[#B02317]/40">
      Explore Openings
      <span class="transition-transform duration-300 group-hover:translate-y-1">↓</span>
    </a>

  </div>

</section>

<style>
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in-up {
    animation: fadeInUp 1s ease-out forwards;
  }
</style>