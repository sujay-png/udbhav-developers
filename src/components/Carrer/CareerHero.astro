---
import { Icon } from "@/components/Icon";
---

<section class="relative h-[95vh] overflow-hidden">

  <!-- Background Image -->
  <img
    src="/images/Udbhav-website.jpg"
    alt="Career Hero"
    class="absolute inset-0 h-full w-full object-cover"
  />

  <!-- Dark Overlay -->
  <div class="absolute inset-0 bg-black/55"></div>

  <!-- Warm Gradient -->
  <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/40 to-black/70"></div>

  <!-- Content -->
  <div class="relative z-10 mx-auto flex h-full max-w-7xl flex-col items-center justify-center px-6 text-center">

    <h1
      class="max-w-5xl font-display text-5xl font-medium leading-none text-white md:text-8xl">

      Be a part of our

      <br />

      <span class="font-normal italic text-white/95">

        journey

      </span>

    </h1>

    <p
      class="mt-10 max-w-3xl text-lg leading-9 text-white/85 md:text-xl">

      At Udbhav, we believe great spaces are built by great people.
      Join a team shaping exceptional residential and commercial
      developments across Mangalore.

    </p>

    <!-- Button -->

    <a
      href="#openings"
      class="group mt-14 inline-flex items-center gap-4 rounded-full bg-white px-10 py-5 text-sm font-semibold uppercase tracking-[0.25em] text-[#111827] shadow-2xl transition duration-300 hover:-translate-y-1 hover:bg-[#D63232] hover:text-white">

      Explore Openings

      <!-- <span
        class="flex h-9 w-9 items-center justify-center rounded-full border border-gray-300 transition group-hover:border-white">

        <Icon
          name="arrow-down"
          className="h-4 w-4 transition group-hover:translate-y-1"
        />

      </span> -->

    </a>

  </div>

</section>