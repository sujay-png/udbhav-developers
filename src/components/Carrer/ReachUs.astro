---
// CandidateSignupSection.astro
---

<section class="relative bg-[#121417] text-white py-28 px-6 md:px-12 lg:px-20 flex items-center justify-center font-sans overflow-hidden">
  
  <!-- Subtle Glowing Orbs for Depth -->
  <div class="absolute top-0 left-0 h-96 w-96 rounded-full bg-[#B02317]/10 blur-[120px] pointer-events-none"></div>
  <div class="absolute bottom-0 right-0 h-96 w-96 rounded-full bg-blue-900/10 blur-[120px] pointer-events-none"></div>

  <div class="relative z-10 max-w-3xl w-full mx-auto text-center animate-fade-in-up">
    
    <span class="inline-block font-sans text-xs font-bold tracking-[0.35em] text-[#B02317] uppercase mb-6">
      Spontaneous Application
    </span>

    <h2 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-medium tracking-tight mb-8 leading-[1.1]">
      Didn't find the <br />
      <span class="italic text-[#B02317]">perfect role?</span>
    </h2>

    <p class="font-sans text-lg font-light max-w-xl mx-auto mb-12 leading-relaxed text-gray-400">
      We are always looking for exceptional talent. If you have a passion for architectural excellence and want to build a rewarding career, send us your resume.
    </p>

    <!-- Email & Submit Form -->
    <form class="flex flex-col sm:flex-row items-center justify-center gap-4 max-w-lg mx-auto mb-10">
      <input 
        type="email" 
        required 
        placeholder="Enter your email address" 
        class="w-full sm:flex-1 bg-white/5 border border-white/10 rounded-2xl px-6 py-4 text-base text-white placeholder-gray-500 focus:outline-none focus:border-[#B02317] focus:bg-white/10 transition-all backdrop-blur-sm"
      />
      <button 
        type="submit" 
        class="w-full sm:w-auto bg-[#B02317] hover:bg-[#8e1c12] text-white font-semibold text-sm uppercase tracking-widest px-8 py-4 rounded-2xl transition-all shadow-lg shadow-[#B02317]/20 hover:shadow-[#B02317]/40 cursor-pointer shrink-0 hover:-translate-y-1"
      >
        Send Resume
      </button>
    </form>

    <!-- Contact Email Link -->
    <div class="flex items-center justify-center gap-3 font-sans text-sm font-medium text-gray-400">
      <span class="h-px w-8 bg-white/10"></span>
      <a href="mailto:info@udbhavdevelopers.com" class="hover:text-white transition-colors flex items-center gap-2">
        <svg class="w-4 h-4 text-[#B02317]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
        info@udbhavdevelopers.com
      </a>
      <span class="h-px w-8 bg-white/10"></span>
    </div>

  </div>
</section>