---
// CandidateSignupSection.astro
// Ensure Tailwind CSS is configured in your Astro project.
---

<section class="bg-[#14171A] text-white py-24 px-6 md:px-12 lg:px-20 min-h-screen flex items-center justify-center font-sans">
  <div class="max-w-3xl w-full mx-auto text-center">
    
    <!-- Heading -->
    <h2 class="text-4xl sm:text-5xl lg:text-6xl font-serif font-normal tracking-tight mb-6">
      Didn't find the perfect role?
    </h2>

    <!-- Description -->
    <p class="text-gray-400 text-base sm:text-lg font-light max-w-xl mx-auto mb-10 leading-relaxed">
      We are always looking for exceptional talent. If you have a passion for architectural excellence and want to build a rewarding career, send us your resume.
    </p>

    <!-- Email & Submit Form -->
    <form class="flex flex-col sm:flex-row items-center justify-center gap-3 max-w-lg mx-auto mb-8">
      <input 
        type="email" 
        required 
        placeholder="Email Address" 
        class="w-full sm:flex-1 bg-transparent border border-gray-700/80 rounded-full px-6 py-4 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-gray-500 transition-colors"
      />
      <button 
        type="submit" 
        class="w-full sm:w-auto bg-[#E95D38] hover:bg-[#d85230] text-white font-medium text-sm px-8 py-4 rounded-full transition-colors shadow-sm cursor-pointer shrink-0"
      >
        Send Resume
      </button>
    </form>

    <!-- Contact Email Link -->
    <div class="flex items-center justify-center gap-2 text-gray-400 text-sm font-light">
      <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"></path>
      </svg>
      <a href="mailto:info@udbhavdevelopers.com" class="hover:text-white transition-colors">
        info@udbhavdevelopers.com
      </a>
    </div>

  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap');

  h2 {
    font-family: 'Playfair Display', Georgia, serif;
  }
</style>