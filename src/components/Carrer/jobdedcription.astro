---
// jobdedcription.astro
const jobs = [
  {
    id: "ud-01",
    title: "Interior Designer",
    department: "DESIGN",
    ref: "REF: UD-01",
    experience: "0-2 Years",
    openings: "01 Opening",
    responsibilities: [
      "Develop interior design concepts for residential and commercial projects.",
      "Prepare layout plans, 3D concepts, and material selections.",
      "Coordinate with architects, contractors, and project teams.",
      "Visit project sites to monitor how designs are being implemented.",
      "Keep designs aligned with project timelines and budgets."
    ],
    skills: [
      "Proficiency in AutoCAD, SketchUp, and 3D visualization tools",
      "Good understanding of materials, finishes, and space planning",
      "Strong creativity and attention to detail",
      "Good communication and coordination skills"
    ]
  },
  {
    id: "ud-02",
    title: "Architect",
    department: "ARCHITECTURE",
    ref: "REF: UD-02",
    experience: "2-5 Years",
    openings: "02 Openings",
    responsibilities: [
      "Lead architectural and interior design planning for projects.",
      "Prepare architectural drawings, design layouts, and design concepts.",
      "Coordinate with interior designers, consultants, and execution teams.",
      "Ensure project designs comply with regulations and project requirements.",
      "Review design quality and guide the team through project development."
    ],
    skills: [
      "Degree in Architecture, with relevant experience",
      "Strong knowledge of architectural planning and interior design",
      "Proficiency in AutoCAD, SketchUp, and related design software",
      "Strong leadership, project coordination, and design skills"
    ]
  },
  {
    id: "ud-03",
    title: "Marketing Executive",
    department: "MARKETING",
    ref: "REF: UD-03",
    experience: "0-2 Years",
    openings: "01 Opening",
    responsibilities: [
      "Support marketing campaigns for real estate projects.",
      "Coordinate with digital marketing and advertising teams.",
      "Assist with event promotions, site visits, and lead-generation activities.",
      "Monitor campaign performance and prepare marketing reports.",
      "Support branding initiatives and marketing communications."
    ],
    skills: [
      "Degree in Marketing, Business, or a related field",
      "Basic understanding of digital marketing and social media platforms",
      "Ability to work in a fast-paced environment"
    ]
  },
  {
    id: "ud-04",
    title: "Graphic Designer",
    department: "CREATIVE",
    ref: "REF: UD-04",
    experience: "0-2 Years",
    openings: "01 Opening",
    responsibilities: [
      "Design creatives for digital marketing campaigns and social media.",
      "Create brochures, project presentations, advertisements, and branding materials.",
      "Work closely with the marketing team on campaign visuals.",
      "Keep brand identity consistent across all marketing materials."
    ],
    skills: [
      "Proficiency in Adobe Photoshop, Illustrator, and InDesign",
      "Strong design sense and creativity"
    ]
  },
  {
    id: "ud-05",
    title: "Sales Executive",
    department: "SALES",
    ref: "REF: UD-05",
    experience: "0-2 Years",
    openings: "03 Openings",
    intro: "Looking for someone motivated by hitting targets and energized by working with people — if that's you, this role is a good fit.",
    responsibilities: [
      "Achieve sales targets on schedule.",
      "Attend to customer queries and guide them through the buying process.",
      "Accompany clients on site visits.",
      "Maintain customer feedback reports."
    ],
    skills: [
      "Minimum qualification: a graduation degree",
      "Prior experience in real estate is a plus",
      "A good team player with excellent communication skills"
    ]
  },
  {
    id: "ud-06",
    title: "Project Engineer",
    department: "ENGINEERING",
    ref: "REF: UD-06",
    experience: "0-2 Years",
    openings: "03 Openings",
    responsibilities: [
      "Supervise daily civil construction work, ensuring structures follow architectural and structural drawings.",
      "Coordinate and manage electrical and plumbing (MEP) subcontractors on-site during rough-ins and final installations.",
      "Review Good-for-Construction (GFC) drawings to catch and resolve clashes between structural beams and MEP pipe or conduit routing.",
      "Run quality checks on concrete casting, waterproofing, piping slopes, pressure testing, and electrical earthing.",
      "Verify contractor bills, measure completed on-site work, and manage material inventory for civil and MEP components."
    ],
    skills: [
      "Strong technical grasp of residential civil construction methods alongside plumbing and electrical layouts",
      "Able to read and cross-reference structural, architectural, electrical, and plumbing schematics",
      "Hands-on experience with quality control processes — pressure testing, slab conduit inspection, concrete cube testing",
      "Competent in AutoCAD for minor on-site drawing revisions and MS Excel for billing and progress tracking"
    ]
  }
];
---

<section id="openings" class="bg-white py-24 px-6 md:px-12 lg:px-20 min-h-screen relative font-sans">
  <div class="max-w-7xl mx-auto">
    
    <!-- Header Section -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div class="max-w-2xl">
        <span class="font-sans text-xs font-bold uppercase tracking-[0.35em] text-[#B02317] mb-4 block">
          Join Us
        </span>
        <h2 class="font-serif text-4xl sm:text-5xl font-medium text-[#121417] tracking-tight mb-4">
          Current Opportunities
        </h2>
        <p class="font-sans text-lg leading-relaxed text-[#88726F]">
          Discover roles that challenge your skills and offer meaningful growth in the real estate industry.
        </p>
      </div>

      <!-- Badge -->
      <div>
        <span class="inline-flex items-center gap-2 bg-[#FDF9F7] border border-[#B02317]/10 text-[#121417] text-xs font-bold uppercase tracking-widest px-5 py-3 rounded-full shadow-sm">
          <span class="h-2 w-2 rounded-full bg-[#B02317] animate-pulse"></span>
          {jobs.length} Open Roles
        </span>
      </div>
    </div>

    <!-- Job Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {jobs.map((job) => (
        <div class="group bg-[#FDF9F7] rounded-[32px] p-8 border border-transparent shadow-sm flex flex-col justify-between transition-all duration-500 hover:-translate-y-2 hover:shadow-xl hover:border-[#B02317]/20 hover:bg-white">
          
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="bg-[#B02317]/10 text-[#B02317] text-[10px] font-bold uppercase tracking-widest px-3 py-1.5 rounded-full transition-colors group-hover:bg-[#B02317] group-hover:text-white">
                {job.department}
              </span>
              <span class="text-xs font-medium tracking-wider text-[#88726F]">
                {job.ref}
              </span>
            </div>

            <h3 class="font-serif text-2xl sm:text-3xl font-medium text-[#121417] mb-6 leading-tight transition-colors group-hover:text-[#B02317]">
              {job.title}
            </h3>

            <div class="space-y-3 mb-10 text-[#88726F] text-sm font-medium">
              <div class="flex items-center gap-3">
                <svg class="w-4 h-4 text-[#B02317]/50" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                <span>{job.experience} Experience</span>
              </div>
              <div class="flex items-center gap-3">
                <svg class="w-4 h-4 text-[#B02317]/50" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                <span>{job.openings}</span>
              </div>
            </div>
          </div>

          <div class="space-y-3">
            <button class="w-full bg-[#121417] text-white text-sm font-semibold uppercase tracking-wider py-4 rounded-xl transition-all duration-300 hover:bg-[#B02317] hover:shadow-lg shadow-[#B02317]/20">
              Apply Now
            </button>
            <button 
              class="view-desc-btn w-full bg-transparent border-2 border-gray-200 text-[#121417] text-sm font-semibold uppercase tracking-wider py-3.5 rounded-xl transition-colors hover:border-[#121417]"
              data-job-id={job.id}
            >
              View Details
            </button>
          </div>

        </div>
      ))}
    </div>

  </div>

  <!-- Redesigned Modal Overlay -->
  <div id="job-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-[#121417]/80 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300">
    
    <div id="modal-box" class="bg-white w-full max-w-2xl rounded-[32px] shadow-2xl overflow-hidden transform scale-95 transition-transform duration-300 max-h-[90vh] flex flex-col border border-gray-100">
      
      <!-- Modal Header -->
      <div class="p-8 pb-6 border-b border-gray-100 bg-[#FDF9F7] flex items-start justify-between">
        <div>
          <div class="flex items-center gap-3 mb-3">
            <span id="modal-department" class="bg-[#B02317]/10 text-[#B02317] text-[10px] font-bold uppercase tracking-widest px-3 py-1 rounded-full"></span>
            <span id="modal-ref" class="text-xs font-medium tracking-wider text-[#88726F]"></span>
          </div>
          <h3 id="modal-title" class="text-3xl font-serif font-medium text-[#121417]"></h3>
          <div class="flex items-center gap-6 mt-4 text-sm font-medium text-[#88726F]">
            <span id="modal-experience" class="flex items-center gap-2"></span>
            <span id="modal-openings" class="flex items-center gap-2"></span>
          </div>
        </div>

        <button id="close-modal" class="w-10 h-10 rounded-full bg-white border border-gray-200 flex items-center justify-center text-gray-500 hover:bg-[#B02317] hover:text-white hover:border-[#B02317] transition-all cursor-pointer">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>

      <!-- Modal Body -->
      <div class="p-8 overflow-y-auto space-y-10 flex-1 hide-scrollbar">
        <p id="modal-intro" class="hidden font-sans text-base leading-relaxed text-[#88726F] italic border-l-4 border-[#B02317] pl-4"></p>

        <div>
          <h4 class="font-sans text-xs font-bold tracking-widest text-[#B02317] uppercase mb-4">
            Roles & Responsibilities
          </h4>
          <ul id="modal-responsibilities" class="space-y-3 font-sans text-base leading-relaxed text-[#88726F] list-disc pl-5 marker:text-[#B02317]">
            <!-- Injected via client script -->
          </ul>
        </div>

        <div>
          <h4 class="font-sans text-xs font-bold tracking-widest text-[#B02317] uppercase mb-4">
            Skills Required
          </h4>
          <ul id="modal-skills" class="space-y-3 font-sans text-base leading-relaxed text-[#88726F] list-disc pl-5 marker:text-[#B02317]">
            <!-- Injected via client script -->
          </ul>
        </div>
      </div>

      <!-- Modal Footer -->
      <div class="p-6 px-8 border-t border-gray-100 bg-white flex items-center justify-end gap-4">
        <button id="modal-close-footer" class="px-6 py-3 rounded-xl border-2 border-gray-200 text-sm font-semibold uppercase tracking-wider text-[#121417] hover:border-[#121417] transition-colors cursor-pointer">
          Close
        </button>
        <button class="px-8 py-3.5 rounded-xl bg-[#B02317] text-white text-sm font-semibold uppercase tracking-wider hover:bg-[#8e1c12] transition-colors shadow-lg shadow-[#B02317]/20 cursor-pointer">
          Apply For This Role
        </button>
      </div>

    </div>
  </div>
</section>

<script define:vars={{ jobs }}>
  const jobMap = {};
  jobs.forEach(job => { jobMap[job.id] = job; });

  const modal = document.getElementById('job-modal');
  const modalBox = document.getElementById('modal-box');
  const closeBtns = [document.getElementById('close-modal'), document.getElementById('modal-close-footer')];
  
  function openModal(jobId) {
    const job = jobMap[jobId];
    if (!job) return;

    document.getElementById('modal-title').textContent = job.title;
    document.getElementById('modal-department').textContent = job.department;
    document.getElementById('modal-ref').textContent = job.ref;
    document.getElementById('modal-experience').textContent = job.experience;
    document.getElementById('modal-openings').textContent = job.openings;

    const modalIntro = document.getElementById('modal-intro');
    if (job.intro) {
      modalIntro.textContent = job.intro;
      modalIntro.classList.remove('hidden');
    } else {
      modalIntro.classList.add('hidden');
    }

    const populateList = (id, items) => {
      const list = document.getElementById(id);
      list.innerHTML = '';
      items.forEach(item => {
        const li = document.createElement('li');
        li.textContent = item;
        list.appendChild(li);
      });
    };

    populateList('modal-responsibilities', job.responsibilities);
    populateList('modal-skills', job.skills);

    modal.classList.remove('opacity-0', 'pointer-events-none');
    modalBox.classList.remove('scale-95');
    modalBox.classList.add('scale-100');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.classList.add('opacity-0', 'pointer-events-none');
    modalBox.classList.remove('scale-100');
    modalBox.classList.add('scale-95');
    document.body.style.overflow = '';
  }

  document.querySelectorAll('.view-desc-btn').forEach(button => {
    button.addEventListener('click', () => openModal(button.getAttribute('data-job-id')));
  });

  closeBtns.forEach(btn => btn?.addEventListener('click', closeModal));
  modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
</script>

<style>
  .hide-scrollbar::-webkit-scrollbar { display: none; }
  .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>