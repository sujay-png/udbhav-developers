---
import { Icon } from "@/components/Icon";
import { navLinks, siteConfig } from "@/lib/site-data";
import { Button } from "@/components/ui/button";

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + "/");
---

<header class="sticky top-0 z-50 border-b border-border/70 bg-cream/90 backdrop-blur-md">
  <div class="mx-auto flex h-[4.5rem] max-w-[1400px] items-center justify-between px-5 md:px-10">

    <a href="/" class="flex items-center gap-2 font-display text-lg sm:text-xl tracking-tight text-ink">
            <img src="/images/udbhav-developers-logo-1.png" class="w-5 h-7 sm:w-6 sm:h-[35px]" alt="Udbhav Logo"/>
      <span class="truncate">Udbhav <span class="text-clay hidden sm:inline">Developers</span></span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden items-center gap-7 lg:flex">
      {
        navLinks.map((link) => {
          const hasChildren = "children" in link && link.children;

          if (hasChildren) {
            return (
              <div class="relative group py-4">
                <a
                  href={link.href}
                  class:list={[
                    "flex items-center gap-1 text-[13px] font-medium uppercase tracking-[0.08em] transition-colors hover:text-clay",
                    isActive(link.href) ? "text-clay" : "text-ink/75",
                  ]}
                >
                  {link.label}
                  <Icon name="chevron-down" className="h-3.5 w-3.5 transition-transform duration-200 group-hover:rotate-180" />
                </a>

                {/* Primary Dropdown (Ongoing / Completed) */}
                <div class="invisible absolute left-0 top-full w-56 translate-y-2 rounded-md border border-border bg-white p-1.5 shadow-xl opacity-0 transition-all duration-200 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
                  {link.children.map((group) => (
                    <div class="relative group/sub">
                      <div class="flex items-center justify-between rounded-sm px-3 py-2 text-xs font-semibold uppercase tracking-wider text-ink/80 hover:bg-muted hover:text-clay cursor-pointer">
                        <span>{group.label}</span>
                        <Icon name="chevron-right" className="h-3.5 w-3.5 opacity-60" />
                      </div>

                      {/* Secondary Nested Dropdown (Project Names) */}
                      <div class="invisible absolute left-full top-0 ml-1.5 w-64 -translate-x-2 rounded-md border border-border bg-white p-1.5 shadow-xl opacity-0 transition-all duration-200 group-hover/sub:visible group-hover/sub:translate-x-0 group-hover/sub:opacity-100">
                        <div class="px-3 py-1.5 text-[10px] font-bold uppercase tracking-widest text-muted-foreground border-b border-border/50 mb-1">
                          {group.label} Projects
                        </div>
                        {group.items.length > 0 ? (
                          group.items.map((project) => (
                            <a
                              href={`/portfolio/${project.slug}`}
                              class="block rounded-sm px-3 py-2 text-xs font-medium text-ink/75 hover:bg-muted hover:text-clay transition-colors truncate"
                            >
                              {project.name}
                            </a>
                          ))
                        ) : (
                          <span class="block px-3 py-2 text-xs text-muted-foreground italic">No projects found</span>
                        )}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            );
          }

          return (
            <a
              href={link.href}
              class:list={[
                "text-[13px] font-medium uppercase tracking-[0.08em] transition-colors hover:text-clay",
                isActive(link.href) ? "text-clay" : "text-ink/75",
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>

    <div class="hidden lg:block">
      <Button asChild size="default">
        <a href="/contact">Enquiry</a>
      </Button>
    </div>

    <!-- Mobile Menu Toggle Button -->
    <button
      id="menu-toggle"
      aria-label="Toggle menu"
      aria-expanded="false"
      class="grid h-10 w-10 place-items-center rounded-sm border border-ink/15 text-ink lg:hidden"
    >
      <Icon name="menu" className="h-5 w-5" id="icon-open" />
      <Icon name="x" className="hidden h-5 w-5" id="icon-close" />
    </button>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden border-t border-border bg-cream lg:hidden max-h-[calc(100vh-4.5rem)] overflow-y-auto">
    <nav class="flex flex-col gap-1 px-5 py-4">
      {
        navLinks.map((link) => {
          const hasChildren = "children" in link && link.children;

          if (hasChildren) {
            return (
              <div class="flex flex-col">
                <div class="flex items-center justify-between rounded-sm px-2 py-3 text-sm font-medium uppercase tracking-wide text-ink/85 bg-muted/40">
                  {link.label}
                </div>
                <div class="pl-4 flex flex-col gap-1 my-1 border-l-2 border-clay/20 ml-2">
                  {link.children.map((group) => (
                    <div class="flex flex-col py-1">
                      <span class="px-2 py-1 text-xs font-semibold uppercase text-clay">{group.label}</span>
                      {group.items.map((project) => (
                        <a
                          href={`/portfolio/${project.slug}`}
                          class="flex items-center justify-between rounded-sm px-2 py-2 text-xs font-medium text-ink/70 hover:bg-muted hover:text-clay"
                        >
                          {project.name}
                          <Icon name="arrow-up-right" className="h-3 w-3 opacity-40" />
                        </a>
                      ))}
                    </div>
                  ))}
                </div>
              </div>
            );
          }

          return (
            <a
              href={link.href}
              class="flex items-center justify-between rounded-sm px-2 py-3 text-sm font-medium uppercase tracking-wide text-ink/85 hover:bg-muted hover:text-clay"
            >
              {link.label}
              <Icon name="arrow-up-right" className="h-4 w-4 opacity-40" />
            </a>
          );
        })
      }
      <a
        href="/contact"
        class="mt-2 flex items-center justify-center rounded-sm bg-primary px-6 py-3 text-[13px] font-medium uppercase tracking-wide text-primary-foreground"
      >
        Enquiry
      </a>
      <div class="mt-3 border-t border-border pt-3 text-sm text-muted-foreground">
        <a href={`tel:${siteConfig.phone}`} class="block py-1">{siteConfig.phone}</a>
        <a href={`mailto:${siteConfig.email}`} class="block py-1">{siteConfig.email}</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.contains("hidden") === false;
    menu?.classList.toggle("hidden");
    iconOpen?.classList.toggle("hidden");
    iconClose?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(!isOpen));
  });

  // Close mobile menu on route change (view transitions / normal nav)
  document.addEventListener("astro:before-preparation", () => {
    menu?.classList.add("hidden");
    iconOpen?.classList.remove("hidden");
    iconClose?.classList.add("hidden");
  });
</script>