---
import { Icon } from "@/components/Icon";
import { siteConfig, projects } from "@/lib/site-data";

const featured = projects.slice(0, 6);
const year = new Date().getFullYear();
---

<footer class="border-t border-ink/10 bg-[#0F1D36] text-cream">
  <div
    class="mx-auto grid max-w-[1400px] grid-cols-2 gap-x-6 gap-y-10 px-5 pt-12 pb-10 sm:gap-10 sm:py-16 md:grid-cols-2 md:px-10 lg:grid-cols-4 lg:gap-12"
  >
    <!-- Brand & Bank -->
    <div class="col-span-2 md:col-span-1">
      <a href="/" class="flex items-center gap-2 font-display text-lg sm:text-xl tracking-tight text-white shrink-0">
        <img src="/images/udbhav-developers-logo-1.png" width="24" height="35" class="w-5 h-7 sm:w-6 sm:h-[35px]" alt="Udbhav Logo"/>
        <span class="whitespace-nowrap">Udbhav <span class="text-clay">Developers</span></span>
      </a>
      <p class="mt-3 max-w-sm text-[13px] sm:text-sm leading-relaxed text-cream/65">
        At Udbhav Developers, we stand for excellence, integrity, and innovation
        in the development of premium residential apartments, commercial spaces,
        and retail shops.
      </p>
      <div class="mt-5">
        <p class="text-xs font-semibold uppercase tracking-wider text-cream/90">We Bank With Karnataka Bank</p>
        <img
          src="/images/udbahv-chinmaya/karnataka%20bank.webp"
          alt="Karnataka Bank"
          width="325"
          height="100"
          class="mt-2.5 h-auto w-full max-w-[280px] sm:max-w-[325px] rounded-md shadow-sm"
          loading="lazy"
        />
      </div>
    </div>

    <!-- Featured Projects (Side by side on mobile with Quick Links) -->
    <div class="col-span-1 border-t border-cream/10 pt-8 sm:border-0 sm:pt-0 md:col-span-1">
      <p
        class="text-[11px] font-semibold uppercase tracking-[0.15em] text-clay"
      >
        Featured Projects
      </p>
      <ul class="mt-4 space-y-3 text-[13px] sm:text-sm text-cream/75">
        {
          featured.map((p) => (
            <li>
              <a
                href={`/projects/${p.slug}/`}
                class="block leading-snug transition-colors hover:text-cream"
              >
                {p.name}
              </a>
              {p.sublinks && p.sublinks.length > 0 && (
                <ul class="mt-1 space-y-1 pl-2">
                  {p.sublinks.map((sub) => (
                    <li>
                      <a
                        href={sub.href}
                        class="group inline-flex items-center gap-1.5 text-xs text-cream/55 hover:text-clay transition-colors"
                      >
                        <span
                          class="h-1.5 w-1.5 rounded-full bg-clay shrink-0 transition-transform group-hover:scale-125"
                          aria-hidden="true"
                        />
                        <span>{sub.title}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Quick Links (Side by side on mobile with Featured Projects) -->
    <div class="col-span-1 border-t border-cream/10 pt-8 sm:border-0 sm:pt-0 md:col-span-1">
      <p
        class="text-[11px] font-semibold uppercase tracking-[0.15em] text-clay"
      >
        Quick Links
      </p>
      <ul class="mt-4 space-y-3 text-[13px] sm:text-sm text-cream/75">
        <li><a href="/" class="block leading-snug transition-colors hover:text-cream">Home</a></li>
        <li><a href="/about-us/" class="block leading-snug transition-colors hover:text-cream">About Us</a></li>
        <li><a href="/buyers-guide/" class="block leading-snug transition-colors hover:text-cream">Buyers Guide</a></li>
        <li><a href="/testimonials/" class="block leading-snug transition-colors hover:text-cream">Testimonials</a></li>
        <li><a href="/news-media/" class="block leading-snug transition-colors hover:text-cream">Media & Press</a></li>
        <li><a href="/careers/" class="block leading-snug transition-colors hover:text-cream">Careers</a></li>
        <li><a href="/privacy-policy/#privacy" class="block leading-snug transition-colors hover:text-cream">Privacy Policy</a></li>
        <li><a href="/privacy-policy/#terms" class="block leading-snug transition-colors hover:text-cream">Terms & Conditions</a></li>
      </ul>
    </div>

    <!-- Contact & Social -->
    <div class="col-span-2 border-t border-cream/10 pt-8 sm:border-0 sm:pt-0 md:col-span-1">
      <p
        class="text-[11px] font-semibold uppercase tracking-[0.15em] text-clay"
      >
        Contact
      </p>
      <ul class="mt-4 space-y-3.5 text-[13px] sm:text-sm text-cream/75">
        <li class="flex items-start gap-2.5">
          <Icon
            name="map-pin"
            className="mt-0.5 h-4 w-4 shrink-0 text-clay"
          />
          <a
            href="https://www.google.com/maps/dir//UDBHAV+DEVELOPERS,+C6,+1st+Floor,+City+Gate+Commercial+Complex,+Shivbagh+Rd,+Kadri,+Mangaluru,+Karnataka+575002/@12.8548864,74.8650496,8477m/data=!3m1!1e3!4m8!4m7!1m0!1m5!1m1!1s0x3ba35a2d129d7101:0x10eaf7d428261c32!2m2!1d74.8618381!2d12.8813491?entry=ttu&g_ep=EgoyMDI2MDkwMi4wIKXMDSoASAFQAw%3D%3D"
            target="_blank"
            rel="noopener noreferrer"
            class="leading-relaxed transition-colors hover:text-cream"
          >
            {siteConfig.address}
          </a>
        </li>
        <li class="flex items-center gap-2.5">
          <Icon name="phone" className="h-4 w-4 shrink-0 text-clay" />
          <a
            href={`tel:${siteConfig.phoneAlt1}`}
            class="transition-colors hover:text-cream"
          >
            {siteConfig.phone}
          </a>
        </li>
        <li class="flex items-center gap-2.5">
          <Icon name="mail" className="h-4 w-4 shrink-0 text-clay" />
          <a
            href={`mailto:${siteConfig.email}`}
            class="transition-colors hover:text-cream"
          >
            {siteConfig.email}
          </a>
        </li>
      </ul>
      <div class="mt-5 flex gap-3">
        <a
          href="https://www.facebook.com/udbhavdevelopers/"
          aria-label="Facebook"
          class="grid h-10 w-10 place-items-center rounded-full border border-cream/20 transition-colors hover:border-clay hover:text-clay"
        >
          <Icon name="facebook" className="h-4 w-4" />
        </a>
        <a
          href="https://www.instagram.com/udbhavdevelopers/"
          aria-label="Instagram"
          class="grid h-10 w-10 place-items-center rounded-full border border-cream/20 transition-colors hover:border-clay hover:text-clay"
        >
          <Icon name="instagram" className="h-4 w-4" />
        </a>
        <a
          href="https://www.youtube.com/@udbhavdevelopersmlr?sub_confirmation=1"
          aria-label="YouTube"
          class="grid h-10 w-10 place-items-center rounded-full border border-cream/20 transition-colors hover:border-clay hover:text-clay"
        >
          <Icon name="youtube" className="h-4 w-4" />
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-cream/10">
    <div
      class="mx-auto flex max-w-[1400px] flex-col-reverse items-center justify-between gap-3 px-5 py-6 text-center text-xs text-cream/45 sm:text-left md:flex-row md:px-10"
    >
      <p>&copy; {year} Udbhav Developers | All rights reserved.</p>
      <div class="flex flex-wrap justify-center gap-5">
        <a href="/privacy-policy/#privacy" class="transition-colors hover:text-cream/80">Privacy Policy</a>
        <a href="/privacy-policy/#terms" class="transition-colors hover:text-cream/80">Terms & Conditions</a>
      </div>
    </div>
  </div>
</footer>
