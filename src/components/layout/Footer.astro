---
import { Icon } from "@/components/Icon";
import { siteConfig, projects } from "@/lib/site-data";

const featured = projects.slice(0, 6);
const year = new Date().getFullYear();
---

<footer class="border-t border-ink/10 bg-[#0F1D36] text-cream">
  <div
    class="mx-auto grid max-w-[1400px] gap-12 px-5 py-16 md:grid-cols-2 md:px-10 lg:grid-cols-4"
  >
    <div>
      <p class="font-display text-2xl">Udbhav</p>
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-cream/60">
        At Udbhav Developers, we stand for excellence, integrity, and innovation
        in the development of premium residential apartments, commercial spaces,
        and retail shops. Since our inception in 2012, we have been committed to
        creating future-ready structures that blend thoughtful design with
        long-term value.
      </p>
      <div class="mt-5">
        <p class="text-sm font-semibold text-cream">We Bank With Karnataka Bank</p>
        <img
          src="/images/udbahv-chinmaya/karnataka%20bank.webp"
          alt="Karnataka Bank"
          class="mt-3 h-auto w-full max-w-[325px]"
          loading="lazy"
        />
      </div>
    </div>

    <div>
      <p
        class="text-[11px] font-semibold uppercase tracking-[0.14em] text-clay"
      >
        Featured Projects
      </p>
      <ul class="mt-4 space-y-2.5 text-sm text-cream/70">
        {
          featured.map((p) => (
            <li>
              <a href={`/projects/${p.slug}`} class="hover:text-cream">
                {p.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p
        class="text-[11px] font-semibold uppercase tracking-[0.14em] text-clay"
      >
        Quick Links
      </p>
      <ul class="mt-4 space-y-2.5 text-sm text-cream/70">
        <li><a href="/" class="hover:text-cream">Home</a></li>
        <li><a href="/about-us" class="hover:text-cream">About Us</a></li>
        <li><a href="/buyers-guide" class="hover:text-cream">Buyers Guide</a></li>
        <li>
          <a href="/testimonials" class="hover:text-cream">Testimonials</a>
        </li>
        <li><a href="/news-media" class="hover:text-cream">Media & Press</a></li>
        <li><a href="/careers" class="hover:text-cream">Careers</a></li>
        <li><a href="/privacy-policy#privacy" class="hover:text-cream/80">Privacy Policy</a></li>
        <li>
          <a href="/privacy-policy#terms" class="hover:text-cream/80">Terms & Conditions</a>
        </li>
      </ul>
    </div>

    <div>
      <p
        class="text-[11px] font-semibold uppercase tracking-[0.14em] text-clay"
      >
        Contact
      </p>
      <ul class="mt-4 space-y-3 text-sm text-cream/70">
        <li class="flex gap-2.5">
          <Icon
            name="map-pin"
            className="mt-0.5 h-4 w-4 shrink-0 text-clay"          /><a
            href="https://www.google.com/maps/dir//UDBHAV+DEVELOPERS,+C6,+1st+Floor,+City+Gate+Commercial+Complex,+Shivbagh+Rd,+Kadri,+Mangaluru,+Karnataka+575002/@12.8548864,74.8650496,8477m/data=!3m1!1e3!4m8!4m7!1m0!1m5!1m1!1s0x3ba35a2d129d7101:0x10eaf7d428261c32!2m2!1d74.8618381!2d12.8813491?entry=ttu&g_ep=EgoyMDI2MDkwMi4wIKXMDSoASAFQAw%3D%3D"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-cream"
          >{siteConfig.address}</a>
        </li>
        <li class="flex gap-2.5">
          <Icon name="phone" className="h-4 w-4 shrink-0 text-clay" /><a
            href={`tel:${siteConfig.phoneAlt1}`}
            class="hover:text-cream">{siteConfig.phone}</a
          >
        </li>
        <li class="flex gap-2.5">
          <Icon name="mail" className="h-4 w-4 shrink-0 text-clay" /><a
            href={`mailto:${siteConfig.email}`}
            class="hover:text-cream">{siteConfig.email}</a
          >
        </li>
      </ul>
      <div class="mt-5 flex gap-3">
        <a href="https://www.facebook.com/udbhavdevelopers/" aria-label="Facebook" class="grid h-9 w-9 place-items-center rounded-full border border-cream/20 hover:border-clay hover:text-clay">
          <Icon name="facebook" className="h-4 w-4" />
        </a>
        <a href="https://www.instagram.com/udbhavdevelopers/" aria-label="Instagram" class="grid h-9 w-9 place-items-center rounded-full border border-cream/20 hover:border-clay hover:text-clay">
          <Icon name="instagram" className="h-4 w-4" />
        </a>
        <a href="https://www.youtube.com/@udbhavdevelopersmlr?sub_confirmation=1" aria-label="YouTube" class="grid h-9 w-9 place-items-center rounded-full border border-cream/20 hover:border-clay hover:text-clay">
          <Icon name="youtube" className="h-4 w-4" />
        </a>
      </div>
    </div>
  </div>

  <div class="border-t border-cream/10">
    <div
      class="mx-auto flex max-w-[1400px] flex-col-reverse items-center justify-between gap-3 px-5 py-6 text-xs text-cream/45 md:flex-row md:px-10"
    >
      <p>&copy; {year} Udbhav Developers. Future-Ready Living.</p>
      <div class="flex gap-5">
        <a href="/privacy-policy#privacy" class="hover:text-cream/80">Privacy Policy</a>
        <a href="/privacy-policy#terms" class="hover:text-cream/80">Terms & Conditions</a>
      </div>
    </div>
  </div>
</footer>
