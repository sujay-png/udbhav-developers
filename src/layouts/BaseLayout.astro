---
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import GlobalEnquiryPopup from "@/components/GlobalEnquiryPopup.astro";
import "@/styles/global.css";

interface Props {
  seoTitle?: string;
  seoDescription?: string;
  seoKeywords?: string;
  preloadImage?: string;
  // Legacy / fallback props
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
}

const {
  seoTitle = "Best Developers in Mangalore | Udbhav Developers",
  seoDescription,
  preloadImage,
  seoKeywords = "Mangaluru real estate, 3 BHK apartments, commercial spaces, Mangalore, Udbhav Developers",
  seoKeywords = "Mangaluru real estate, 3 BHK apartments, commercial spaces, Mangalore, Udbhav Developers",
  title,
  description = "Udbhav Developers — premium residential apartments and commercial spaces in Mangalore. Building with purpose, driven by trust since 2012.",
  keywords,
  image = "/og-image.jpg",
} = Astro.props;

const fallbackTitle = title || "Udbhav Developers";
const finalTitle = seoTitle || fallbackTitle;
const pageTitle = /udbhav developers/i.test(finalTitle) ? finalTitle : `${finalTitle} · Udbhav Developers`;
const finalDescription = seoDescription || description;
const finalKeywords = seoKeywords || keywords;
const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalURL = new URL(pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/images/udbhav-developers-logo-1.svg"  />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
    )}
    <link rel="preload" href="https://fonts.gstatic.com/s/inter/v20/UcC73FwrK3iLTeHuS_nVMrMxCp50SjIa1ZL7W0Q5nw.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="https://fonts.gstatic.com/s/fraunces/v38/6NU78FyLNQOQZAnv9bYEvDiIdE9Ea92uemAk_WBq8U_9v0c2Wa0KxC9TeP2Xz5c.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Inter:wght@400;500;600;700&display=swap" />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <link rel="canonical" href={canonicalURL} />
    <title>{pageTitle}</title>
    <meta name="description" content={finalDescription} />
    {finalKeywords && <meta name="keywords" content={finalKeywords} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={finalDescription} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Udbhav Developers" />
    <meta property="og:url" content={canonicalURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={finalDescription} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />

    <meta name="generator" content={Astro.generator} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "RealEstateAgent",
      "name": "Udbhav Developers",
      "url": Astro.site,
      "logo": new URL("/images/udbhav-developers-logo-1.svg", Astro.site).toString(),
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Mangalore",
        "addressRegion": "Karnataka"
      }
    })} />
  </head>
  <body class="relative overflow-x-clip">
    <Header />
    <main class="w-full overflow-x-clip">
      <slot />
    </main>
    <Footer />
    <GlobalEnquiryPopup />
  </body>
</html>
