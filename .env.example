# URL of your WordPress site's WPGraphQL endpoint.
# Requires the WPGraphQL plugin: https://www.wpgraphql.com/
# Leave unset during local development to use the built-in sample posts.
WORDPRESS_GRAPHQL_URL=https://your-wordpress-site.com/graphql

# Resend Configuration
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY="re_..."

# Email address where you want to receive the contact form submissions
CONTACT_EMAIL_TO="sales@udbhavdevelopers.com"

# Verified email address from which the email will be sent (must be verified in Resend)
CONTACT_EMAIL_FROM="onboarding@resend.dev"

# Google Sheets Configuration
# The email address of the Google Cloud Service Account
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"

# The private key of the service account (Keep the \n as literal string or use a multi-line format depending on your env loader)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# The ID of the Google Spreadsheet (from the URL: https://docs.google.com/spreadsheets/d/<THIS_ID>/edit)
GOOGLE_SHEET_ID="your-spreadsheet-id"
